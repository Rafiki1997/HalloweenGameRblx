      <Item class="Script" referent="RBX1c66227eacb19e685bb43fe6217694f621c9dbe1">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local Shared=ReplicatedStorage:WaitForChild('Ghostlight')
local C=require(Shared.Config)
local Rules=require(Shared.Rules)
local V=require(Shared.Visuals)
local Profiles=require(script.Parent.Profiles)
local World=require(script.Parent.World)
local Hunt=require(script.Parent.Hunting)
local Chamber=require(script.Parent.Chamber)
local remote=Instance.new('RemoteEvent'); remote.Name='Action'; remote.Parent=Shared
local plots={}
local lastRequest={}
local closing=false
require(Shared.GhostModels).prepare()
World.build()
local function notice(player,text) remote:FireClient(player,'Notice',text) end
local function push(player)
    local p=Profiles.get(player)
    if not p then return end
    remote:FireClient(player,'State',{Profile=p,Income=Rules.income(p),Plot=plots[player],Practice=Profiles.Memory})
end
local function refreshPlot(player)
    local p=Profiles.get(player)
    local plot=plots[player] and World.Plots[plots[player]]
    if not p or not plot then return end
    for _,m in plot.Displays do m:Destroy() end
    table.clear(plot.Displays)
    plot.Label.Text=player.DisplayName.."'s Haunt\nLevel "..p.HauntLevel
    plot.IncomeLabel.Text='$'..Rules.income(p)..' / sec'
    for i,pad in plot.Slots do
        pad.Transparency=if i&lt;=C.Slots[p.HauntLevel] then 0 else 0.8
        pad.Color=if i&lt;=C.Slots[p.HauntLevel] then Color3.fromRGB(105,66,146) else Color3.fromRGB(35,30,46)
        if p.Placed[i] then
            local m=V.ghost(p.Placed[i],plot.Model,pad.CFrame*CFrame.new(0,2.3,0),0.65,true)
            table.insert(plot.Displays,m)
        end
    end
    local existing=plot.Model:FindFirstChild('UpgradeDecor')
    if existing then existing:Destroy() end
    local decor=Instance.new('Folder'); decor.Name='UpgradeDecor'; decor.Parent=plot.Model
    for i=2,p.HauntLevel do
        for _,s in {-1,1} do
            local offset=if plot.SpireOffset then plot.SpireOffset(s,i) else CFrame.new(s*(20+i),4+i,-10+i*5)
            local pillar=V.part(decor,'EstateSpire',Vector3.new(1.2,3+i,1.2),plot.CF*offset,V.color(i),Enum.Material.Neon)
            local l=Instance.new('PointLight'); l.Color=pillar.Color; l.Range=8; l.Brightness=0.3; l.Parent=pillar
        end
    end
end
local function stats(player)
    local p=Profiles.get(player)
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    if not p or not hum then return end
    hum.WalkSpeed=if player:GetAttribute('Chamber') then 0 else 22+(p.Upgrades.Movement-1)*2
    for _,container in {char,player:FindFirstChildOfClass('Backpack')} do
        if container then
            local tool=container:FindFirstChild('Spectral Vacuum')
            if tool then
                local light=tool:FindFirstChild('Lamp',true)
                if light then light.Range=35+p.Upgrades.Flashlight*10; light.Brightness=2+p.Upgrades.Flashlight*0.5 end
            end
        end
    end
end
local function rootOf(player)
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    return if hum and hum.Health&gt;0 then char:FindFirstChild('HumanoidRootPart') else nil
end
local function near(player,part)
    local root=rootOf(player)
    return root and (root.Position-part.Position).Magnitude&lt;=15
end
local function home(player)
    local plot=plots[player] and World.Plots[plots[player]]
    if not plot or not rootOf(player) then return end
    Hunt.cancel(player,'')
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',0)
    player.Character:PivotTo(plot.CF*CFrame.new(0,4,-22))
    stats(player); push(player)
end
local function atHome(player)
    local plot=plots[player] and World.Plots[plots[player]]
    local root=rootOf(player)
    return plot and root and not player:GetAttribute('Chamber') and (root.Position-plot.CF.Position).Magnitude&lt;45
end
local function deposit(player)
    local p=Profiles.get(player)
    if not p or not atHome(player) then return end
    local n=#p.Bag; Rules.deposit(p)
    -- Fill free slots for a smooth first loop; players can replace any slot in the Haunt panel.
    local ids={}
    for id in p.Owned do table.insert(ids,id) end
    table.sort(ids,function(a,b) return C.Ghosts[a].Income&gt;C.Ghosts[b].Income end)
    for _,id in ids do while Rules.place(p,id) do end end
    refreshPlot(player); push(player)
    notice(player,if n&gt;0 then n..' ghosts deposited! Free slots filled. Your Haunt is earning dollars.' else 'Inventory ready. Manage your ghost slots in HAUNT.')
end
local function enterFloor(player,floor)
    local p=Profiles.get(player)
    if not p or type(floor)~='number' or floor~=math.floor(floor) or not World.Areas[floor] or floor&gt;p.Floor or not rootOf(player) then return end
    Hunt.cancel(player,'')
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',floor)
    player.Character:PivotTo(CFrame.new(World.Areas[floor].Entry))
    stats(player); push(player)
    notice(player,'Run into a ghost or click one to encounter it, then click repeatedly to vacuum!')
end
Hunt.start(World,Profiles,remote,push)
Chamber.start(World,Profiles,remote,push)
Profiles.start()
for i,plot in World.Plots do
    World.prompt(plot.Deposit,'Deposit ghosts','Your Haunt',function(player)
        if plot.Owner==player and near(player,plot.Deposit) then deposit(player) end
    end)
end
World.ChamberPortalPrompt.Triggered:Connect(function(player)
    if near(player,World.ChamberPortal) and (player:GetAttribute('Floor') or 0)==0 and not player:GetAttribute('Chamber') then Hunt.cancel(player,''); Chamber.enter(player,plots[player]); push(player) end
end)
for _,area in World.Areas do World.prompt(area.Exit,'Return home','Deposit captured ghosts',function(player) if near(player,area.Exit) then home(player) end end) end
World.prompt(World.MansionDoor,'Choose mansion area','Haunted Mansion',function(player) if near(player,World.MansionDoor) then remote:FireClient(player,'Open','Mansion') end end)
World.prompt(World.Upgrades,'Browse upgrades','Workshop',function(player) if near(player,World.Upgrades) then remote:FireClient(player,'Open','Upgrades') end end)
World.RebirthAltarPrompt.Triggered:Connect(function(player) if near(player,World.RebirthAltar) then remote:FireClient(player,'Open','Rebirth') end end)
remote.OnServerEvent:Connect(function(player,action,arg)
    if type(action)~='string' or #action&gt;24 then return end
    if action=='Click' then Hunt.click(player,arg); return end
    if action=='WeakSpot' then Hunt.weakSpot(player,arg); return end
    local now=os.clock()
    if now-(lastRequest[player] or 0)&lt;0.15 then return end
    lastRequest[player]=now
    local p=Profiles.get(player)
    if not p then return end
    if action=='Sync' then push(player)
    elseif action=='Home' then home(player)
    elseif action=='EnterFloor' then enterFloor(player,arg)
    elseif action=='Deposit' then deposit(player)
    elseif action=='Place' then
        if type(arg)=='string' and #arg&lt;50 and atHome(player) and Rules.place(p,arg) then refreshPlot(player); push(player) else notice(player,'Return home, deposit your ghosts, and check for a free slot.') end
    elseif action=='Remove' then
        if atHome(player) and Rules.remove(p,arg) then refreshPlot(player); push(player) end
    elseif action=='Upgrade' then
        if type(arg)=='string' and #arg&lt;30 and Rules.upgrade(p,arg) then stats(player); refreshPlot(player); push(player); notice(player,arg..' upgraded!') else notice(player,'Upgrade unavailable or not enough dollars.') end
    elseif action=='Unlock' then
        if Rules.unlock(p,arg) then push(player); notice(player,'New mansion area unlocked!') else notice(player,'Unlock areas in order and earn enough dollars.') end
    elseif action=='Rebirth' then
        if Rules.rebirth(p) then home(player); refreshPlot(player); stats(player); push(player); notice(player,'REBORN! Permanent income multiplier: '..Rules.multiplier(p)..'x') else notice(player,'Unlock all six areas and meet the dollar requirement first.') end
    elseif action=='Chamber' then
        if atHome(player) then Hunt.cancel(player,''); Chamber.enter(player,plots[player]); push(player) else notice(player,'Return to your Haunt to enter the chamber.') end
    elseif action=='ExitChamber' then home(player)
    elseif action=='Cancel' then Hunt.cancel(player,'Capture released.')
    elseif action=='Flashlight' then
        local tool=player.Character and player.Character:FindFirstChild('Spectral Vacuum')
        local light=tool and tool:FindFirstChild('Lamp',true)
        if light then light.Enabled=not light.Enabled end
    end
end)
local function characterAdded(player,char)
    char:WaitForChild('HumanoidRootPart',10)
    local humanoid=char:WaitForChild('Humanoid',10)
    if not humanoid or not Profiles.get(player) then return end
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',0)
    local backpack=player:WaitForChild('Backpack')
    if not backpack:FindFirstChild('Spectral Vacuum') and not char:FindFirstChild('Spectral Vacuum') then
        local tool=V.vacuum(); tool.Parent=backpack; humanoid:EquipTool(tool)
        tool.Unequipped:Connect(function()
            task.defer(function()
                if tool.Parent==backpack and humanoid.Health&gt;0 and player.Character==char then humanoid:EquipTool(tool) end
            end)
        end)
    end
    stats(player); push(player)
    humanoid.Died:Connect(function()
        Hunt.cancel(player,'')
        if player:GetAttribute('Chamber') then Chamber.leave(player) end
        player:SetAttribute('Floor',0)
    end)
end
local function joined(player)
    if closing then player:Kick('Server restarting. Please rejoin.'); return end
    local index
    for i,plot in World.Plots do if not plot.Owner then index=i; plot.Owner=player; plots[player]=i; break end end
    if not index then player:Kick('All seven Haunts are occupied. Please join another server.'); return end
    local data=Profiles.load(player)
    if not data or not player.Parent then
        if World.Plots[index].Owner==player then World.Plots[index].Owner=nil end
        local session=Profiles.Sessions[player]
        if session then session.Closing=true; Profiles.save(player,true); Profiles.Sessions[player]=nil end
        plots[player]=nil
        return
    end
    local leaderstats=Instance.new('Folder'); leaderstats.Name='leaderstats'; leaderstats.Parent=player
    for _,name in {'Dollars','Rebirths','Income'} do local v=Instance.new('NumberValue'); v.Name=name; v.Parent=leaderstats end
    refreshPlot(player)
    player.CharacterAdded:Connect(function(char) characterAdded(player,char) end)
    if player.Character then task.spawn(characterAdded,player,player.Character) end
    push(player)
end
Players.PlayerAdded:Connect(joined)
for _,player in Players:GetPlayers() do task.spawn(joined,player) end
Players.PlayerRemoving:Connect(function(player)
    Hunt.cancel(player,'')
    if Chamber.Sessions[player] then Chamber.leave(player) end
    local s=Profiles.Sessions[player]
    if s then s.Closing=true; Profiles.save(player,true); Profiles.Sessions[player]=nil end
    local plot=plots[player] and World.Plots[plots[player]]
    if plot then
        plot.Owner=nil; plot.Label.Text='UNCLAIMED HAUNT'
        for _,m in plot.Displays do m:Destroy() end
        table.clear(plot.Displays)
    end
    plots[player]=nil; lastRequest[player]=nil
end)
task.spawn(function()
    while task.wait(1) do
        local ranking={}
        for _,player in Players:GetPlayers() do
            local p=Profiles.get(player)
            if not p then continue end
            p.Money=math.min(1e15,p.Money+Rules.income(p))
            local ls=player:FindFirstChild('leaderstats')
            if ls then ls.Dollars.Value=math.floor(p.Money); ls.Income.Value=Rules.income(p); ls.Rebirths.Value=p.Rebirths end
            local ownedPlot=plots[player] and World.Plots[plots[player]]
            if ownedPlot then ownedPlot.IncomeLabel.Text='$'..Rules.income(p)..' / sec' end
            local root=rootOf(player)
            local floor=player:GetAttribute('Floor') or 0
            if root and not player:GetAttribute('Chamber') then
                if floor&gt;0 and World.Areas[floor] then
                    local rel=root.Position-World.Areas[floor].Center
                    if math.abs(rel.X)&gt;58 or math.abs(rel.Z)&gt;48 or rel.Y&lt; -10 then enterFloor(player,floor) end
                elseif root.Position.Y&lt; -45 or root.Position.Z&lt; -285 or root.Position.Z&gt;285 or math.abs(root.Position.X)&gt;270 then home(player) end
            end
            push(player)
            table.insert(ranking,{Name=player.DisplayName,Income=Rules.income(p)})
        end
        table.sort(ranking,function(a,b) return a.Income&gt;b.Income end)
        local lines={'HOLLOW HUNTERS • THIS SERVER'}
        for i=1,math.min(8,#ranking) do table.insert(lines,i..'. '..ranking[i].Name..' • $'..ranking[i].Income..'/sec') end
        World.Leaderboard.Label.TextLabel.Text=table.concat(lines,'\n')
    end
end)
game:BindToClose(function()
    closing=true
    local remaining=0
    for player,s in Profiles.Sessions do
        s.Closing=true; remaining+=1
        task.spawn(function() Profiles.save(player,true); remaining-=1 end)
    end
    local deadline=os.clock()+25
    while remaining&gt;0 and os.clock()&lt;deadline do task.wait(0.1) end
end)
print('Ghostlight Hollow server ready: seven Haunts, six mansion areas, fifteen ghosts.')
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9b1a6f83cd978bc7bc93f005f0d3e182cd75b96a">
        <Properties>
          <string name="Name">MapPlan</string>
          <ProtectedString name="Source">-- Shared plan for buildings, terrain pads and the pedestrian network. X/Z coordinates in studs.
local Plan={}
Plan.Plots={
    {-160,15,-105,165},{-70,10,-85,180},{80,17,-100,190},
    {160,12,-50,math.deg(math.atan2(160,-50))},
    {145,4,45,math.deg(math.atan2(145,45))},
    {-55,0,215,math.deg(math.atan2(-55,215))},
    {62,0,208,math.deg(math.atan2(62,208))},
}
Plan.Scale=1.4
Plan.Shops={{-60,153,-90},{-107,184,160},{-142,173,120},{-162,139,90},{-76,110,180},{-149,111,55}}
Plan.Routes={}
local function route(id,width,points,bridge)
    table.insert(Plan.Routes,{id=id,width=width,points=points,bridge=bridge or false})
end
local function front(index,distance)
    local p=Plan.Plots[index]; local a=math.rad(p[4])
    return {p[1]-math.sin(a)*distance*Plan.Scale,p[3]-math.cos(a)*distance*Plan.Scale}
end
Plan.front=front
local function gate(id,index,points)
    local approach=front(index,30)
    local last=points[#points]
    if (last[1]-approach[1])^2+(last[2]-approach[2])^2&gt;.01 then table.insert(points,approach) end
    table.insert(points,front(index,19.5))
    route(id,7,points)
    Plan.Routes[#Plan.Routes].plot=index
end
local diagonal=45/math.sqrt(2)
route('entrance',16,{{0,45},{0,90},{0,135},{0,170},{0,239}})
route('mansion',18,{{0,-45},{0,-90},{0,-140},{0,-157}})
route('northwest-lane',9,{{-diagonal,-diagonal},{-50,-43},{-70,-43}})
gate('blue-gate',2,{{-70,-43}})
route('north-bank-bridge',7,{{-70,-43},{-88,-43},{-111,-53}},true)
gate('violet-gate',1,{{-111,-53},{-148,-60}})
route('northeast-lane',9,{{diagonal,-diagonal},{56,-40}})
gate('green-gate',3,{{56,-40}})
gate('red-gate',4,{{56,-40},{90,-25}})
route('east-lane',9,{{45,0},{70,15}})
gate('cyan-gate',5,{{70,15}})
route('cemetery-lane',9,{{70,15},{76,80},{76,135}})
route('cemetery-entrance',7,{{0,135},{76,135},{105,135}})
gate('rose-gate',6,{{0,170},{-28,171}})
gate('amber-gate',7,{{0,170},{29,168}})
route('village-entrance',10,{{0,135},{-51,135},{-77,135},{-96,135}})
route('village-street',8,{{-96,110},{-96,133.2},{-96,135},{-96,156.2},{-96,160}})
for i,z in {110.2,133.2,156.2} do
    route('shop-door-'..i,5,{{-96,z},{-108.9,z}})
end
route('lake-east-bank',8,{{-45,0},{-49,28},{-59,60},{-77,88}})
route('village-north',8,{{-77,88},{-96,93},{-96,110}})
route('lake-south-bank',8,{{-77,88},{-122,88},{-150,82}})
route('south-dock',7,{{-150,82},{-148,65}},true)
route('lake-west-bank',6,{{-150,82},{-193,78},{-203,36},{-197,10}})
route('west-dock',6,{{-197,10},{-183,10}},true)
route('east-dock',6,{{-49,28},{-57,19},{-66,19}},true)
return Plan
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXbad3e872542a8a09ad0f8d52299e189b49281d42">
        <Properties>
          <string name="Name">Profiles</string>
          <ProtectedString name="Source">local DataStoreService=game:GetService('DataStoreService')
local HttpService=game:GetService('HttpService')
local RunService=game:GetService('RunService')
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local Rules=require(Shared.Rules)
local Config=require(Shared.Config)
local P={Sessions={}}
local memory=RunService:IsStudio() and not Config.StudioPersistence
local store=if not memory then DataStoreService:GetDataStore(Config.SaveKey) else nil
local LEASE=180
local function copy(t)
    local out={}
    for k,v in t do out[k]=if type(v)=='table' then copy(v) else v end
    return out
end
function P.load(player)
    if memory then
        P.Sessions[player]={Data=Rules.newProfile(),Memory=true,LastSave=os.time()}
        return P.Sessions[player].Data
    end
    local token=game.JobId..':'..HttpService:GenerateGUID(false)
    for attempt=1,4 do
        local ok,result=pcall(function()
            return store:UpdateAsync('Player_'..player.UserId,function(old)
                if old~=nil and type(old)~='table' then error('Invalid profile envelope') end
                old=old or {Data=Rules.newProfile()}
                if old.Lock and old.Lock.Token~=token and (old.Lock.Expires or 0)&gt;os.time() then return nil end
                return {Data=Rules.reconcile(old.Data),Lock={Token=token,Expires=os.time()+LEASE}}
            end)
        end)
        if ok and result and result.Lock and result.Lock.Token==token then
            local data=Rules.reconcile(result.Data)
            P.Sessions[player]={Data=data,Token=token,LastSave=os.time()}
            if not player.Parent then P.save(player,true); P.Sessions[player]=nil; return nil end
            return data
        end
        if not ok then warn('Profile load failed',player.UserId,result) end
        if attempt&lt;4 then task.wait(attempt*2) end
    end
    if player.Parent then player:Kick('Your save is unavailable or still open on another server. Please rejoin shortly; no progress was overwritten.') end
    return nil
end
function P.save(player,release)
    local s=P.Sessions[player]
    if not s then return true end
    while s.Saving do task.wait(0.05) end
    if s.Released then return true end
    if s.Memory then if release then s.Released=true end; return true end
    if s.Lost then return false end
    s.Saving=true
    local snapshot=copy(s.Data)
    local saved=false
    for attempt=1,3 do
        local lost=false
        local ok,result=pcall(function()
            return store:UpdateAsync('Player_'..player.UserId,function(old)
                if not old or not old.Lock or old.Lock.Token~=s.Token then lost=true; return nil end
                return {Data=snapshot,Lock=if release then nil else {Token=s.Token,Expires=os.time()+LEASE}}
            end)
        end)
        if ok and result and not lost then saved=true; s.LastSave=os.time(); break end
        if lost then s.Lost=true; break end
        warn('Profile save retry',player.UserId,attempt,result)
        if attempt&lt;3 then task.wait(attempt) end
    end
    s.Saving=false
    if saved and release then s.Released=true end
    if s.Lost or (not saved and os.time()-s.LastSave&gt;LEASE-35) then
        s.Lost=true
        if player.Parent then player:Kick('Saving connection lost. Please rejoin to protect your saved progress.') end
    end
    return saved
end
function P.get(player)
    local s=P.Sessions[player]
    return if s and not s.Lost and not s.Released and not s.Closing then s.Data else nil
end
function P.start()
    if memory then warn('Ghostlight Hollow: Studio practice session. Persistence is intentionally OFF.') end
    task.spawn(function()
        while task.wait(45) do
            for player,s in P.Sessions do if not s.Closing then task.spawn(P.save,player,false) end end
        end
    end)
end
P.Memory=memory
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX24380773b40d4e06167d23d80a8b3b2c114b3cdb">
        <Properties>
          <string name="Name">ReferenceArchitecture</string>
          <ProtectedString name="Source">-- Dimensional Gothic silhouette and small illuminated openings, composed in local space.
-- Haunt fronts face -Z. The mansion wrapper rotates that convention toward +Z.
local A={}
local slate=Color3.fromRGB(28,35,55)
local edge=Color3.fromRGB(93,87,111)
local iron=Color3.fromRGB(30,25,41)
local brick=Color3.fromRGB(62,53,72)
local amber=Color3.fromRGB(255,117,27)

local function builder(parent,cf,V)
    local b={}
    function b.part(name,size,offset,color,material)
        local p=V.part(parent,name,size,cf*offset,color or brick,material or Enum.Material.Slate)
        p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
        return p
    end
    function b.beam(name,a,c,width,color)
        local mid=(a+c)*.5
        return b.part(name,Vector3.new(width,width,(a-c).Magnitude),CFrame.lookAt(mid,c),color or edge,Enum.Material.Metal)
    end
    function b.triangle(name,a,c,d,color,material)
        local ab,ac,bc=c-a,d-a,d-c
        if ab:Dot(ab)&gt;ac:Dot(ac) and ab:Dot(ab)&gt;bc:Dot(bc) then
            d,a=a,d
        elseif ac:Dot(ac)&gt;bc:Dot(bc) then
            a,c=c,a
        end
        ab,ac,bc=c-a,d-a,d-c
        local right=ac:Cross(ab).Unit
        local up=bc:Cross(right).Unit
        local back=bc.Unit
        local height=math.abs(ab:Dot(up))
        for i,data in {{(a+c)*.5,right,back,math.abs(ab:Dot(back))},{(a+d)*.5,-right,-back,math.abs(ac:Dot(back))}} do
            if data[4]&lt;.015 then continue end
            local p=Instance.new('WedgePart')
            p.Name=name..i; p.Size=Vector3.new(.16,height,data[4])
            p.CFrame=cf*CFrame.fromMatrix(data[1],data[2],up,data[3])
            p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
            p.Material=material or Enum.Material.Slate; p.Color=color or slate; p.Parent=parent
        end
    end
    function b.finial(x,y,z,scale)
        b.part('IronFinial',Vector3.new(.14,2.8,.14)*scale,CFrame.new(x,y+1.4*scale,z),iron,Enum.Material.Metal)
        b.part('FinialCross',Vector3.new(.95,.12,.12)*scale,CFrame.new(x,y+2*scale,z),edge,Enum.Material.Metal)
        local bead=b.part('FinialBead',Vector3.new(.36,.36,.36)*scale,CFrame.new(x,y+.6*scale,z),edge,Enum.Material.Metal)
        bead.Shape=Enum.PartType.Ball
    end
    function b.window(x,y,z,w,h,hue)
        -- Recess, pointed glass head, stone arch and thin iron mullions are all geometry.
        b.part('WindowRecess',Vector3.new(w+.52,h+.4,.32),CFrame.new(x,y+h*.5,z+.07),iron)
        local pane=b.part('LuminousLancet',Vector3.new(w,h*.72,.13),CFrame.new(x,y+h*.36,z-.12),hue,Enum.Material.Neon)
        b.triangle('PointedGlass',Vector3.new(x-w*.5,y+h*.72,z-.2),Vector3.new(x+w*.5,y+h*.72,z-.2),Vector3.new(x,y+h,z-.2),hue,Enum.Material.Neon)
        -- Triangle glass retains a mild emissive material without luminous facade bands.
        for _,s in {-1,1} do
            b.beam('ArchJamb',Vector3.new(x+s*(w*.5+.15),y,z-.26),Vector3.new(x+s*(w*.5+.15),y+h*.72,z-.26),.22,edge)
            b.beam('PointedArch',Vector3.new(x+s*(w*.5+.15),y+h*.72,z-.26),Vector3.new(x,y+h+.24,z-.26),.24,edge)
        end
        b.part('WindowSill',Vector3.new(w+.8,.25,.65),CFrame.new(x,y-.1,z-.2),edge)
        b.part('WindowMullion',Vector3.new(.12,h,.19),CFrame.new(x,y+h*.5,z-.3),iron,Enum.Material.Metal)
        b.part('WindowTransom',Vector3.new(w,.12,.19),CFrame.new(x,y+h*.4,z-.3),iron,Enum.Material.Metal)
        return pane
    end
    function b.gable(x,y,z,w,h,depth,hue)
        local a=Vector3.new(x-w*.5,y,z)
        local c=Vector3.new(x+w*.5,y,z)
        local top=Vector3.new(x,y+h,z)
        b.triangle('GableFace',a,c,top,brick)
        for _,s in {-1,1} do
            local low=Vector3.new(x+s*w*.5,y,z)
            local rear=low+Vector3.new(0,0,depth)
            local peakRear=top+Vector3.new(0,0,depth)
            b.triangle('SteepSlateRoof',low,top,rear,slate)
            b.triangle('SteepSlateRoof',rear,top,peakRear,slate)
            b.beam('GableBargeboard',low,top,.32,edge)
            b.beam('RoofEave',low,rear,.32,iron)
        end
        b.beam('RidgeCap',top,top+Vector3.new(0,0,depth),.3,edge)
        if hue then b.window(x,y+.65,z-.2,w*.24,h*.48,hue) end
        b.finial(x,y+h,z,.8)
    end
    function b.tower(x,z,base,height,radius,roofHeight,hue)
        local shaft=b.part('OctagonalTurret',Vector3.new(height,radius*1.7,radius*1.7),CFrame.new(x,base+height*.5,z)*CFrame.Angles(0,0,math.pi*.5),brick)
        shaft.Shape=Enum.PartType.Cylinder
        for _,y in {base+.35,base+height*.52,base+height-.25} do
            local ring=b.part('TurretCornice',Vector3.new(.45,radius*1.95,radius*1.95),CFrame.new(x,y,z)*CFrame.Angles(0,0,math.pi*.5),edge)
            ring.Shape=Enum.PartType.Cylinder
        end
        local roofY=base+height
        for i=0,7 do
            local angle=i*math.pi*.25
            local nextAngle=(i+1)*math.pi*.25
            local a=Vector3.new(x+math.cos(angle)*radius*1.15,roofY,z+math.sin(angle)*radius*1.15)
            local c=Vector3.new(x+math.cos(nextAngle)*radius*1.15,roofY,z+math.sin(nextAngle)*radius*1.15)
            local top=Vector3.new(x,roofY+roofHeight,z)
            b.triangle('NeedleSpire',a,c,top,slate)
            if i%2==0 then b.beam('SpireSeam',a,top,.13,edge) end
        end
        b.finial(x,roofY+roofHeight,z,1)
        if hue then b.window(x,base+height*.55,z-radius*.88-.05,radius*.62,height*.25,hue) end
    end
    function b.lantern(x,y,z,hue)
        b.part('LanternBracket',Vector3.new(.16,.16,1),CFrame.new(x,y+.75,z+.3),iron,Enum.Material.Metal)
        local p=b.part('ArchitecturalLantern',Vector3.new(.5,.8,.5),CFrame.new(x,y,z),hue,Enum.Material.Neon)
        for _,dy in {-.5,.5} do b.part('LanternCap',Vector3.new(.8,.17,.8),CFrame.new(x,y+dy,z),iron,Enum.Material.Metal) end
        local l=Instance.new('PointLight'); l.Color=hue; l.Brightness=1.4; l.Range=13; l.Parent=p
    end
    return b
end

function A.decorateHaunt(model,cf,hue,V)
    -- This imported role combines the original long roof, timber trim and door.
    -- Its broad eave otherwise occludes the new elevated Gothic frontage.
    for _,p in model:GetDescendants() do
        if p:IsA('BasePart') and p.Name=='HauntShowcase_Roof' then
            p.Transparency=1; p.CastShadow=false
        end
    end
    local detail=Instance.new('Model'); detail.Name='GothicArchitecture'; detail.Parent=model
    -- Row four of the interactive ghost display occupies x=-12,0,12 at z=10.
    -- New upper-storey walls begin behind z12 and above the original wall's y12 eave.
    local b=builder(detail,cf,V)
    for _,x in {-11,-6,0,6,11} do b.window(x,8,10.3,1.5,2.5,hue) end
    local facade=brick:Lerp(hue,.18)
    -- Stable architectural differences belong to a plot, rather than changing every run.
    local seed=math.abs(math.round(cf.Position.X*137+cf.Position.Z*313))
    local rng=Random.new(seed)
    local dominantSide=if seed%2==0 then -1 else 1
    local centreEave=rng:NextNumber(21.8,25)
    local centreWidth=rng:NextNumber(7.1,8.6)
    local centreRoof=rng:NextNumber(8,10.8)
    local centreFront=rng:NextNumber(12.8,14)
    -- A low roof running sideways through the estate creates real intersecting roof
    -- volumes between the stepped front wings. It stays behind all display slots.
    local crossRoof=builder(detail,cf*CFrame.new(-15.4,0,17.2)*CFrame.Angles(0,math.pi*.5,0),V)
    crossRoof.gable(0,12.35,0,9.1,6.2,30.8,nil)
    for _,s in {-1,1} do
        local eave=rng:NextNumber(17.8,23)+(if s==dominantSide then 1 else 0)
        local front=rng:NextNumber(14.3,17.1)
        local width=rng:NextNumber(6.4,8.2)
        local x=s*rng:NextNumber(9.2,10.8)
        local depth=23.4-front
        b.part('ProjectingFrontBay',Vector3.new(width,eave-12.2,depth),CFrame.new(x,(eave+12.2)*.5,front+depth*.5),facade,Enum.Material.Brick)
        b.gable(x,eave,front-.12,width+1.1,rng:NextNumber(7.4,10.4),depth+.5,hue)
        for _,dx in {-width*.24,width*.24} do b.window(x+dx,13.3,front-.28,width*.22,math.min(6.3,eave-13.8),hue) end
        -- A narrow stone balcony projects out from each staggered bay. Short dark
        -- columns and angled brackets accent the depth without filling the yard.
        b.part('BayBalcony',Vector3.new(width+.7,.35,1.55),CFrame.new(x,12.8,front-.65),edge)
        b.part('BayBalconyRail',Vector3.new(width+.25,.12,.12),CFrame.new(x,14.35,front-1.35),iron,Enum.Material.Metal)
        for j=-3,3 do b.part('BayBaluster',Vector3.new(.1,1.4,.1),CFrame.new(x+j*width/6,13.55,front-1.35),iron,Enum.Material.Metal) end
        for _,side in {-1,1} do
            b.part('VerticalButtress',Vector3.new(.45,eave-12,1),CFrame.new(x+side*(width*.5-.12),(eave+12)*.5,front-.1),edge)
            b.beam('BalconyBracket',Vector3.new(x+side*width*.35,11.6,front),Vector3.new(x+side*width*.35,12.65,front-1.2),.2,iron)
        end
        -- Broad lower side wings and unequal tower heights replace paired needles.
        local wingX=s*17.3
        local wingTop=rng:NextNumber(14.5,17.3)
        b.part('LowerSideWing',Vector3.new(5.8,wingTop-11.8,7.3),CFrame.new(wingX,(wingTop+11.8)*.5,17),facade,Enum.Material.Brick)
        b.gable(wingX,wingTop,13.2,6.8,6.2,8.2,hue)
        b.window(wingX,12.6,13.05,2.3,3.2,hue)
        local towerHeight=if s==dominantSide then rng:NextNumber(24,27) else rng:NextNumber(17.5,21)
        b.tower(s*17.6,20.1,.6,towerHeight,3.1,if s==dominantSide then 10.5 else 7.4,hue)
        local sideWindows=builder(detail,cf*CFrame.new(s*20.28,0,18.5)*CFrame.Angles(0,-s*math.pi*.5,0),V)
        sideWindows.window(0,13,0,2.1,4,hue)
        b.lantern(s*4.7,8.5,12.8,amber)
        local dormerX=s*rng:NextNumber(4.8,6.4)
        local dormerEave=rng:NextNumber(20,23)
        b.part('DormerCheek',Vector3.new(3.4,5,4.3),CFrame.new(dormerX,dormerEave-2.5,21),facade,Enum.Material.Brick)
        b.gable(dormerX,dormerEave,18.7,4.4,5.8,4.8,hue)
        -- Two concealed spotlights wash the stone in each plot's identity colour.
        -- They sit over the yard, face toward the house, and do not add visible neon strips.
        local source=b.part('FacadeFlood',Vector3.new(.2,.2,.2),CFrame.lookAt(Vector3.new(s*11,5.8,5),Vector3.new(s*8,18,15)),hue)
        source.Transparency=1
        local light=Instance.new('SpotLight'); light.Name='ColouredFacadeWash'
        light.Face=Enum.NormalId.Front; light.Color=hue; light.Range=38; light.Angle=88
        light.Brightness=3.2; light.Shadows=false; light.Parent=source
    end
    b.part('EntryBay',Vector3.new(centreWidth,centreEave-12.2,23.8-centreFront),CFrame.new(0,(centreEave+12.2)*.5,(23.8+centreFront)*.5),facade,Enum.Material.Brick)
    b.gable(0,centreEave,centreFront-.12,centreWidth+1.6,centreRoof,24-centreFront,hue)
    for _,x in {-centreWidth*.24,centreWidth*.24} do b.window(x,14.4,centreFront-.3,centreWidth*.23,centreEave-15.2,hue) end
    -- The imported timber wall starts at z10.6 and its old porch posts at z8.7.
    -- Cover those posts with a closed entry bay between the display pedestals.
    local door=b.part('PlotFrontDoor',Vector3.new(3,6.6,.24),CFrame.new(3,3.8,8.3),Color3.fromRGB(57,34,30),Enum.Material.WoodPlanks)
    door.CanCollide=true; door.CanQuery=true
    door:SetAttribute('DecorativeDoor',true)
    for _,s in {-1,1} do
        b.part('DoorJamb',Vector3.new(.22,7,2.5),CFrame.new(3+s*1.65,3.8,9.3),edge)
    end
    b.part('DoorLintel',Vector3.new(3.5,.28,2.5),CFrame.new(3,7.25,9.3),edge)
    for _,y in {2.2,5.2} do
        b.part('RaisedDoorPanel',Vector3.new(2.35,2.15,.12),CFrame.new(3,y,8.12),Color3.fromRGB(79,46,37),Enum.Material.Wood)
    end
    local handle=b.part('DoorHandle',Vector3.new(.18,.42,.25),CFrame.new(4.05,3.8,7.95),Color3.fromRGB(185,139,68),Enum.Material.Metal)
    handle.Shape=Enum.PartType.Ball
    b.gable(0,9.8,12.3,7.4,4.3,3,nil)
    for _,s in {-1,1} do
        b.part('PorchColumn',Vector3.new(.48,9,.48),CFrame.new(s*2.9,5.3,12.5),edge)
        b.part('BalconyPost',Vector3.new(.2,2.1,.2),CFrame.new(s*3.1,14.8,13),iron,Enum.Material.Metal)
    end
    b.part('BalconyStone',Vector3.new(7,.4,2.7),CFrame.new(0,13.8,13.6),edge)
    b.part('BalconyRailing',Vector3.new(6.4,.17,.17),CFrame.new(0,15.8,12.3),iron,Enum.Material.Metal)
    for x=-3,3,.75 do b.part('BalconyIronwork',Vector3.new(.11,1.9,.11),CFrame.new(x,14.8,12.3),iron,Enum.Material.Metal) end
    -- The third roof feature alternates between a chimney cluster and a rear steeple.
    if seed%3==0 then
        b.tower(-dominantSide*4.2,22,20.5,8.5,1.65,8.6,hue)
    else
        for _,x in {dominantSide*4.8,dominantSide*6.5} do
            b.part('VictorianChimney',Vector3.new(1.2,8.2,1.6),CFrame.new(x,25,22),brick,Enum.Material.Brick)
            b.part('ChimneyCrown',Vector3.new(1.6,.45,2),CFrame.new(x,29.15,22),edge)
            b.part('ChimneyPot',Vector3.new(.65,1.4,.65),CFrame.new(x,30,22),iron,Enum.Material.Brick)
        end
    end
    -- Segment cornices follow each wing rather than drawing a flat line across the house.
    b.part('EntryCornice',Vector3.new(centreWidth+.3,.35,.7),CFrame.new(0,centreEave-.25,centreFront-.1),edge)
    return detail
end

function A.decorateMansion(root,baseCf,V)
    for _,p in root:GetDescendants() do
        if p:IsA('BasePart') and p.Name=='MansionFacade_Glow' then p.Color=amber end
        if p:IsA('BasePart') and p.Name=='MansionFacade_Roof' then p.Color=slate end
    end
    local detail=Instance.new('Model'); detail.Name='MansionGothicArchitecture'; detail.Parent=root
    local b=builder(detail,baseCf*CFrame.Angles(0,math.pi,0),V)
    -- The base mansion spans 127 studs. Its frontage is south; towers progress up to
    -- the central steeple so the high view reads as a many-spired Victorian mansion.
    for _,s in {-1,1} do
        for i=1,3 do
            local x=s*(15+i*12)
            local eave=if i==1 then 34 elseif i==2 then 28 else 23
            b.part('MansionProjectingBay',Vector3.new(10.3,eave,4.5),CFrame.new(x,eave*.5,-17),brick,Enum.Material.Brick)
            b.gable(x,eave,-19.4,12.7,14-i,23,amber)
            for _,y in {5,15,25} do
                if y+6&lt;eave+3 then b.window(x,y,-19.75,3.1,6.7,amber) end
            end
            for _,side in {-1,1} do b.part('MansionButtress',Vector3.new(.8,eave,1.5),CFrame.new(x+side*5,eave*.5,-19.5),edge) end
        end
        b.tower(s*59,-7,0,30,4.3,19,amber)
        b.tower(s*42,6,4,36,3.3,20,amber)
        b.tower(s*26,11,8,42,3.6,23,amber)
        b.tower(s*12,-14,0,44,3.2,24,amber)
        b.tower(s*6,12,25,26,2.4,20,amber)
        b.lantern(s*8,9,-23,amber)
        -- Lower forward wings give the mansion a layered estate footprint and
        -- overlap the tall rear facade with real roof planes and recessed windows.
        local wingX=s*39
        local wingEave=if s==-1 then 14.5 else 17
        b.part('MansionLowerWing',Vector3.new(19,wingEave,8),CFrame.new(wingX,wingEave*.5,-19.5),brick,Enum.Material.Brick)
        b.gable(wingX,wingEave,-23.65,21,10,9,amber)
        for _,dx in {-5,0,5} do b.window(wingX+dx,3.3,-23.88,2.3,7,amber) end
        b.part('WingBalcony',Vector3.new(20,.45,1.4),CFrame.new(wingX,2.8,-23.4),edge)
        for _,dx in {-9,9} do
            b.part('WingPier',Vector3.new(.75,wingEave,.9),CFrame.new(wingX+dx,wingEave*.5,-23.8),edge)
        end
        -- Visible dormer cheeks and short transverse ridges articulate the old
        -- broad main roof, rather than adding another row of flush window decals.
        for i=1,2 do
            local x=s*(15+i*9)
            local y=if i==1 then 48 else 45.5
            b.part('MansionDormerCheek',Vector3.new(5.2,5.5,6),CFrame.new(x,y-2.75,-5),brick,Enum.Material.Brick)
            b.gable(x,y,-8.2,6.6,8,7,amber)
        end
        for _,dx in {0,2.1} do
            b.part('MansionChimney',Vector3.new(1.6,11,2.4),CFrame.new(s*34+dx,52.5,7),brick,Enum.Material.Brick)
            b.part('MansionChimneyCap',Vector3.new(2.1,.55,2.8),CFrame.new(s*34+dx,58.1,7),edge)
            b.part('MansionChimneyPot',Vector3.new(.8,1.5,.8),CFrame.new(s*34+dx,59.1,7),iron,Enum.Material.Brick)
        end
        local bannerX=s*20
        b.part('MansionBannerPole',Vector3.new(.19,19,.19),CFrame.new(bannerX,9.5,-23),edge,Enum.Material.Metal)
        b.part('MansionBanner',Vector3.new(3.1,6.3,.16),CFrame.new(bannerX-s*1.65,14.1,-23),Color3.fromRGB(85,31,119),Enum.Material.Fabric)
        b.finial(bannerX,19,-23,.75)
    end
    b.part('CentralFrontage',Vector3.new(18,43,6),CFrame.new(0,21.5,-18),brick,Enum.Material.Brick)
    b.gable(0,43,-21,21,19,24,amber)
    b.tower(0,6,34,25,4,25,amber)
    for _,y in {16,28,42} do b.window(0,y,-21.3,5,8,amber) end
    -- The interactive door is the outermost facade, accessible from the avenue.
    local door=b.part('MansionEntrance',Vector3.new(10.8,12.8,.6),CFrame.new(0,7.1,-22),Color3.fromRGB(52,30,28),Enum.Material.WoodPlanks)
    door.CanCollide=true; door.CanQuery=true
    b.part('DoorCentreStile',Vector3.new(.18,12.8,.2),CFrame.new(0,7.1,-22.4),iron,Enum.Material.Metal)
    b.gable(0,13.5,-24,15,10,5,nil)
    for _,s in {-1,1} do
        b.part('PortalColumn',Vector3.new(1.1,13,1.1),CFrame.new(s*6.5,6.5,-23.5),edge)
        b.part('MansionDoorJamb',Vector3.new(.38,13.2,.55),CFrame.new(s*5.6,7.1,-22.15),edge)
        for _,y in {3.2,9.2} do
            b.part('MansionDoorPanel',Vector3.new(4.1,4.4,.18),CFrame.new(s*2.65,y,-22.4),Color3.fromRGB(77,42,31),Enum.Material.Wood)
        end
        b.part('MansionDoorHandle',Vector3.new(.24,1.4,.35),CFrame.new(s*.7,6.6,-22.65),Color3.fromRGB(190,144,70),Enum.Material.Metal)
    end
    for _,y in {1,13,25} do
        b.part('MansionStringCourse',Vector3.new(116,.55,1),CFrame.new(0,y,-18.9),edge)
    end
    return detail,door
end

return A
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX278adef026272d9e79a5fb424eaa03356262a7f7">
        <Properties>
          <string name="Name">ReferenceDetails</string>
          <ProtectedString name="Source">-- Reference-image environmental set dressing. Positions use the finished town layout.
local Details = {}

function Details.build(root, W, Assets, V, Landscape)
    local folder = Instance.new('Folder')
    folder.Name = 'ReferenceEnvironment'
    folder.Parent = root
    local random = Random.new(3102026)
    local slate = Color3.fromRGB(53, 54, 78)
    local edge = Color3.fromRGB(78, 76, 100)
    local wood = Color3.fromRGB(89, 56, 41)
    local iron = Color3.fromRGB(33, 29, 45)
    local gold = Color3.fromRGB(255, 170, 66)
    local blue = Color3.fromRGB(79, 168, 245)
    local function part(name, size, cf, color, material, parent)
        local p = V.part(parent or folder, name, size, cf, color or slate, material or Enum.Material.Slate)
        p.CanTouch = false
        return p
    end
    local function model(name)
        local m = Instance.new('Model')
        m.Name = name
        m.Parent = folder
        return m
    end
    local function beam(name, a, b, width, color, material, parent)
        return part(name, Vector3.new(width, width, (b-a).Magnitude), CFrame.lookAt((a+b)/2, b), color, material, parent)
    end
    local function ground(x,z)
        return Landscape.height(x,z)
    end
    local function lantern(cf, parent)
        if Assets.configured('StreetLamp') then
            local m = Assets.place('StreetLamp', parent or folder, cf)
            local glow = m:FindFirstChild('StreetLamp_Glow',true)
            if glow then
                local light = Instance.new('PointLight')
                light.Color = gold; light.Brightness = 1.9; light.Range = 21; light.Shadows = true; light.Parent = glow
            end
            return
        end
        part('LanternPost',Vector3.new(.35,6,.35),cf*CFrame.new(0,3,0),iron,Enum.Material.Metal,parent)
        part('LanternFoot',Vector3.new(1.2,.5,1.2),cf*CFrame.new(0,.25,0),slate,nil,parent)
        local glow=part('LanternGlass',Vector3.new(.8,1.3,.8),cf*CFrame.new(0,6.5,0),gold,Enum.Material.Neon,parent)
        part('LanternCap',Vector3.new(1.4,.3,1.4),cf*CFrame.new(0,7.3,0),iron,Enum.Material.Metal,parent)
        local light=Instance.new('PointLight'); light.Color=gold; light.Brightness=1.9; light.Range=21; light.Parent=glow
    end
    -- Docks have separate planks, underwater piles, rope rails and corner lanterns.
    local function dock(name, cf, length, width)
        local m = model(name)
        local count = math.floor(length/1.55)
        for i=0,count-1 do
            part('WeatheredDockPlank',Vector3.new(width,.55,1.42),cf*CFrame.new(0,0,-i*1.55),wood:Lerp(Color3.fromRGB(137,90,54),random:NextNumber(0,.32)),Enum.Material.WoodPlanks,m)
        end
        for _,x in {-width/2+.65,width/2-.65} do
            part('DockStringer',Vector3.new(.65,1,length),cf*CFrame.new(x,-.8,-length/2+1),wood,Enum.Material.Wood,m)
        end
        local stations = {0, -length*.45, -length+2}
        for _,z in stations do
            for _,side in {-1,1} do
                local x=side*(width/2+.3)
                part('DockPile',Vector3.new(.8,10,.8),cf*CFrame.new(x,-1.8,z),wood,Enum.Material.Wood,m)
                part('PileCap',Vector3.new(1.15,.28,1.15),cf*CFrame.new(x,3.3,z),wood,Enum.Material.Wood,m)
                if z~=stations[#stations] then
                    local nextZ=if z==0 then stations[2] else stations[3]
                    beam('SaggingRope',cf:PointToWorldSpace(Vector3.new(x,2.8,z)),cf:PointToWorldSpace(Vector3.new(x,2.3,(z+nextZ)/2)),.12,Color3.fromRGB(152,120,77),Enum.Material.Fabric,m)
                    beam('SaggingRope',cf:PointToWorldSpace(Vector3.new(x,2.3,(z+nextZ)/2)),cf:PointToWorldSpace(Vector3.new(x,2.8,nextZ)),.12,Color3.fromRGB(152,120,77),Enum.Material.Fabric,m)
                end
            end
        end
        lantern(cf*CFrame.new(width/2+1,0,1),m)
        lantern(cf*CFrame.new(-width/2-1,0,-length+2),m)
        if Assets.configured('OakCask') then
            local cask=Assets.place('OakCask',m,cf*CFrame.new(-width*.25,.3,-2))
            cask:ScaleTo(cask:GetScale()*.55)
        end
        return m
    end
    dock('SouthFishingDock',CFrame.new(-148,.2,65),28,8)
    dock('WestFishingDock',CFrame.new(-183,.3,10)*CFrame.Angles(0,-math.pi/2,0),28,7)
    dock('EastFishingDock',CFrame.new(-66,.2,19)*CFrame.Angles(0,math.pi/2,0),24,8)
    -- Open rowboats: pointed bow, rising gunwales, seats, interior ribs and oars.
    local function boat(cf, name)
        local m=model(name)
        local outline={Vector3.new(0,0,-6),Vector3.new(-2.5,0,-3.4),Vector3.new(-2.8,0,2.8),Vector3.new(-1.8,0,5),Vector3.new(1.8,0,5),Vector3.new(2.8,0,2.8),Vector3.new(2.5,0,-3.4)}
        part('BoatFloor',Vector3.new(3.6,.4,8),cf*CFrame.new(0,-.45,.6),wood,Enum.Material.WoodPlanks,m)
        for i,a in outline do
            local b=outline[i%#outline+1]
            local mid=(a+b)/2
            local wall=part('HullPlanking',Vector3.new(.42,1.8,(b-a).Magnitude),CFrame.lookAt(cf:PointToWorldSpace(mid),cf:PointToWorldSpace(b)),wood,Enum.Material.WoodPlanks,m)
            wall.CanCollide=false
            beam('Gunwale',cf:PointToWorldSpace(a+Vector3.new(0,.95,0)),cf:PointToWorldSpace(b+Vector3.new(0,.95,0)),.32,Color3.fromRGB(139,95,58),Enum.Material.Wood,m)
        end
        for _,z in {-2,2.5} do
            part('RowingSeat',Vector3.new(4.9,.35,1),cf*CFrame.new(0,.2,z),wood,Enum.Material.Wood,m)
        end
        beam('Oar',cf:PointToWorldSpace(Vector3.new(-4,.9,-3)),cf:PointToWorldSpace(Vector3.new(4,.9,2)),.19,Color3.fromRGB(156,115,67),Enum.Material.Wood,m)
        part('OarBlade',Vector3.new(.65,.17,2),cf*CFrame.new(-4.2,.9,-3.2)*CFrame.Angles(0,1,0),wood,Enum.Material.Wood,m)
    end
    boat(CFrame.new(-114,-2.6,48)*CFrame.Angles(0,-.7,0),'LakeRowboatAmber')
    boat(CFrame.new(-102,-2.6,5)*CFrame.Angles(0,.55,0),'LakeRowboatMoss')
    boat(CFrame.new(-158,-2.6,-5)*CFrame.Angles(0,1.9,0),'MooredRowboat')
    -- Pads are distributed across the shallows, leaving the middle readable as water.
    for i=1,45 do
        local a=random:NextNumber(0,math.pi*2)
        local r=random:NextNumber(.65,.9)
        local x,z=-122+math.cos(a)*62*r,15+math.sin(a)*59*r
        local pad=part('LilyPad',Vector3.new(.09,random:NextNumber(.6,1.5),random:NextNumber(.6,1.5)),CFrame.new(x,-2.85,z)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(49,91,54),Enum.Material.Grass)
        pad.Shape=Enum.PartType.Cylinder; pad.CanCollide=false
        if i%7==0 then
            local flower=part('WaterLily',Vector3.new(.35,.3,.35),CFrame.new(x,-2.62,z),Color3.fromRGB(160,134,204),Enum.Material.SmoothPlastic)
            flower.Shape=Enum.PartType.Ball; flower.CanCollide=false
        end
    end
    local function waterfall(name, x,z,top,bottom,width,yaw)
        local m=model(name)
        for i=1,9 do
            local dx=(i-5)*width/9
            local h=top-bottom+random:NextNumber(-1,1)
            local stream=part('FallingWater',Vector3.new(width/9+.12,h,.65),CFrame.new(x+dx,bottom+h/2,z+random:NextNumber(-.45,.45)),blue:Lerp(Color3.fromRGB(184,220,255),random:NextNumber(0,.6)),Enum.Material.Glass,m)
            stream.Transparency=random:NextNumber(.28,.48); stream.CanCollide=false; stream.CastShadow=false
            if i%2==0 then
                local foam=part('FoamRibbon',Vector3.new(.12,h,.1),stream.CFrame*CFrame.new(0,0,-.4),Color3.fromRGB(137,203,255),Enum.Material.Neon,m)
                foam.Transparency=.65; foam.CanCollide=false; foam.CastShadow=false
            end
        end
        for i=1,7 do
            local spray=part('WaterfallSpray',Vector3.new(3,1.1,2.6),CFrame.new(x+random:NextNumber(-width*.55,width*.55),bottom+.2,z+random:NextNumber(-2,2)),Color3.fromRGB(143,211,255),Enum.Material.Glass,m)
            spray.Shape=Enum.PartType.Ball; spray.Transparency=.5; spray.CanCollide=false; spray.CastShadow=false
        end
        local glow=part('FallLight',Vector3.one,CFrame.new(x,bottom+2,z-1),blue,Enum.Material.Neon,m)
        glow.Transparency=1; glow.CanCollide=false
        local light=Instance.new('PointLight'); light.Color=blue; light.Range=23; light.Brightness=1.4; light.Parent=glow
        for _,side in {-1,1} do
            part('WaterfallRockShoulder',Vector3.new(7,top-bottom+6,7),CFrame.new(x+side*(width/2+3),bottom+(top-bottom)/2-1,z+2)*CFrame.Angles(0,side*.23,side*.035),slate,Enum.Material.Slate,m)
        end
        if yaw then m:PivotTo(CFrame.new(x,0,z)*CFrame.Angles(0,yaw,0)*CFrame.new(-x,0,-z)*m:GetPivot()) end
    end
    waterfall('NorthLakeCascade',-126,-43,13,-3,12)
    waterfall('EasternIslandCascade',243,65,2,-62,13,math.pi/2)
    -- A gothic gateway frames the entrance without covering the walking route.
    local gateway=model('SouthEntranceGateway')
    local baseY=ground(0,215)
    for _,side in {-1,1} do
        local x=side*21
        for tier=0,3 do
            part('GateStonePier',Vector3.new(6.5-tier*.25,5,6.5-tier*.25),CFrame.new(x,baseY+2.5+tier*5,215),slate:Lerp(edge,tier*.13),Enum.Material.Slate,gateway)
        end
        part('PierCap',Vector3.new(8,1.3,8),CFrame.new(x,baseY+20.5,215),edge,Enum.Material.Slate,gateway)
        local spike=part('PierFinial',Vector3.new(2.6,4,2.6),CFrame.new(x,baseY+23,215),iron,Enum.Material.Metal,gateway)
        spike.Shape=Enum.PartType.Ball
        lantern(CFrame.new(x-side*2,baseY+10,211),gateway)
        for j=1,8 do
            local fx=x+side*(4+j*1.7)
            part('EntranceIronPicket',Vector3.new(.25,8+j%3,.25),CFrame.new(fx,baseY+4.5,215),iron,Enum.Material.Metal,gateway)
        end
        for _,height in {2,6} do
            part('EntranceIronRail',Vector3.new(19,.3,.35),CFrame.new(x+side*11,baseY+height,215),iron,Enum.Material.Metal,gateway)
        end
        local banner=part('PurpleEntranceBanner',Vector3.new(4.2,9,.22),CFrame.new(x+side*7,baseY+13,214.4),Color3.fromRGB(95,38,134),Enum.Material.Fabric,gateway)
        banner.CanCollide=false
        local medallion=part('BannerSpiritEmblem',Vector3.new(1.6,2.1,.25),banner.CFrame*CFrame.new(0,1,-.2),Color3.fromRGB(191,130,232),Enum.Material.Neon,gateway)
        medallion.Shape=Enum.PartType.Ball; medallion.CanCollide=false
    end
    for i=0,15 do
        local a,b=i/16*math.pi,(i+1)/16*math.pi
        local p=Vector3.new(21*math.cos(a),baseY+20+8*math.sin(a),215)
        local q=Vector3.new(21*math.cos(b),baseY+20+8*math.sin(b),215)
        beam('GothicGateArch',p,q,.65,iron,Enum.Material.Metal,gateway)
        local post=part('ArchCrownSpike',Vector3.new(.22,2.5,.22),CFrame.new(p+Vector3.new(0,1,0)),iron,Enum.Material.Metal,gateway)
        post.CanCollide=false
    end
    -- Path geometry, rather than estimated spokes, defines the planting clearances.
    local walkways={}
    for _,p in root:GetDescendants() do
        if p:IsA('BasePart') and p.Name=='ReferenceWalkway' then table.insert(walkways,p) end
    end
    local function onPath(x,z,padding)
        for _,p in walkways do
            if math.abs(x-p.Position.X)&gt;p.Size.Magnitude/2+padding or math.abs(z-p.Position.Z)&gt;p.Size.Magnitude/2+padding then continue end
            local q=p.CFrame:PointToObjectSpace(Vector3.new(x,p.Position.Y,z))
            if math.abs(q.X)&lt;p.Size.X/2+padding and math.abs(q.Z)&lt;p.Size.Z/2+padding then return true end
        end
        return false
    end
    local function clear(x,z)
        if x*x+z*z&lt;54^2 then return false end
        if math.abs(x)&lt;74 and z&gt;-225 and z&lt;-160 then return false end
        if x&gt;-176 and x&lt;-57 and z&gt;104 and z&lt;195 then return false end
        if ((x-130)/39)^2+((z-135)/50)^2&lt;1 then return false end
        if ((x+122)/69)^2+((z-15)/66)^2&lt;1 then return false end
        if math.abs(x-220)&lt;17 and math.abs(z-65)&lt;23 then return false end
        if math.abs(x)&lt;35 and z&gt;202 and z&lt;225 then return false end
        for _,plot in W.Plots do
            local q=plot.CF:PointToObjectSpace(Vector3.new(x,plot.CF.Position.Y,z))
            if math.abs(q.X)&lt;28*(plot.Scale or 1) and math.abs(q.Z)&lt;26*(plot.Scale or 1) then return false end
        end
        return not onPath(x,z,5.5)
    end
    local function shrub(cf,scale,parent,tint)
        for n=1,3 do
            local bush=part('WoodlandUndergrowth',Vector3.new(3.2,2.5,3.1)*scale,cf*CFrame.new((n-2)*1.25*scale,scale,random:NextNumber(-.7,.7)),tint or Color3.fromRGB(39,70+random:NextInteger(0,18),45),Enum.Material.Grass,parent)
            bush.Shape=Enum.PartType.Ball; bush.CanCollide=false
        end
    end
    local woods=model('LayeredPineWoodland')
    local placed={}
    local attempts=0
    while #placed&lt;390 and attempts&lt;12000 do
        attempts+=1
        local x,z=random:NextNumber(-235,235),random:NextNumber(-239,233)
        if (x/245)^2+(z/247)^2&gt;1 or not clear(x,z) then continue end
        local crowded=false
        for _,p in placed do if (x-p.X)^2+(z-p.Y)^2&lt;53 then crowded=true; break end end
        if crowded then continue end
        table.insert(placed,Vector2.new(x,z))
        local y=ground(x,z)
        local scale=random:NextNumber(.72,1.88)
        local cf=CFrame.new(x,y,z)*CFrame.Angles(0,random:NextNumber(0,math.pi*2),0)
        if Assets.configured('PineTree') then
            local tree=Assets.place('PineTree',woods,cf)
            tree:ScaleTo(tree:GetScale()*scale)
            -- Scaling around the model pivot can shift its base; restore the base to the terrain.
            local bounds,size=tree:GetBoundingBox()
            tree:PivotTo(tree:GetPivot()+Vector3.new(0,y-(bounds.Position.Y-size.Y/2),0))
            for _,p in tree:GetDescendants() do
                if p:IsA('BasePart') and p.Name:match('_Foliage$') then
                    p.Color=Color3.fromRGB(20+random:NextInteger(0,13),49+random:NextInteger(0,25),39+random:NextInteger(0,18))
                end
            end
        else
            part('PineTrunk',Vector3.new(1.1,17,1.1)*scale,cf*CFrame.new(0,8.5*scale,0),wood,Enum.Material.Wood,woods)
            for tier=0,4 do
                for wing=0,3 do
                    local foliage=Instance.new('WedgePart')
                    foliage.Name='PineTier'; foliage.Size=Vector3.new((13-tier*2)*.65,7,(13-tier*2)*.5)*scale
                    foliage.CFrame=cf*CFrame.Angles(0,wing*math.pi/2,0)*CFrame.new(0,(8+tier*3.5)*scale,-(13-tier*2)*.25*scale)
                    foliage.Color=Color3.fromRGB(22,51-tier*3,40); foliage.Material=Enum.Material.Grass
                    foliage.Anchored=true; foliage.CanCollide=false; foliage.CanTouch=false; foliage.Parent=woods
                end
            end
        end
        shrub(cf*CFrame.new(3,0,1),random:NextNumber(.55,1.1),woods)
        if #placed%3==0 then shrub(cf*CFrame.new(-3,0,-2),random:NextNumber(.4,.9),woods) end
        if #placed%8==0 and Assets.configured('Boulder') then
            local rock=Assets.place('Boulder',woods,CFrame.new(x+3,y,z+2)*CFrame.Angles(0,random:NextNumber(0,6),0))
            rock:ScaleTo(rock:GetScale()*random:NextNumber(.4,.85))
        end
    end
    -- Low masonry and planting stitch the paths into the landscape.
    local beds=model('PathsideRetainingGardens')
    for i,p in walkways do
        if i%13~=0 or p.Position.Magnitude&lt;55 then continue end
        for _,side in {-1,1} do
            local at=(p.CFrame*CFrame.new(side*(p.Size.X/2+7),0,0)).Position
            if not clear(at.X,at.Z) then continue end
            local y=ground(at.X,at.Z)
            local cf=CFrame.new(at.X,y,at.Z)*p.CFrame.Rotation
            part('RetainingWallBlock',Vector3.new(1.5,2.3,7),cf*CFrame.new(-side*2.7,1.05,0),edge,Enum.Material.Cobblestone,beds)
            part('RetainingWallCoping',Vector3.new(1.9,.45,7.4),cf*CFrame.new(-side*2.7,2.4,0),slate,nil,beds)
            shrub(cf,1.15,beds)
            if i%26==0 and Assets.configured('Pumpkin') then
                Assets.place('Pumpkin',beds,cf*CFrame.new(0,0,3),{Accent=gold})
            end
        end
    end
    -- The cemetery's oval retaining wall and tall memorials read clearly from above.
    local necropolis=model('VioletNecropolis')
    local purple=Color3.fromRGB(173,87,255)
    local grave=root:FindFirstChild('GraveyardLandmark')
    if grave then
        for _,p in grave:GetDescendants() do
            if p:IsA('BasePart') then
                if p.Name=='GraveMist' then p:Destroy(); continue end
                p.CFrame+=Vector3.new(0,1.5,0)
                if p.Name:match('_Accent$') or p.Name:match('_Glow$') then p.Color=purple end
            elseif p:IsA('PointLight') then p.Color=purple; p.Brightness=2; p.Range=24 end
        end
    end
    local precinct=part('OvalBurialPrecinct',Vector3.new(2,71,93),CFrame.new(130,.2,135)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(49,40,62),Enum.Material.Cobblestone,necropolis)
    precinct.Shape=Enum.PartType.Cylinder
    for i=0,43 do
        local a=i/44*math.pi*2
        local x,z=130+math.cos(a)*35,135+math.sin(a)*46
        if x&lt;108 and math.abs(z-135)&lt;12 then continue end
        local cf=CFrame.new(x,1.5,z)*CFrame.Angles(0,-a,0)
        part('NecropolisRetainingWall',Vector3.new(2,3.4,6.5),cf,slate,Enum.Material.Cobblestone,necropolis)
        part('NecropolisWallCoping',Vector3.new(2.6,.5,7),cf*CFrame.new(0,1.9,0),edge,nil,necropolis)
        if i%3==0 then
            part('CemeteryStonePost',Vector3.new(3,5,3),cf*CFrame.new(0,1,0),edge,nil,necropolis)
            local orb=part('PurpleCemeteryFire',Vector3.new(.8,1.5,.8),cf*CFrame.new(0,4,0),purple,Enum.Material.Neon,necropolis)
            orb.Shape=Enum.PartType.Ball; orb.CanCollide=false
            local light=Instance.new('PointLight'); light.Color=purple; light.Brightness=2.8; light.Range=23; light.Parent=orb
        end
        if i%4==0 then shrub(CFrame.new(x*1.01,ground(x,z),z+2),.9,necropolis,Color3.fromRGB(57,44,77)) end
    end
    for step=0,3 do
        part('CemeteryEntranceStep',Vector3.new(3,.5+step*.4,10),CFrame.new(96+step*3,-.25+step*.2,135),edge,Enum.Material.Cobblestone,necropolis)
    end
    for _,v in {{114,108,1.2},{145,114,.85},{136,164,1.05},{113,158,.8}} do
        local x,z,s=v[1],v[2],v[3]
        local cf=CFrame.new(x,1.3,z)
        part('MemorialFoundation',Vector3.new(7,1.2,7)*s,cf*CFrame.new(0,.6*s,0),edge,nil,necropolis)
        part('MemorialPlinth',Vector3.new(4.8,2.5,4.8)*s,cf*CFrame.new(0,2.3*s,0),slate,nil,necropolis)
        part('MemorialPillar',Vector3.new(2.5,10,2.5)*s,cf*CFrame.new(0,8*s,0),edge,nil,necropolis)
        part('MemorialCornice',Vector3.new(4,1,4)*s,cf*CFrame.new(0,13*s,0),edge,nil,necropolis)
        part('MemorialCrossStem',Vector3.new(.7,4,.7)*s,cf*CFrame.new(0,15*s,0),slate,nil,necropolis)
        part('MemorialCrossArms',Vector3.new(3,.7,.7)*s,cf*CFrame.new(0,15.6*s,0),slate,nil,necropolis)
        local jewel=part('MemorialVioletGem',Vector3.new(.8,1.3,.4)*s,cf*CFrame.new(0,9*s,-1.35*s),purple,Enum.Material.Neon,necropolis)
        jewel.Shape=Enum.PartType.Ball; jewel.CanCollide=false
    end
    for row,z in {117,135,153} do
        for col,x in {117,123,129,135,141,147} do
            local cf=CFrame.new(x,1.3,z)*CFrame.Angles(0,math.pi/2+((row+col)%3-1)*.04,0)
            part('RaisedBurialSlab',Vector3.new(3,.45,4.8),cf*CFrame.new(0,.2,2.8),Color3.fromRGB(68,59,80),Enum.Material.Slate,necropolis)
            part('GraveSlabInset',Vector3.new(2.5,.08,4.2),cf*CFrame.new(0,.48,2.8),Color3.fromRGB(46,40,55),Enum.Material.Slate,necropolis)
        end
    end
    for _,spot in {{105,111},{155,146},{120,174},{145,96}} do
        if Assets.configured('DeadTree') then
            local tree=Assets.place('DeadTree',necropolis,CFrame.new(spot[1],1,spot[2])*CFrame.Angles(0,random:NextNumber(0,6),0))
            tree:ScaleTo(tree:GetScale()*1.5)
        end
    end
    for _,spot in {{120,127},{141,147},{151,129}} do
        local spirit=V.ghost('little_boo',necropolis,CFrame.new(spot[1],5,spot[2]),.65,false)
        for _,p in spirit:GetDescendants() do
            if p:IsA('BasePart') then
                p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
                if p.Transparency&lt;1 and p.Color.R+p.Color.G+p.Color.B&gt;.7 then p.Color=purple; p.Material=Enum.Material.Neon end
            end
        end
    end
    -- A broken oval village fence gives the southwest shops a common boundary.
    local village=model('VillageEnclosureAndGardens')
    for i=0,47 do
        local a=i/48*math.pi*2
        local x,z=-113+math.cos(a)*72,148+math.sin(a)*50
        if onPath(x,z,7) or z&lt;105 then continue end
        local inPlot=false
        for _,plot in W.Plots do
            local q=plot.CF:PointToObjectSpace(Vector3.new(x,plot.CF.Y,z))
            if math.abs(q.X)&lt;26*plot.Scale and math.abs(q.Z)&lt;23*plot.Scale then inPlot=true; break end
        end
        if inPlot then continue end
        local cf=CFrame.new(x,ground(x,z),z)*CFrame.Angles(0,-a,0)
        part('VillageFenceStoneBase',Vector3.new(1.8,1.6,8),cf*CFrame.new(0,.7,0),slate,Enum.Material.Cobblestone,village)
        part('VillageFencePost',Vector3.new(1.4,5,1.4),cf*CFrame.new(0,2.5,0),wood,Enum.Material.Wood,village)
        for _,h in {2.1,3.8} do part('VillageFenceRail',Vector3.new(.35,.4,8),cf*CFrame.new(0,h,0),wood,Enum.Material.Wood,village) end
        if i%3==0 then lantern(cf,village) end
        if i%2==0 then shrub(cf*CFrame.new(-3,0,0),.85,village) end
    end
    -- Layered rock faces distinguish each raised estate from the forest floor.
    local terraces=model('EstateRockTerraces')
    local estateColors={Color3.fromRGB(198,68,255),Color3.fromRGB(47,147,255),Color3.fromRGB(47,255,133),Color3.fromRGB(255,72,33),Color3.fromRGB(47,223,255),Color3.fromRGB(240,46,235),gold}
    local function decorative(p)
        p.CanCollide=false; p.CanQuery=false; p.CanTouch=false
        return p
    end
    local function flame(cf,color,parent,name)
        decorative(part(name..'Pedestal',Vector3.new(2,3,2),cf*CFrame.new(0,1.5,0),slate,Enum.Material.Slate,parent))
        decorative(part(name..'Brazier',Vector3.new(2.8,.7,2.8),cf*CFrame.new(0,3.3,0),iron,Enum.Material.Metal,parent))
        for i=0,2 do
            local fire=decorative(part(name..'Flame',Vector3.new(1.45-i*.38,2.1-i*.35,1.45-i*.38),cf*CFrame.new(i==1 and .22 or 0,4.1+i*.75,0),color:Lerp(Color3.new(1,1,1),i*.16),Enum.Material.Neon,parent))
            fire.Shape=Enum.PartType.Ball
            if i==0 then
                local light=Instance.new('PointLight'); light.Color=color; light.Brightness=2.3; light.Range=24; light.Parent=fire
            end
        end
    end
    for index,plot in W.Plots do
        local cf,s=plot.CF,plot.Scale or 1
        local hue=estateColors[index] or purple
        for side=-1,1,2 do
            for k=0,8 do
                local lx,lz=side*(24*s+2.4),(-19+k*5)*s
                local at=(cf*CFrame.new(lx,0,lz)).Position
                if onPath(at.X,at.Z,2.5) then continue end
                local drop=math.clamp(at.Y-ground(at.X+side*4,at.Z)+7,6,18)
                local height=drop+random:NextNumber(0,2)
                local offset=cf*CFrame.new(lx,-height/2-.4,lz)*CFrame.Angles(0,random:NextNumber(-.1,.1),side*.035)
                decorative(part('EstateUpperRockFace',Vector3.new(7,height,7.4),offset,edge:Lerp(slate,random:NextNumber(.15,.65)),Enum.Material.Slate,terraces))
                decorative(part('EstateLowerRockLedge',Vector3.new(10,3.5,8.4),cf*CFrame.new(lx+side*2,-height+1,lz+1)*CFrame.Angles(0,.12,0),slate,Enum.Material.Slate,terraces))
                decorative(part('EstateStoneCoping',Vector3.new(6.7,.8,7.1),cf*CFrame.new(lx,-.3,lz),Color3.fromRGB(93,88,113),Enum.Material.Slate,terraces))
                if k%2==0 then shrub(cf*CFrame.new(lx+side*1.2,.2,lz),.75,terraces,Color3.fromRGB(32,67,43)) end
            end
            -- Front corners are planted, while the full central gateway stays open.
            for _,lx in {side*20*s,side*13*s} do
                local at=(cf*CFrame.new(lx,0,-22*s)).Position
                if not onPath(at.X,at.Z,2.8) then
                    decorative(part('EstateFrontTerrace',Vector3.new(9,7,6),cf*CFrame.new(lx,-3.8,-22*s),edge:Lerp(slate,.3),Enum.Material.Slate,terraces))
                    decorative(part('EstateFrontCoping',Vector3.new(9.2,.6,6.2),cf*CFrame.new(lx,-.2,-22*s),edge,nil,terraces))
                end
            end
            local flameCf=cf*CFrame.new(side*26*s,0,-14*s)
            if not onPath(flameCf.Position.X,flameCf.Position.Z,3) then flame(flameCf,hue,terraces,'EstateSpirit') end
            local spiritCf=cf*CFrame.new(side*26*s,6,8*s)
            if not onPath(spiritCf.Position.X,spiritCf.Position.Z,3) then
                local spirit=V.ghost('little_boo',terraces,spiritCf,.9,false)
                for _,p in spirit:GetDescendants() do
                    if p:IsA('BasePart') then
                        decorative(p)
                        if p.Transparency&lt;1 and p.Color.R+p.Color.G+p.Color.B&gt;.7 then p.Color=hue; p.Material=Enum.Material.Neon end
                    end
                end
            end
        end
        -- A narrow back ledge remains below the architectural and gameplay surfaces.
        for k=-3,3 do
            local at=(cf*CFrame.new(k*9,0,23*s)).Position
            if not onPath(at.X,at.Z,3) then
                decorative(part('EstateRearRockTerrace',Vector3.new(10,11,7),cf*CFrame.new(k*9,-6,23*s),slate:Lerp(edge,random:NextNumber(.1,.5)),Enum.Material.Slate,terraces))
            end
        end
    end
    -- Small bank rocks interrupt the smooth lake outline; shallow streaks catch moonlight.
    local shore=model('FishingLakeShoreline')
    for i=0,61 do
        local a=i/62*math.pi*2
        local x,z=-122+math.cos(a)*65,15+math.sin(a)*62
        if onPath(x,z,4) or (math.abs(x+126)&lt;12 and z&lt;-31) then continue end
        if (math.abs(z-10)&lt;10 and x&lt;-169) or (math.abs(z-19)&lt;10 and x&gt;-79) or (math.abs(x+148)&lt;10 and z&gt;52) then continue end
        local cf=CFrame.new(x,math.max(-4,ground(x,z))-.6,z)*CFrame.Angles(0,-a+random:NextNumber(-.18,.18),random:NextNumber(-.15,.15))
        decorative(part('LakeBankStone',Vector3.new(random:NextNumber(4,8),random:NextNumber(2.2,4.8),random:NextNumber(3,6)),cf,slate:Lerp(edge,random:NextNumber(.1,.6)),Enum.Material.Slate,shore))
        if i%3==0 then shrub(cf*CFrame.new(0,1,0),.8,shore,Color3.fromRGB(35,78,54)) end
        if i%7==0 then lantern(CFrame.new(x,math.max(-.5,ground(x,z)),z),shore) end
    end
    for i=1,90 do
        local x,z=random:NextNumber(-177,-66),random:NextNumber(-34,68)
        if ((x+122)/59)^2+((z-15)/55)^2&gt;1 then continue end
        local wave=decorative(part('MoonlitWaterRipple',Vector3.new(random:NextNumber(.5,2.6),.035,.13),CFrame.new(x,-2.9,z)*CFrame.Angles(0,random:NextNumber(-.2,.2),0),Color3.fromRGB(63,136,192),Enum.Material.Neon,shore))
        wave.Transparency=random:NextNumber(.62,.85); wave.CastShadow=false
    end
    for _,v in {{-166,39},{-93,-26},{-80,43}} do
        local p=decorative(part('LakeMoonlight',Vector3.one,CFrame.new(v[1],1,v[2]),blue,Enum.Material.Neon,shore))
        p.Transparency=1
        local light=Instance.new('PointLight'); light.Color=Color3.fromRGB(46,120,208); light.Brightness=1.4; light.Range=38; light.Parent=p
    end
    -- Warm light and market clutter give the village a shared busy square.
    local town=root:FindFirstChild('SpookyTown')
    if town then
        for _,p in town:GetDescendants() do
            if p:IsA('BasePart') and p.Name:match('_Glow$') then p.Color=Color3.fromRGB(255,152,48) end
            if p:IsA('PointLight') then p.Color=Color3.fromRGB(255,140,40); p.Brightness=2.8; p.Range=28 end
        end
    end
    local squareCenter=CFrame.new(-84,.7,151)
    for i=0,17 do
        local a=i/18*math.pi*2
        decorative(part('VillageWellStone',Vector3.new(1.5,2,2.2),squareCenter*CFrame.new(math.cos(a)*4.4,1,math.sin(a)*4.4)*CFrame.Angles(0,-a,0),edge,Enum.Material.Cobblestone,village))
    end
    local well=decorative(part('VillageWellWater',Vector3.new(.15,7.1,7.1),squareCenter*CFrame.new(0,.7,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(53,131,174),Enum.Material.Glass,village))
    well.Shape=Enum.PartType.Cylinder; well.Transparency=.28
    for _,side in {-1,1} do decorative(part('WellTimberPost',Vector3.new(.65,7,.65),squareCenter*CFrame.new(side*4,3.5,0),wood,Enum.Material.Wood,village)) end
    decorative(part('WellCrossBeam',Vector3.new(10,.8,.8),squareCenter*CFrame.new(0,7,0),wood,Enum.Material.Wood,village))
    decorative(part('WellRope',Vector3.new(.14,5,.14),squareCenter*CFrame.new(0,4,0),Color3.fromRGB(160,128,76),Enum.Material.Fabric,village))
    for _,v in {{-123,136},{-88,150},{-105,161},{-134,153},{-73,153},{-135,117}} do
        local cf=CFrame.new(v[1],ground(v[1],v[2]),v[2])
        if onPath(v[1],v[2],2) then continue end
        flame(cf,Color3.fromRGB(255,146,37),village,'VillageBonfire')
        if Assets.configured('OakCask') then Assets.place('OakCask',village,cf*CFrame.new(2.2,0,1)) end
        if Assets.configured('Crate') then
            Assets.place('Crate',village,cf*CFrame.new(-2.2,0,0))
            Assets.place('Crate',village,cf*CFrame.new(-2.2,1.8,0)*CFrame.Angles(0,.2,0))
        end
        if Assets.configured('Pumpkin') then Assets.place('Pumpkin',village,cf*CFrame.new(2,0,-2),{Accent=gold}) end
    end
    for _,s in {{-121,130,-83,132},{-137,157,-87,169}} do
        local a,b=Vector3.new(s[1],11,s[2]),Vector3.new(s[3],11,s[4])
        for i=0,10 do
            local t=i/10
            local at=a:Lerp(b,t)-Vector3.new(0,math.sin(t*math.pi)*2.5,0)
            local nextT=math.min(1,(i+1)/10)
            local to=a:Lerp(b,nextT)-Vector3.new(0,math.sin(nextT*math.pi)*2.5,0)
            if i&lt;10 then decorative(beam('VillageFestivalWire',at,to,.09,iron,Enum.Material.Metal,village)) end
            local bulb=decorative(part('VillageStringLantern',Vector3.new(.75,1,.75),CFrame.new(at-Vector3.new(0,.5,0)),gold,Enum.Material.Neon,village))
            if i%3==0 then local light=Instance.new('PointLight'); light.Color=gold; light.Brightness=1.6; light.Range=16; light.Parent=bulb end
        end
    end
    -- A larger chapel and violets make the cemetery more than a field of tiny stones.
    if Assets.configured('Crypt') then
        local chapel=Assets.place('Crypt',necropolis,CFrame.new(130,1.2,102),{Accent=purple})
        chapel.Name='VioletMemorialChapel'; chapel:ScaleTo(chapel:GetScale()*1.65)
        local bounds,size=chapel:GetBoundingBox()
        chapel:PivotTo(chapel:GetPivot()+Vector3.new(0,1.2-(bounds.Position.Y-size.Y/2),0))
        for _,p in chapel:GetDescendants() do
            if p:IsA('BasePart') then
                decorative(p)
                if p.Name:match('_Glow$') then
                    p.Color=purple
                    local light=Instance.new('PointLight'); light.Color=purple; light.Brightness=2.5; light.Range=30; light.Parent=p
                end
            end
        end
    end
    for _,v in {{111,120},{119,144},{143,126},{145,164}} do flame(CFrame.new(v[1],1.3,v[2]),purple,necropolis,'NecropolisVigil') end
    for i=1,35 do
        local x,z=random:NextNumber(108,155),random:NextNumber(106,169)
        if math.abs(z-135)&lt;5 then continue end
        local patch=decorative(part('GraveViolets',Vector3.new(random:NextNumber(1.5,3),.55,random:NextNumber(1.5,3)),CFrame.new(x,1.8,z),Color3.fromRGB(90,49,131),Enum.Material.Grass,necropolis))
        patch.Shape=Enum.PartType.Ball
        if i%5==0 then
            local petal=decorative(part('GraveSpiritBloom',Vector3.new(.35,.4,.35),CFrame.new(x,2.3,z),purple,Enum.Material.Neon,necropolis))
            petal.Shape=Enum.PartType.Ball
        end
    end
    folder:SetAttribute('ReferenceTreeCount',#placed)
    return folder
end

return Details
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX829be1eea70a207d4c336de92dc461cbd0675c9f">
        <Properties>
          <string name="Name">ReferenceLayout</string>
          <ProtectedString name="Source">-- Explicit landmark composition measured from assets/reference/spawn-town.png.
local Layout={}
local Plan=require(script.Parent.MapPlan)
Layout.Plots=Plan.Plots
local amber=Color3.fromRGB(255,170,67)
local slate=Color3.fromRGB(62,53,75)
local cobble=Color3.fromRGB(105,87,88)

function Layout.build(root,W,Assets,V,Landscape)
    -- Legacy straight spokes are replaced by the reference's continuous winding paths.
    for _,p in root:GetDescendants() do
        if p.Name=='Path' or p.Name=='PathEdging' then p:Destroy() end
    end
    local garden=Instance.new('Folder'); garden.Name='ReferencePathsAndGardens'; garden.Parent=root
    local terrainQuery=RaycastParams.new(); terrainQuery.FilterType=Enum.RaycastFilterType.Include
    terrainQuery.FilterDescendantsInstances={workspace.Terrain}; terrainQuery.IgnoreWater=true
    local function p(name,size,cf,color,material)
        return V.part(garden,name,size,cf,color or slate,material or Enum.Material.Slate)
    end
    local function lamp(pos)
        local model=Assets.place('StreetLamp',garden,CFrame.new(pos))
        local glow=model:FindFirstChild('StreetLamp_Glow',true)
        if glow then
            glow.Color=amber
            local light=Instance.new('PointLight'); light.Color=amber; light.Range=19; light.Brightness=1.5; light.Parent=glow
        end
        -- A faint baked pool keeps the lantern's warm grounding visible beyond dynamic-light culling distance.
        local pool=p('LanternLightPool',Vector3.new(23,.04,23),CFrame.new(pos+Vector3.new(0,1.32,0)),amber)
        pool.Transparency=1; pool.CanCollide=false; pool.CanQuery=false; pool.CastShadow=false
        local surface=Instance.new('SurfaceGui'); surface.Face=Enum.NormalId.Top; surface.CanvasSize=Vector2.new(64,64); surface.LightInfluence=0; surface.Parent=pool
        local halo=Instance.new('ImageLabel'); halo.BackgroundTransparency=1; halo.Size=UDim2.fromScale(1,1)
        halo.Image='rbxasset://textures/particles/smoke_main.dds'; halo.ImageColor3=Color3.fromRGB(255,153,54); halo.ImageTransparency=.64; halo.Parent=surface
    end
    local junctions={}
    for _,r in Plan.Routes do
        for _,at in {r.points[1],r.points[#r.points]} do table.insert(junctions,{at[1],at[2],r.width*.5+2}) end
    end
    local function atJunction(x,z,padding)
        for _,at in junctions do if (x-at[1])^2+(z-at[2])^2&lt;(at[3]+padding)^2 then return true end end
        return false
    end
    local function route(nodes,width,lit,definition)
        local distance=0
        local along=0
        local approach=definition and Landscape.Approaches[definition.id]
        for j=1,#nodes-1 do
            local a,b=nodes[j],nodes[j+1]
            local run=(b-a).Magnitude
            local count=math.max(1,math.ceil(run/(if approach then .65 else 3)))
            for k=1,count do
                local u,v=a:Lerp(b,(k-1)/count),a:Lerp(b,k/count)
                local function surfaceHeight(x,z)
                    local hit=workspace:Raycast(Vector3.new(x,100,z),Vector3.new(0,-220,0),terrainQuery)
                    return math.max(Landscape.height(x,z),hit and hit.Position.Y or -100,definition and definition.bridge and .2 or -100)+1
                end
                local au=Vector3.new(u.X,if approach then Landscape.approachHeight(definition.id,along+run*(k-1)/count) else surfaceHeight(u.X,u.Z),u.Z)
                local bv=Vector3.new(v.X,if approach then Landscape.approachHeight(definition.id,along+run*k/count) else surfaceHeight(v.X,v.Z),v.Z)
                local length=(bv-au).Magnitude
                local cf=CFrame.lookAt((au+bv)/2,bv)
                if approach then
                    -- Level stone treads, at most half a stud of rise; no steep
                    -- tilted slabs and no reliance on Humanoid jumping.
                    length=run/count
                    cf=CFrame.lookAt(Vector3.new((u.X+v.X)/2,(au.Y+bv.Y)/2,(u.Z+v.Z)/2),Vector3.new(v.X,(au.Y+bv.Y)/2,v.Z))
                end
                local clearance=0
                for _,fraction in {-.5,-.25,0,.25,.5} do
                    local sample=(cf*CFrame.new(0,0,(length+.2)*fraction)).Position
                    local hit=workspace:Raycast(Vector3.new(sample.X,100,sample.Z),Vector3.new(0,-220,0),terrainQuery)
                    if hit and not approach then clearance=math.max(clearance,hit.Position.Y+.7-sample.Y) end
                end
                cf+=Vector3.new(0,clearance,0)
                local tile=p('ReferenceWalkway',Vector3.new(width,1,length+0.2),cf,cobble,Enum.Material.Cobblestone)
                tile.Color=cobble:Lerp(Color3.fromRGB(144,112,93),lit and .1+.1*math.cos(distance*.22) or .05)
                tile:SetAttribute('ReferencePath',true)
                tile:SetAttribute('RouteId',definition and definition.id or 'plaza-ring')
                tile:SetAttribute('Bridge',definition and definition.bridge or false)
                if definition and definition.bridge then tile.Material=Enum.Material.WoodPlanks; tile.Color=Color3.fromRGB(98,65,44) end
                if definition and definition.plot then tile:SetAttribute('PlotApproach',definition.plot) end
                if approach then tile:SetAttribute('StairTread',true) end
                for _,side in {-1,1} do
                    local curbCf=cf*CFrame.new(side*(width/2+.25),.4,0)
                    if atJunction(curbCf.X,curbCf.Z,1) then continue end
                    local curb=p('StoneCurb',Vector3.new(.7,.6,length+.2),curbCf)
                    curb.CanCollide=false
                end
                distance+=length
                if lit and distance&gt;23 then
                    distance=0
                    for _,side in {-1,1} do
                        local at=(cf*CFrame.new(side*(width/2+2.4),0,0)).Position
                        if not atJunction(at.X,at.Z,3) then lamp(Vector3.new(at.X,Landscape.height(at.X,at.Z),at.Z)) end
                    end
                end
            end
            along+=run
        end
    end
    local function nodes(coords)
        local out={}
        for _,v in coords do table.insert(out,Vector3.new(v[1],0,v[2])) end
        return out
    end
    local ring={}
    for i=0,64 do local a=i*math.pi*2/64; table.insert(ring,Vector3.new(math.sin(a)*45,0,math.cos(a)*45)) end
    route(ring,12,false)
    for _,definition in Plan.Routes do route(nodes(definition.points),definition.width,true,definition) end
    -- Level porch ends at the visible door, outside the facade.
    p('MansionDoorLanding',Vector3.new(10.5,1,7),CFrame.new(0,31,-157.5),cobble,Enum.Material.Cobblestone)
    for z=-90,-154,-2 do
        local h=Landscape.height(0,z)
        p('MansionAvenueStair',Vector3.new(18,1.1,2.2),CFrame.new(0,h+.95,z),Color3.fromRGB(114,97,109),Enum.Material.Cobblestone)
        for _,side in {-1,1} do
            local wall=p('AvenueBalustrade',Vector3.new(1,3.2,2.3),CFrame.new(side*12,h+1.4,z),slate)
            if z%6==0 then p('AvenueStonePier',Vector3.new(2,4.4,2),wall.CFrame*CFrame.new(0,.6,0),Color3.fromRGB(91,78,103)) end
        end
    end
    -- Garden islands break up the circular plaza; four openings align with its approaches.
    for i=0,47 do
        local a=i*math.pi*2/48
        if i%12&lt;2 or i%12&gt;9 then continue end
        local cf=CFrame.new(math.sin(a)*32,.9,math.cos(a)*32)*CFrame.Angles(0,a,0)
        p('GardenBorder',Vector3.new(4.3,1.5,6.5),cf,slate)
        p('GardenBed',Vector3.new(4.1,1.4,5.6),cf*CFrame.new(0,.5,0),Color3.fromRGB(30,51,36),Enum.Material.Grass)
        if i%3==0 then
            local shrub=p('ClippedHedge',Vector3.new(4,3.1,4),cf*CFrame.new(0,1.6,0),Color3.fromRGB(23,64,43),Enum.Material.Grass)
            shrub.Shape=Enum.PartType.Ball
        end
    end
    for i=0,7 do
        local a=(i+.5)*math.pi/4
        lamp(Vector3.new(math.sin(a)*53,-.5,math.cos(a)*53))
        if i%2==0 then
            local cf=CFrame.new(math.sin(a)*36,0,math.cos(a)*36)*CFrame.Angles(0,a,0)
            for _,x in {-3,3} do p('BenchLeg',Vector3.new(.6,2,.6),cf*CFrame.new(x,1,0)) end
            p('BenchSeat',Vector3.new(8,.5,2),cf*CFrame.new(0,2,0),Color3.fromRGB(76,45,38),Enum.Material.WoodPlanks)
            p('BenchBack',Vector3.new(8,2,.45),cf*CFrame.new(0,3,1),Color3.fromRGB(76,45,38),Enum.Material.WoodPlanks)
        end
    end
    -- Keep interactable object references while moving the old shop row into the southwest village.
    local town=root:FindFirstChild('SpookyTown')
    for _,part in town:GetDescendants() do if part:IsA('BasePart') then part.CFrame+=Vector3.new(-65,0,58) end end
    for i,spot in Plan.Shops do
        local cf=CFrame.new(spot[1],-.5,spot[2])*CFrame.Angles(0,math.rad(spot[3]),0)
        local model=Assets.place('ShopHouse',town,cf,{Accent=amber})
        local block=V.part(town,'VillageHouseCollision',Vector3.new(20,17,15),cf*CFrame.new(0,8.5,-1),slate)
        block.Transparency=1
        local glow=model:FindFirstChild('ShopHouse_Glow',true)
        if glow then local light=Instance.new('PointLight'); light.Color=amber; light.Brightness=1.9; light.Range=24; light.Parent=glow end
        lamp(Vector3.new(spot[1]+11,-.5,spot[2]+6))
    end
    local square=p('VillageSquare',Vector3.new(30,1,42),CFrame.new(-89,0,144),cobble,Enum.Material.Cobblestone)
    square.Parent=town
    for _,pos in {{-80,126},{-139,153}} do
        Assets.place('MarketStall',town,CFrame.new(pos[1],.5,pos[2])*CFrame.Angles(0,math.rad(90),0),{Accent=amber})
    end
    -- The decorative chamber portal belongs beside the plaza, leaving the main south avenue clear.
    local portal=root:FindFirstChild('ChamberPortal')
    if portal and portal:IsA('Model') then
        for _,part in portal:GetDescendants() do if part:IsA('BasePart') then part.CFrame+=Vector3.new(58,0,15) end end
    end
    local board=root:FindFirstChild('NoticeBoard')
    if board then for _,part in board:GetDescendants() do if part:IsA('BasePart') then part.CFrame+=Vector3.new(-83,0,64) end end end
    for _,part in root:GetChildren() do
        if part.Name=='Caretaker' or part.Name=='CaretakerCollision' or part.Name=='CaretakerName' then
            local parts=if part:IsA('Model') then part:GetDescendants() else {part}
            for _,q in parts do if q:IsA('BasePart') and q.Position.X&lt;0 then q.CFrame+=Vector3.new(-65,0,58) end end
        end
    end
    -- Star-shaped fountain beams give the central spirit the same blue focal glow as the reference.
    local fountain=root:FindFirstChild('GhostFountain')
    if fountain then
        local glow=fountain:FindFirstChild('GhostFountain_Accent',true)
        if glow then glow.Transparency=1 end
        for _,step in {{32,.8,1},{29,1.3,1.7},{25,1.1,2.7}} do
            local rim=p('FountainStoneStep',Vector3.new(step[2],step[1],step[1]),CFrame.new(0,step[3],0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(70,88,122),Enum.Material.Marble)
            rim.Shape=Enum.PartType.Cylinder
        end
        local water=p('SpiritFountainWater',Vector3.new(.16,23,23),CFrame.new(0,3.35,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(29,137,217),Enum.Material.Neon)
        water.Shape=Enum.PartType.Cylinder; water.CanCollide=false; water.Transparency=.22
        for i=0,23 do
            local a=i*math.pi/12
            p('FountainCarvedRim',Vector3.new(3.4,1.7,1.4),CFrame.new(math.sin(a)*12.6,3.6,math.cos(a)*12.6)*CFrame.Angles(0,a,0),Color3.fromRGB(104,116,147),Enum.Material.Marble)
        end
        local spirit=V.ghost('little_boo',fountain,CFrame.new(0,26,0)*CFrame.Angles(0,math.pi,0),6,false)
        spirit.Name='PlazaGuardianSpirit'
        for _,mesh in spirit:GetDescendants() do
            if mesh:IsA('BasePart') and mesh.Name:match('Pearlescent') then
                mesh.Color=Color3.fromRGB(24,100,195); mesh.Material=Enum.Material.Neon
            end
        end
        local spiritLight=Instance.new('PointLight'); spiritLight.Color=Color3.fromRGB(68,178,255); spiritLight.Range=46; spiritLight.Brightness=3; spiritLight.Parent=spirit.PrimaryPart
        for i=0,5 do
            local a=i*math.pi/3
            local from=Vector3.new(math.sin(a)*7,3,math.cos(a)*7)
            local to=Vector3.new(math.sin(a)*2,23,math.cos(a)*2)
            local beam=p('SpiritJet',Vector3.new(.16,.16,(to-from).Magnitude),CFrame.lookAt((from+to)/2,to),Color3.fromRGB(74,185,255),Enum.Material.Neon)
            beam.CanCollide=false
        end
    end
    -- Sky and distant peaks sit behind the mansion, away from all play spaces.
    local oldSky=game:GetService('Lighting'):FindFirstChildOfClass('Sky')
    if oldSky then oldSky:Destroy() end
    local moon=p('BlueHarvestMoon',Vector3.one,CFrame.new(190,95,-300),Color3.fromRGB(125,188,255))
    moon.Transparency=1; moon.CanCollide=false; moon.CanQuery=false
    local disk=Instance.new('BillboardGui'); disk.Name='MoonDisc'; disk.Size=UDim2.fromScale(52,52); disk.LightInfluence=0; disk.Parent=moon
    local lunarImage=Instance.new('ImageLabel'); lunarImage.Size=UDim2.fromScale(1,1); lunarImage.BackgroundTransparency=1
    lunarImage.Image='rbxasset://sky/moon.jpg'; lunarImage.ImageColor3=Color3.fromRGB(126,188,255); lunarImage.Parent=disk
    local round=Instance.new('UICorner'); round.CornerRadius=UDim.new(.5,0); round.Parent=lunarImage
    local function triangle(a,b,c,color)
        local ab,ac,bc=b-a,c-a,c-b
        if ab:Dot(ab)&gt;ac:Dot(ac) and ab:Dot(ab)&gt;bc:Dot(bc) then c,a=a,c
        elseif ac:Dot(ac)&gt;bc:Dot(bc) then a,b=b,a end
        ab,ac,bc=b-a,c-a,c-b
        local right=ac:Cross(ab).Unit; local up=bc:Cross(right).Unit; local back=bc.Unit
        for _,v in {{(a+b)/2,right,back,math.abs(ab:Dot(back))},{(a+c)/2,-right,-back,math.abs(ac:Dot(back))}} do
            if v[4]&lt;.01 then continue end
            local face=Instance.new('WedgePart'); face.Name='MountainRockFace'; face.Anchored=true; face.CanCollide=false; face.CanQuery=false
            face.Size=Vector3.new(.2,math.abs(ab:Dot(up)),v[4]); face.CFrame=CFrame.fromMatrix(v[1],v[2],up,v[3])
            face.Material=Enum.Material.Slate; face.Color=color; face.Parent=garden
        end
    end
    for i=-6,6 do
        local x,z=i*54,-330-math.abs(i)*3
        local summit=Vector3.new(x+math.sin(i)*12,-63+math.abs(i%4)*7,z)
        local vertices={Vector3.new(x-28,-95,z-25),Vector3.new(x+28,-95,z-25),Vector3.new(x+32,-95,z+27),Vector3.new(x-27,-95,z+31)}
        for k=1,4 do triangle(vertices[k],vertices[k%4+1],summit,Color3.fromRGB(11+k*2,18+k*2,31+k*3)) end
    end
    for i=0,35 do
        local a=i*math.pi*2/36
        local reach=(math.abs(math.cos(a))^2.8+math.abs(math.sin(a))^2.8)^(1/2.8)
        local at=Vector3.new(math.cos(a)*270/reach,-12+math.sin(a*3)*12,math.sin(a)*281/reach)
        local anchor=p('CliffMistAnchor',Vector3.one,CFrame.new(at),slate)
        anchor.Transparency=1; anchor.CanCollide=false; anchor.CanQuery=false
        local cloud=Instance.new('BillboardGui'); cloud.Name='ValleyCloud'; cloud.Size=UDim2.fromScale(90,55); cloud.LightInfluence=0; cloud.Parent=anchor
        local vapor=Instance.new('ImageLabel'); vapor.Size=UDim2.fromScale(1,1); vapor.BackgroundTransparency=1
        vapor.Image='rbxasset://textures/particles/smoke_main.dds'; vapor.ImageColor3=Color3.fromRGB(28,47,84); vapor.ImageTransparency=.32; vapor.Rotation=i*41%360; vapor.Parent=cloud
        local mist=Instance.new('ParticleEmitter'); mist.Name='BlueValleyMist'; mist.Texture='rbxasset://textures/particles/smoke_main.dds'
        mist.Color=ColorSequence.new(Color3.fromRGB(33,54,88),Color3.fromRGB(20,34,60)); mist.LightInfluence=0; mist.LightEmission=.2
        mist.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,26),NumberSequenceKeypoint.new(1,64)})
        mist.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.2,.55),NumberSequenceKeypoint.new(.75,.72),NumberSequenceKeypoint.new(1,1)})
        mist.Lifetime=NumberRange.new(18,25); mist.Rate=.3; mist.Speed=NumberRange.new(.4,1.2); mist.SpreadAngle=Vector2.new(180,180)
        mist.Rotation=NumberRange.new(0,360); mist.RotSpeed=NumberRange.new(-4,4); mist.Parent=anchor; mist:Emit(5)
    end
end
return Layout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6cdca72b62494027f321040a36d4f6c7bdb79f2d">
        <Properties>
          <string name="Name">ReferenceTerrain</string>
          <ProtectedString name="Source">-- The reference is an island, with a broad western lake and a raised northern mansion.
-- Height/material are pure functions so all builders can share one surface contract.
local ReferenceTerrain = {}
local Plan=if script then require(script.Parent.MapPlan) else require('./MapPlan')
ReferenceTerrain.Ground = -0.5
ReferenceTerrain.WaterLevel = -3
ReferenceTerrain.Bounds = 300
-- Studio surface probes put WriteVoxels' rendered cells two studs beyond
-- their addressed boundaries. Account for that only in the voxel writer.
ReferenceTerrain.CellShift = 2
ReferenceTerrain.Pond = {x = -122, z = 15, radius = 62, radiusX = 65, radiusZ = 62}

local function smooth(a, b, value)
    local t = math.clamp((value - a) / (b - a), 0, 1)
    return t * t * (3 - 2 * t)
end

local function boundary(angle)
    return 1 + 0.023 * math.sin(angle * 11 + 0.6) + 0.017 * math.cos(angle * 7 - 0.8)
end

local function islandDistance(x, z)
    local angle = math.atan2(z / 260, x / 245)
    return ((math.abs(x / 245) ^ 2.8 + math.abs(z / 260) ^ 2.8) ^ (1 / 2.8)) / boundary(angle)
end

local function lakeDistance(x, z)
    local p = ReferenceTerrain.Pond
    local nx, nz = (x - p.x) / p.radiusX, (z - p.z) / p.radiusZ
    local angle = math.atan2(nz, nx)
    return math.sqrt(nx * nx + nz * nz) / (1 + 0.035 * math.sin(angle * 5) + 0.025 * math.cos(angle * 9))
end

local function rectangleDistance(x, z, cx, cz, rx, rz)
    return math.sqrt(math.max(math.abs(x - cx) - rx, 0) ^ 2 + math.max(math.abs(z - cz) - rz, 0) ^ 2)
end

local PADS = {}
for _,plot in Plan.Plots do table.insert(PADS,{plot[1],plot[3],plot[2],34,30,plot[4]}) end
ReferenceTerrain.HauntPads = PADS

local function naturalHeight(x, z)
    local d = islandDistance(x, z)
    if d &gt;= 1.055 then return -100 end
    local h = -0.5 + 30.5 * smooth(65, 163, -z)
    -- Uneven wooded shoulders surround the flat build areas.
    h += 4.5 * (math.sin(x * 0.042 + 0.9) * math.cos(z * 0.033) + 1) * smooth(75, 170, math.abs(x))
    -- Plaza, town, cemetery, mansion court, and main approach remain buildable.
    local plaza = 1 - smooth(43, 59, math.sqrt(x * x + z * z))
    h += (-0.5 - h) * plaza
    for _, lot in {{-105, 139, 65, 48}, {132, 143, 46, 49}} do
        local blend = 1 - smooth(0, 14, rectangleDistance(x, z, lot[1], lot[2], lot[3], lot[4]))
        h += (-0.5 - h) * blend
    end
    local gardenCliff=smooth(115,130,-z)*(1-smooth(145,155,-z))*smooth(24,32,math.abs(x))*(1-smooth(70,82,math.abs(x)))
    h-=12*gardenCliff
    for _, pad in PADS do
        local angle=math.rad(pad[6]); local dx,dz=x-pad[1],z-pad[2]
        local lx,lz=math.cos(angle)*dx-math.sin(angle)*dz,math.sin(angle)*dx+math.cos(angle)*dz
        local blend = 1 - smooth(0, 8, rectangleDistance(lx, lz, 0, 0, pad[4], pad[5]))
        h += (pad[3] - h) * blend
    end
    local mansion = 1 - smooth(0, 5, rectangleDistance(x, z, 0, -186, 67, 38))
    h += (30 - h) * mansion
    local avenue = (1 - smooth(15, 25, math.abs(x))) * (1 - smooth(217, 237, z))
    local avenueHeight = -0.5 + 30.5 * smooth(65, 163, -z)
    h += (avenueHeight - h) * avenue
    -- The water exists only in this basin. Outside the island is empty air.
    local lake = lakeDistance(x, z)
    h += (-12 - h) * (1 - smooth(0.81, 1.11, lake))
    -- A narrow steep skirt exposes sixty studs of rock around the entire island.
    h += (-66 - h) * smooth(0.973, 1.038, d)
    return h
end

-- Grade the whole gate approach, spreading each terrace rise over its available
-- run. The final landing meets the scaled courtyard top without a drop.
ReferenceTerrain.Approaches={}
for _,route in Plan.Routes do
    if not route.plot then continue end
    local segments,total={},0
    for i=1,#route.points-1 do
        local a,b=route.points[i],route.points[i+1]
        local length=math.sqrt((b[1]-a[1])^2+(b[2]-a[2])^2)
        table.insert(segments,{a=a,b=b,length=length,start=total})
        total+=length
    end
    local first=route.points[1]
    local startHeight=naturalHeight(first[1],first[2])
    for _,other in Plan.Routes do
        if not other.bridge then continue end
        for _,point in {other.points[1],other.points[#other.points]} do
            if (point[1]-first[1])^2+(point[2]-first[2])^2&lt;.01 then startHeight=math.max(startHeight,.2) end
        end
    end
    local flats={}
    for i=2,#segments do
        local previous,current=segments[i-1],segments[i]
        local dot=((previous.b[1]-previous.a[1])*(current.b[1]-current.a[1])+(previous.b[2]-previous.a[2])*(current.b[2]-current.a[2]))/(previous.length*current.length)
        if dot&lt;.995 then
            local radius=route.width*.5+1
            table.insert(flats,{math.max(0,current.start-radius),math.min(total,current.start+radius)})
        end
    end
    table.insert(flats,{total-1.5,total})
    local merged={}
    for _,flat in flats do
        local last=merged[#merged]
        if last and flat[1]&lt;=last[2] then last[2]=math.max(last[2],flat[2]) else table.insert(merged,flat) end
    end
    local climbRun=total
    for _,flat in merged do climbRun-=flat[2]-flat[1] end
    ReferenceTerrain.Approaches[route.id]={segments=segments,length=total,width=route.width,flats=merged,climbRun=climbRun,
        low=startHeight+1,high=Plan.Plots[route.plot][2]+Plan.Scale*.5-.5}
end
function ReferenceTerrain.approachHeight(id,distance)
    local a=ReferenceTerrain.Approaches[id]
    local climb=distance
    for _,flat in a.flats do climb-=math.clamp(distance-flat[1],0,flat[2]-flat[1]) end
    return a.low+(a.high-a.low)*math.clamp(climb/a.climbRun,0,1)
end
function ReferenceTerrain.height(x,z)
    local h=naturalHeight(x,z)
    for id,approach in ReferenceTerrain.Approaches do
        local nearest,along=math.huge,0
        for _,segment in approach.segments do
            local a,b=segment.a,segment.b
            local t=math.clamp(((x-a[1])*(b[1]-a[1])+(z-a[2])*(b[2]-a[2]))/segment.length^2,0,1)
            local distance=math.sqrt((x-a[1]-(b[1]-a[1])*t)^2+(z-a[2]-(b[2]-a[2])*t)^2)
            if distance&lt;nearest then nearest=distance; along=segment.start+segment.length*t end
        end
        local blend=1-smooth(approach.width*.5+3,approach.width*.5+7,nearest)
        if blend&gt;0 then
            -- Extra substrate clearance absorbs four-stud voxel interpolation.
            -- Fade the cut at the junction so adjacent paving still meets flush.
            local cut=math.min(1.5,math.abs(approach.high-approach.low)*.15)*smooth(0,5,along)*(1-smooth(approach.length-5,approach.length,along))
            local target=ReferenceTerrain.approachHeight(id,along)-1-cut
            h+=(target-h)*blend
        end
    end
    return h
end

function ReferenceTerrain.material(x, z)
    local h = ReferenceTerrain.height(x, z)
    if islandDistance(x, z) &gt; 0.963 then return 'Rock' end
    if lakeDistance(x, z) &lt; 1.11 and h &lt; -1 then return 'Mud' end
    local dx = (ReferenceTerrain.height(x + 2, z) - ReferenceTerrain.height(x - 2, z)) / 4
    local dz = (ReferenceTerrain.height(x, z + 2) - ReferenceTerrain.height(x, z - 2)) / 4
    if dx * dx + dz * dz &gt; 1 then return 'Rock' end
    return 'LeafyGrass'
end

local function rock(root, name, size, cf, color)
    local p = Instance.new('Part')
    p.Name = name
    p.Anchored = true
    p.Size = size
    p.CFrame = cf
    p.Material = Enum.Material.Slate
    p.Color = color
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = root
    return p
end

local function addCliffFaces(root)
    local folder = Instance.new('Folder')
    folder.Name = 'FacetedIslandCliffs'
    folder.Parent = root
    local rng = Random.new(57109)
    for i = 0, 125 do
        local angle = i * math.pi * 2 / 126
        local ca, sa = math.cos(angle), math.sin(angle)
        local reach = boundary(angle) / ((math.abs(ca) ^ 2.8 + math.abs(sa) ^ 2.8) ^ (1 / 2.8))
        local x, z = ca * 245 * reach * 0.977, sa * 260 * reach * 0.977
        local top = ReferenceTerrain.height(x * 0.97, z * 0.97) - rng:NextNumber(0, 4)
        local bottom = rng:NextNumber(-74, -60)
        local tall = top - bottom
        local shade = rng:NextInteger(-9, 10)
        rock(folder, 'BasaltCliff', Vector3.new(rng:NextNumber(11, 19), tall, rng:NextNumber(15, 26)),
            CFrame.new(x, bottom + tall / 2, z) * CFrame.Angles(0, -angle, rng:NextNumber(-0.065, 0.065)),
            Color3.fromRGB(49 + shade, 44 + shade, 69 + shade))
        if i % 3 == 0 then
            rock(folder, 'CliffCrown', Vector3.new(rng:NextNumber(10, 16), rng:NextNumber(4, 8), rng:NextNumber(10, 17)),
                CFrame.new(x * 0.989, top - 0.6, z * 0.989) * CFrame.Angles(0.12, angle + 0.4, 0.15),
                Color3.fromRGB(62 + shade, 55 + shade, 79 + shade))
        end
    end
    -- Exposed stone escarpment under the mansion's raised garden.
    for i = -6, 6 do
        local x, z = i * 12, -143 + math.abs(i) * 0.6
        if math.abs(x) &gt; 15 then
            local top = ReferenceTerrain.height(x, z - 5)
            rock(folder, 'MansionTerraceFace', Vector3.new(11.8, 21, 10),
                CFrame.new(x, top - 11, z) * CFrame.Angles(0, rng:NextNumber(-0.15, 0.15), 0),
                Color3.fromRGB(64, 56, 82))
        end
    end
end

function ReferenceTerrain.build(root)
    local started = os.clock()
    local terrain = workspace.Terrain
    terrain:Clear()
    terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(35, 52, 43))
    terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(30, 47, 40))
    terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(58, 49, 76))
    terrain:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(35, 35, 48))
    terrain.WaterColor = Color3.fromRGB(8, 36, 57)
    terrain.WaterTransparency = 0.48
    terrain.WaterReflectance = 0.12
    terrain.WaterWaveSize = 0.1
    terrain.WaterWaveSpeed = 5
    local step, chunk, floor = 4, 60, -80
    local n, columns, chunks = chunk / step, 0, 0
    for cx = -300, 240, chunk do
        for cz = -300, 240, chunk do
            local heights, surface, wet, highest = {}, {}, {}, 0
            for i = 1, n do
                heights[i], surface[i], wet[i] = {}, {}, {}
                for k = 1, n do
                    local x, z = cx + (i - 0.5) * step + ReferenceTerrain.CellShift, cz + (k - 0.5) * step + ReferenceTerrain.CellShift
                    local h = ReferenceTerrain.height(x, z)
                    heights[i][k] = h
                    surface[i][k] = Enum.Material[ReferenceTerrain.material(x, z)]
                    wet[i][k] = lakeDistance(x, z) &lt; 1.12
                    highest = math.max(highest, h)
                end
            end
            local ny = math.ceil((highest - floor - ReferenceTerrain.CellShift) / step) + 1
            local materials, occupancy = {}, {}
            for i = 1, n do
                materials[i], occupancy[i] = {}, {}
                for j = 1, ny do
                    local bottom = floor + (j - 1) * step + ReferenceTerrain.CellShift
                    local mr, oc = {}, {}
                    for k = 1, n do
                        local ground = math.clamp((heights[i][k] - bottom) / step, 0, 1)
                        local water = wet[i][k] and math.clamp((ReferenceTerrain.WaterLevel - bottom) / step, 0, 1) or 0
                        if ground &gt;= 0.5 or ground &gt;= water and ground &gt; 0 then
                            mr[k], oc[k] = surface[i][k], ground
                        elseif water &gt; 0 then
                            mr[k], oc[k] = Enum.Material.Water, water
                        else
                            mr[k], oc[k] = Enum.Material.Air, 0
                        end
                    end
                    materials[i][j], occupancy[i][j] = mr, oc
                end
            end
            terrain:WriteVoxels(Region3.new(Vector3.new(cx, floor, cz), Vector3.new(cx + chunk, floor + ny * step, cz + chunk)), step, materials, occupancy)
            columns += n * n
            chunks += 1
        end
    end
    addCliffFaces(root)
    return {columns = columns, chunks = chunks, seconds = os.clock() - started}
end

return ReferenceTerrain
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX753eee59ec8bbab4a5fd4e1100272bcc72beb4d2">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local V=require(Shared.Visuals)
local C=require(Shared.Config)
local Assets=require(Shared.Assets.Loader)
local Landscape=require(script.Parent.ReferenceTerrain)
local ReferenceLayout=require(script.Parent.ReferenceLayout)
local MapPlan=require(script.Parent.MapPlan)
local Architecture=require(script.Parent.ReferenceArchitecture)
local W={Plots={},Areas={},Switches={}}
local stone=Color3.fromRGB(51,49,65)
local wood=Color3.fromRGB(62,43,58)
local purple=Color3.fromRGB(166,103,246)
local warm=Color3.fromRGB(255,188,104)
local function part(parent,name,size,pos,color,mat)
    return V.part(parent,name,size,CFrame.new(pos),color or stone,mat or Enum.Material.Slate)
end
local function prompt(p,text,object,callback)
    local pr=Instance.new('ProximityPrompt'); pr.ActionText=text; pr.ObjectText=object or ''; pr.MaxActivationDistance=12; pr.RequiresLineOfSight=false; pr.Parent=p
    if callback then pr.Triggered:Connect(callback) end
    return pr
end
W.prompt=prompt
local function lamp(parent,pos)
    if Assets.configured('StreetLamp') then
        local model=Assets.place('StreetLamp',parent,CFrame.new(pos))
        local glow=model:FindFirstChild('StreetLamp_Glow',true)
        if glow then
            local light=Instance.new('PointLight'); light.Color=warm; light.Brightness=2.8; light.Range=30; light.Parent=glow
        end
        return
    end
    part(parent,'LampPost',Vector3.new(0.4,7,0.4),pos+Vector3.new(0,3.5,0))
    local glow=part(parent,'Lantern',Vector3.new(1,1.6,1),pos+Vector3.new(0,7.5,0),warm,Enum.Material.Neon)
    local light=Instance.new('PointLight'); light.Color=warm; light.Brightness=2.8; light.Range=30; light.Parent=glow
    part(parent,'LanternCap',Vector3.new(1.6,0.3,1.6),pos+Vector3.new(0,8.5,0))
end
local function sign(parent,pos,text,color)
    local p=part(parent,'Sign',Vector3.new(9,3,0.6),pos,Color3.fromRGB(27,22,43),Enum.Material.Wood)
    V.label(p,text,color or purple,240,65)
    return p
end
-- Raised cobblestone walkway. Its top sits at y 0.5, flush with the plaza disc and the Haunt plinths and a full stud
-- proud of the nominal ground, so it stays visible however smooth Terrain rounds the surface; the slab reaches down
-- to y -0.7 so no gap opens beneath it. A slate curb runs along each side.
local function path(parent,a,b,width)
    local w=width or 12
    a=Vector3.new(a.X,0,a.Z); b=Vector3.new(b.X,0,b.Z)
    local mid=(a+b)/2
    local length=(a-b).Magnitude
    local p=part(parent,'Path',Vector3.new(w,1.2,length),mid,Color3.fromRGB(86,76,94),Enum.Material.Cobblestone)
    p.CFrame=CFrame.lookAt(mid,b)*CFrame.new(0,-0.1,0)
    for _,side in {-1,1} do
        local edge=part(parent,'PathEdging',Vector3.new(.4,.35,length),mid,Color3.fromRGB(57,53,69),Enum.Material.Slate)
        edge.CFrame=p.CFrame*CFrame.new(side*(w/2+.2),.6,0)
        edge.CanCollide=false; edge.CanQuery=false
    end
end
function W.build()
    local loadNames={}
    for _,name in {'StreetLamp','Gravestone','PineTree','DeadTree','Pumpkin','GhostFountain','ChamberPortal','RebirthAltar','NoticeBoard','WelcomeSign','HauntShowcase','MansionHill','MansionFacade','Boulder',
        'ShopHouse','Caretaker','MarketStall','OakCask','Crate','GraveyardFence','Crypt','GravestoneCross','GravestoneObelisk'} do
        if Assets.configured(name) then table.insert(loadNames,name) end
    end
    Assets.preload(loadNames)
    local buildStarted=os.clock()
    local root=Instance.new('Folder'); root.Name='GhostlightWorld'; root.Parent=workspace; W.Root=root
    local lighting=game:GetService('Lighting')
    -- Future lighting is much darker than Voxel at the same numbers: moonlit ambient, exposure and environment lighting are raised.
    lighting.ClockTime=0.5; lighting.Brightness=3; lighting.Ambient=Color3.fromRGB(100,105,146); lighting.OutdoorAmbient=Color3.fromRGB(145,160,205)
    lighting.GlobalShadows=true; lighting.FogColor=Color3.fromRGB(52,50,90); lighting.FogStart=700; lighting.FogEnd=1800
    lighting.EnvironmentDiffuseScale=1; lighting.EnvironmentSpecularScale=0.7; lighting.ShadowSoftness=0.25; lighting.ExposureCompensation=0.85
    local atm=Instance.new('Atmosphere'); atm.Density=0.16; atm.Offset=0.1; atm.Haze=1.3; atm.Glare=0.12
    atm.Color=Color3.fromRGB(112,116,165); atm.Decay=Color3.fromRGB(65,48,94); atm.Parent=lighting
    local bloom=Instance.new('BloomEffect'); bloom.Intensity=0.26; bloom.Size=26; bloom.Threshold=1.6; bloom.Parent=lighting
    local grade=Instance.new('ColorCorrectionEffect'); grade.Brightness=0.015; grade.Contrast=0.06; grade.Saturation=0.02; grade.TintColor=Color3.fromRGB(235,237,255); grade.Parent=lighting
    -- Smooth Terrain replaces the flat ground slab: level across everything built here, hills, ridge, rim and pond beyond.
    local landscape=Landscape.build(root)
    task.wait(.1) -- Let voxel collision update before the path builder samples its rendered surface.
    game:GetService('StarterPlayer').CharacterMaxSlopeAngle=60 -- near hills are walkable; the rim and ridge faces are steeper
    local plaza=part(root,'CircularPlaza',Vector3.new(1,104,104),Vector3.new(0,0,0),stone,Enum.Material.Cobblestone)
    plaza.Shape=Enum.PartType.Cylinder; plaza.CFrame=CFrame.new(0,0,0)*CFrame.Angles(0,0,math.pi/2)
    local spiritBlue=Color3.fromRGB(160,225,255)
    if Assets.configured('GhostFountain') then
        -- The plaza disc top is y 0.5; the fountain base sits on it. Its spirit is the Accent mesh, coloured blue-white.
        local fountain=Assets.place('GhostFountain',root,CFrame.new(0,0.5,0),{Accent=spiritBlue})
        local spirit=fountain:FindFirstChild('GhostFountain_Accent',true)
        if spirit then
            local l=Instance.new('PointLight'); l.Color=spiritBlue; l.Brightness=2.2; l.Range=28; l.Shadows=true; l.Parent=spirit
        end
    else
        local pedestal=part(root,'Fountain',Vector3.new(1.5,13,13),Vector3.new(0,1,0),stone)
        pedestal.Shape=Enum.PartType.Cylinder; pedestal.CFrame=CFrame.new(0,1,0)*CFrame.Angles(0,0,math.pi/2)
        V.ghost('mothlight',root,CFrame.new(0,7,0),2,false)
    end
    local spawn=Instance.new('SpawnLocation'); spawn.Name='TownSpawn'; spawn.Size=Vector3.new(8,1,8); spawn.Position=Vector3.new(0,0.6,21); spawn.Anchored=true; spawn.Neutral=true; spawn.Duration=0; spawn.Transparency=1; spawn.CanCollide=false; spawn.Parent=root
    -- Welcome signs flank the south path; nothing stands on the portal base any more.
    if Assets.configured('WelcomeSign') then
        for _,x in {-12,12} do
            local post=Assets.place('WelcomeSign',root,CFrame.new(x,-0.5,50))
            local board=post:FindFirstChild('WelcomeSign_Wood',true) or post:FindFirstChildWhichIsA('BasePart',true)
            V.label(board,'GHOSTLIGHT HOLLOW\nHunt • Haunt • Discover',purple,240,65).Parent.StudsOffset=Vector3.new(0,1.2,0)
        end
    else
        sign(root,Vector3.new(0,5,54),'GHOSTLIGHT HOLLOW\nHunt • Haunt • Discover')
    end
    local plotNumber=0
    local hauntHues={Color3.fromRGB(145,30,245),Color3.fromRGB(18,90,255),Color3.fromRGB(20,185,55),Color3.fromRGB(245,35,12),
        Color3.fromRGB(20,155,230),Color3.fromRGB(220,30,180),Color3.fromRGB(255,110,25)}
    local meshHaunts=Assets.configured('HauntShowcase')
    for i,plotSpec in ReferenceLayout.Plots do
        plotNumber=i
        local center=Vector3.new(plotSpec[1],plotSpec[2],plotSpec[3])
        local model=Instance.new('Model'); model.Name='Haunt'..i; model.Parent=root
        local cf=CFrame.new(center)*CFrame.Angles(0,math.rad(plotSpec[4]),0)
        local function p(name,size,offset,color,mat) return V.part(model,name,size,cf*CFrame.new(offset),color or wood,mat) end
        local label,incomeLabel,deposit,chamber,spireOffset
        local slots={}
        if meshHaunts then
            -- Visuals come from the HauntShowcase mesh. Collision, slot pads and label anchors stay primitives so the
            -- gate opening, pedestal tops and the server's plot contract never depend on Roblox's collision approximation.
            -- The mesh base sits on the ground top (y -0.5); its yard plinth top is therefore y 0.5.
            local imported=Assets.place('HauntShowcase',model,cf*CFrame.new(0,-0.5,0),{Accent=hauntHues[plotNumber]})
            local oldStone=imported:FindFirstChild('HauntShowcase_Stone',true)
            if oldStone then oldStone.Transparency=1; oldStone.CastShadow=false end
            local oldAccent=imported:FindFirstChild('HauntShowcase_Accent',true)
            if oldAccent then oldAccent.Transparency=1; oldAccent.CastShadow=false end
            p('GardenCourt',Vector3.new(45.5,1,39.5),Vector3.new(0,0,0),Color3.fromRGB(57,60,62),Enum.Material.Cobblestone)
            for _,side in {-1,1} do
                p('GardenGatePier',Vector3.new(1.4,4.2,1.4),Vector3.new(side*3.6,2.6,-20),stone,Enum.Material.Slate)
                p('GardenGateLantern',Vector3.new(.7,.6,.7),Vector3.new(side*3.6,5,-20),hauntHues[plotNumber],Enum.Material.Neon)
                for _,z in {-8,-1,6,13} do
                    p('EstateFlowerBed',Vector3.new(3.4,.55,4.8),Vector3.new(side*17.6,.8,z),Color3.fromRGB(29,55,36),Enum.Material.Grass)
                    for k=-1,1 do
                        local shrub=p('EstateFlowerShrub',Vector3.new(1.5,1.8,1.6),Vector3.new(side*17.6,1.6,z+k*1.25),Color3.fromRGB(30,67,42),Enum.Material.Grass)
                        shrub.Shape=Enum.PartType.Ball; shrub.CanCollide=false
                    end
                end
            end
            local function blocker(name,size,offset)
                local b=p(name,size,offset,stone); b.Transparency=1; b.CanQuery=false; return b
            end
            blocker('PlinthCollision',Vector3.new(46,1,40),Vector3.new(0,0,0))
            blocker('HouseCollision',Vector3.new(31.4,17.5,9.8),Vector3.new(0,9.25,15.6))
            for _,s in {-1,1} do
                blocker('SideFence',Vector3.new(0.6,3.4,40),Vector3.new(s*23,2.2,0))
                blocker('FrontFence',Vector3.new(18.6,3.4,0.6),Vector3.new(s*13.7,2.2,-20))
                blocker('GatePost',Vector3.new(1.4,4.2,1.4),Vector3.new(s*3.6,2.6,-20))
                blocker('SideHedge',Vector3.new(1.9,2.2,26),Vector3.new(s*21.5,1.6,-6))
                blocker('FrontHedge',Vector3.new(17.4,2.0,1.8),Vector3.new(s*13.2,1.5,-18.5))
            end
            local anchor=p('OwnerBoard',Vector3.new(0.5,0.5,0.5),Vector3.new(0,12.5,10.4))
            anchor.Transparency=1; anchor.CanCollide=false; anchor.CanQuery=false
            label=V.label(anchor,'UNCLAIMED HAUNT',purple,290,100)
            local hologram=p('IncomeHologram',Vector3.new(0.5,0.5,0.5),Vector3.new(0,9,2),Color3.fromRGB(131,255,225),Enum.Material.Neon)
            hologram.Transparency=1; hologram.CanCollide=false; hologram.CanQuery=false
            incomeLabel=V.label(hologram,'$/SEC • $0',Color3.fromRGB(131,255,225),210,48)
            deposit=p('Deposit',Vector3.new(5,0.4,5),Vector3.new(-11,0.7,-12),Color3.fromRGB(82,219,190),Enum.Material.Neon)
            V.label(deposit,'Deposit ghosts',Color3.fromRGB(153,255,223),140,45)
            chamber=p('ChamberDoor',Vector3.new(5,7,0.5),Vector3.new(11,4.5,14),purple,Enum.Material.Neon)
            chamber.Transparency=1; chamber.CanCollide=false; chamber.CanQuery=false
            for j=1,20 do
                local x=((j-1)%5-2)*6
                local z=math.floor((j-1)/5)*5-5
                blocker('Pedestal'..j,Vector3.new(3.2,1.2,3.2),Vector3.new(x,1.1,z))
                -- The pad is the server's slot part: it recolours and dims it, and hangs the display ghost 2.3 studs above it.
                local pedestal=p('RoundGardenPlinth',Vector3.new(1.2,1.9,1.9),Vector3.new(x,1.1,z),Color3.fromRGB(70,68,80),Enum.Material.Slate)
                pedestal.Shape=Enum.PartType.Cylinder; pedestal.CFrame=cf*CFrame.new(x,1.1,z)*CFrame.Angles(0,0,math.pi/2)
                local pad=p('Slot'..j,Vector3.new(2,0.3,2),Vector3.new(x,1.99,z),Color3.fromRGB(70,53,98),Enum.Material.Slate)
                local roundPad=Instance.new('CylinderMesh'); roundPad.Parent=pad
                table.insert(slots,pad)
            end
            -- Estate spires stand on the roof ridge instead of the yard edge, which the fence now occupies.
            spireOffset=function(s,k) return CFrame.new(s*(5+2.2*k),19+0.5*k,15.5) end
        else
            p('Foundation',Vector3.new(46,1,40),Vector3.new(0,0.5,0),stone,Enum.Material.Cobblestone)
            p('BackWall',Vector3.new(46,13,1),Vector3.new(0,7,19))
            for _,s in {-1,1} do
                p('SideWall',Vector3.new(1,13,40),Vector3.new(s*23,7,0))
                p('FrontPillar',Vector3.new(2,13,2),Vector3.new(s*21,7,-19))
                p('Roof',Vector3.new(24,1.5,42),Vector3.new(s*10,15.2,0),Color3.fromRGB(39,30,57)).CFrame=cf*CFrame.new(s*10,15.2,0)*CFrame.Angles(0,0,s*math.rad(-18))
            end
            local board=p('OwnerBoard',Vector3.new(18,3,1),Vector3.new(0,12,-16),Color3.fromRGB(24,19,37))
            label=V.label(board,'UNCLAIMED HAUNT',purple,290,100)
            local hologram=p('IncomeHologram',Vector3.new(0.5,0.5,0.5),Vector3.new(0,10,2),Color3.fromRGB(131,255,225),Enum.Material.Neon)
            hologram.Transparency=1
            incomeLabel=V.label(hologram,'$/SEC • $0',Color3.fromRGB(131,255,225),210,48)
            deposit=p('Deposit',Vector3.new(5,0.4,5),Vector3.new(-11,1.2,-10),Color3.fromRGB(82,219,190),Enum.Material.Neon)
            V.label(deposit,'Deposit ghosts',Color3.fromRGB(153,255,223),140,45)
            chamber=p('ChamberDoor',Vector3.new(5,7,0.5),Vector3.new(11,4.5,14),purple,Enum.Material.Neon)
            V.label(chamber,'HAUNT CHAMBER',purple,170,45)
            chamber.Transparency=1; chamber.CanCollide=false
            local chamberGui=chamber:FindFirstChild('Label'); if chamberGui then chamberGui.Enabled=false end
            for j=1,20 do
                local x=((j-1)%5-2)*6
                local z=math.floor((j-1)/5)*5-5
                local pad=p('Slot'..j,Vector3.new(4,0.4,4),Vector3.new(x,1.2,z),Color3.fromRGB(70,53,98))
                table.insert(slots,pad)
            end
        end
        W.Plots[plotNumber]={Model=model,CF=cf,Slots=slots,Label=label,IncomeLabel=incomeLabel,Deposit=deposit,ChamberDoor=chamber,SpireOffset=spireOffset,Owner=nil,Displays={}}
        Architecture.decorateHaunt(model,cf,hauntHues[plotNumber],V)
        model.WorldPivot=cf; model:ScaleTo(MapPlan.Scale)
        W.Plots[plotNumber].Scale=MapPlan.Scale
        local plinthTop=if meshHaunts then 0.5 else 1
        lamp(root,(cf*CFrame.new(-26.6,plinthTop*1.4,-21)).Position)
        lamp(root,(cf*CFrame.new(26.6,plinthTop*1.4,-21)).Position)
    end
    do
    local root=Instance.new('Model'); root.Name='MansionLandmark'; root.Parent=W.Root
    -- Landmark exterior. Hunting wings are separated so access remains personal and server-validated.
    local meshMansion=Assets.configured('MansionHill') and Assets.configured('MansionFacade')
    if meshMansion then
        -- Hill mesh: front edge at z -130, lower terrace top y 1.4, stair and flank slopes from z -144 to -157, upper terrace
        -- top y 11.8 to z -200. Walkable collision is primitive so the climb never depends on mesh collision fidelity.
        path(root,Vector3.new(0,0,-34),Vector3.new(0,0,-129),18)
        Assets.place('MansionHill',root,CFrame.new(0,-0.5,-165))
        local function blocker(name,size,cf)
            local b=V.part(root,name,size,cf,stone); b.Transparency=1; b.CanQuery=false; return b
        end
        local function slope(name,width,x)
            local wedge=Instance.new('WedgePart'); wedge.Name=name; wedge.Size=Vector3.new(width,10.4,13)
            -- A WedgePart is tall at its back (+Z); the hill rises toward -Z, so turn it around.
            wedge.CFrame=CFrame.new(x,6.6,-150.5)*CFrame.Angles(0,math.pi,0)
            wedge.Anchored=true; wedge.Transparency=1; wedge.CanQuery=false; wedge.Parent=root
        end
        blocker('LowerTerrace',Vector3.new(90,1.9,14),CFrame.new(0,0.45,-137))
        blocker('UpperTerrace',Vector3.new(90,12.3,43),CFrame.new(0,5.65,-178.5))
        slope('HillSlopeLeft',33,-28.5); slope('HillSlopeRight',33,28.5); slope('StairSlope',24,0)
        -- Facade mesh: its bounding box (porch railing to tower cornice) is centred 2.8 studs in front of the block centre,
        -- so z -183 puts the block at -172.8..-198.8 on the terrace and the porch columns at -167.3.
        Assets.place('MansionFacade',root,CFrame.new(0,11.8,-183),{Accent=purple})
        blocker('FacadeCollision',Vector3.new(124,50,26),CFrame.new(0,36.8,-185.8))
        for _,x in {-11,-5,5,11} do blocker('PorchColumn',Vector3.new(2.2,12.6,2.2),CFrame.new(x,18.1,-167.3)) end
        W.MansionDoor=V.part(root,'MansionEntrance',Vector3.new(10,14,1),CFrame.new(0,18.8,-172.5),purple,Enum.Material.Neon)
        W.MansionDoor.Transparency=1; W.MansionDoor.CanQuery=false
        V.label(W.MansionDoor,'The Haunted Mansion',purple,240,65).Parent.StudsOffset=Vector3.new(0,10,0)
    else
        path(root,Vector3.new(0,0,-34),Vector3.new(0,0,-180),18)
        local facade=Instance.new('Model'); facade.Name='MansionExterior'; facade.Parent=root
        part(facade,'EntranceSteps',Vector3.new(70,2,40),Vector3.new(0,0,-181))
        part(facade,'MansionFacade',Vector3.new(72,36,12),Vector3.new(0,18,-202),wood,Enum.Material.Brick)
        for _,x in {-31,31} do
            part(facade,'Tower',Vector3.new(15,52,19),Vector3.new(x,26,-204),stone,Enum.Material.Brick)
            local roof=part(facade,'TowerRoof',Vector3.new(20,12,23),Vector3.new(x,57,-204),Color3.fromRGB(37,27,53))
            roof.Shape=Enum.PartType.Ball
        end
        for x=-24,24,12 do for y=12,30,12 do part(facade,'GlowingWindow',Vector3.new(4,7,0.3),Vector3.new(x,y,-195.8),warm,Enum.Material.Neon) end end
        W.MansionDoor=part(facade,'MansionEntrance',Vector3.new(10,14,1),Vector3.new(0,8,-195),purple,Enum.Material.Neon)
        sign(root,Vector3.new(0,17,-179),'The Haunted Mansion')
    end
    local mansionRise=if meshMansion then 18.2 else 30
    for _,p in root:GetDescendants() do if p:IsA('BasePart') then p.CFrame+=Vector3.new(0,mansionRise,0) end end
    -- Terrain-relative scenery is placed after raising the authored facade and hill.
    for _,x in {-16,16} do
        for _,z in {-136,-160} do lamp(root,Vector3.new(x,Landscape.height(x,z),z)) end
    end
    if Assets.configured('Boulder') then
        for _,b in {{-50,-140},{52,-134},{-53,-176},{55,-192},{-60,-120}} do
            Assets.place('Boulder',root,CFrame.new(b[1],Landscape.height(b[1],b[2]),b[2]))
        end
    end
    local _,frontDoor=Architecture.decorateMansion(root,CFrame.new(0,30,-183),V)
    W.MansionDoor:Destroy()
    W.MansionDoor=frontDoor
    V.label(frontDoor,'The Haunted Mansion',purple,240,65).Parent.StudsOffset=Vector3.new(0,10,0)
    end
    -- Asset meshes face Roblox +Z (their Blender -Y front). Yaw +90 degrees turns that front toward +X.
    local faceEast=CFrame.Angles(0,math.pi/2,0)
    local faceWest=CFrame.Angles(0,-math.pi/2,0)
    local function anchor(parent,name,cf)
        local a=V.part(parent,name,Vector3.new(0.5,0.5,0.5),cf,stone); a.Transparency=1; a.CanCollide=false; a.CanQuery=false; return a
    end
    local function blocker(parent,name,size,cf)
        local b=V.part(parent,name,size,cf,stone); b.Transparency=1; b.CanQuery=false; return b
    end
    local townRoot=Instance.new('Model'); townRoot.Name='SpookyTown'; townRoot.Parent=root
    do
    local root=townRoot
    if Assets.configured('ShopHouse') then
        -- Shop row on the west side, fronts toward the plaza, north of the path to the eighth Haunt.
        -- The mesh bounding box is centred 1.1 studs in front of the building block (hanging sign and lantern).
        local shops={{z=48,name='The Workshop'},{z=71,name='The Hollow Inn'},{z=94,name='Curiosities'}}
        for k,shop in shops do
            Assets.place('ShopHouse',root,CFrame.new(-52,-0.5,shop.z)*faceEast,{Accent=warm})
            blocker(root,'ShopCollision'..k,Vector3.new(17.6,19,22),CFrame.new(-52.7,9,shop.z))
            local board=anchor(root,'ShopSign'..k,CFrame.new(-42.7,7.4,shop.z+4.2))
            V.label(board,shop.name,warm,220,60).Parent.StudsOffset=Vector3.new(0,1.6,0)
            if k==1 then
                W.Upgrades=V.part(root,'WorkshopDoor',Vector3.new(0.6,5,3.2),CFrame.new(-44.6,2.8,shop.z+4.2),warm,Enum.Material.Neon)
                W.Upgrades.Transparency=1; W.Upgrades.CanQuery=false
            end
        end
        for _,z in {62,84} do
            if Assets.configured('MarketStall') then Assets.place('MarketStall',root,CFrame.new(-38,-0.5,z)*faceEast,{Accent=Color3.fromRGB(255,140,60)}) end
            blocker(root,'StallCollision',Vector3.new(4.4,2.6,8),CFrame.new(-38,0.8,z))
        end
        if Assets.configured('OakCask') then for _,z in {56,68.5,100} do Assets.place('OakCask',root,CFrame.new(-41.5,-0.5,z)) end end
        if Assets.configured('Crate') then for _,c in {{-41.5,-0.5,90},{-39.6,-0.5,91.9},{-41.5,1.3,90}} do Assets.place('Crate',root,CFrame.new(c[1],c[2],c[3])) end end
        if Assets.configured('Pumpkin') then for _,c in {{-35.5,-0.5,58},{-35.2,-0.5,66.5},{-35.6,-0.5,80}} do Assets.place('Pumpkin',root,CFrame.new(c[1],c[2],c[3])) end end
    else
        W.Upgrades=sign(root,Vector3.new(-42,4,30),'The Workshop',warm)
    end
    end
    -- The legacy REBIRTH ALTAR sign is gone; it overlapped the altar built further down.
    if Assets.configured('NoticeBoard') then
        local board=Assets.place('NoticeBoard',root,CFrame.new(0,-0.5,62))
        W.Leaderboard=board:FindFirstChild('NoticeBoard_Collision',true) or board:FindFirstChildWhichIsA('BasePart',true)
        V.label(W.Leaderboard,'HOLLOW HUNTERS',warm,240,65).Parent.StudsOffset=Vector3.new(0,0.8,0)
    else
        W.Leaderboard=sign(root,Vector3.new(0,5,62),'HOLLOW HUNTERS',warm)
    end
    W.Leaderboard.Label.Size=UDim2.fromOffset(330,170)
    if Assets.configured('Caretaker') then
        for _,npc in {{x=-40,z=50,cf=faceEast,text='MIRA • EQUIPMENT'},{x=38,z=46.5,cf=faceWest,text='ORIN • REBIRTH'}} do
            Assets.place('Caretaker',root,CFrame.new(npc.x,-0.5,npc.z)*npc.cf,{Accent=warm})
            blocker(root,'CaretakerCollision',Vector3.new(2.2,5,2.2),CFrame.new(npc.x,2,npc.z))
            V.label(anchor(root,'CaretakerName',CFrame.new(npc.x,5.2,npc.z)),npc.text,warm,180,45)
        end
    else
        for _,spot in {{-47,36},{38,46.5}} do
            local x,z=spot[1],spot[2]
            local npc=part(root,'Caretaker',Vector3.new(2,3,1),Vector3.new(x,2,z),Color3.fromRGB(63,45,84))
            local head=part(root,'CaretakerHead',Vector3.new(1.5,1.5,1.5),Vector3.new(x,4.3,z),warm); head.Shape=Enum.PartType.Ball
            V.label(npc,if x&lt;0 then 'MIRA • EQUIPMENT' else 'ORIN • REBIRTH',warm,180,45)
        end
    end
    local rng=Random.new(1047)
    local meshPines,silhouettes=0,0
    do
    local root=Instance.new('Model'); root.Name='GraveyardLandmark'; root.Parent=W.Root
    if Assets.configured('GraveyardFence') then
        -- Fenced lot 50 (x) by 70 (z) centred at (150,105); the gate faces west toward the plaza.
        Assets.place('GraveyardFence',root,CFrame.new(150,-0.5,105)*faceWest,{Accent=Color3.fromRGB(80,220,140)})
        blocker(root,'GraveFenceW1',Vector3.new(0.6,3.4,30.5),CFrame.new(125,1.2,85.25))
        blocker(root,'GraveFenceW2',Vector3.new(0.6,3.4,30.5),CFrame.new(125,1.2,124.75))
        blocker(root,'GraveFenceE',Vector3.new(0.6,3.4,70),CFrame.new(175,1.2,105))
        blocker(root,'GraveFenceN',Vector3.new(50,3.4,0.6),CFrame.new(150,1.2,70))
        blocker(root,'GraveFenceS',Vector3.new(50,3.4,0.6),CFrame.new(150,1.2,140))
        for _,z in {100.5,109.5} do blocker(root,'GraveGatePost',Vector3.new(1.6,5.2,1.6),CFrame.new(125,2.1,z)) end
        local shapes={'Gravestone','GravestoneCross','GravestoneObelisk'}
        local k=0
        for _,z in {88,106,124} do
            for x=137,167,6 do
                k+=1
                local shape=shapes[(k%3)+1]
                if Assets.configured(shape) then Assets.place(shape,root,CFrame.new(x,-0.5,z)*faceWest) end
            end
        end
        if Assets.configured('Crypt') then
            for _,z in {80,130} do
                Assets.place('Crypt',root,CFrame.new(168,-0.5,z)*faceWest)
                blocker(root,'CryptCollision',Vector3.new(10.5,6,8.5),CFrame.new(168,2.5,z))
            end
        end
        if Assets.configured('DeadTree') then
            for _,c in {{140,78},{161,76},{140,134},{158,136}} do Assets.place('DeadTree',root,CFrame.new(c[1],-0.5,c[2])) end
        end
        for _,m in {{146,0.2,90,44,26},{156,0.3,120,36,28},{136,0.25,108,20,18}} do
            local mist=part(root,'GraveMist',Vector3.new(m[4],0.25,m[5]),Vector3.new(m[1],m[2],m[3]),Color3.fromRGB(150,160,180),Enum.Material.SmoothPlastic)
            mist.Transparency=0.85; mist.CanCollide=false; mist.CanQuery=false; mist.CastShadow=false
        end
        for _,x in {128,133} do
            local l=Instance.new('PointLight'); l.Color=Color3.fromRGB(120,220,160); l.Range=14; l.Brightness=0.6
            l.Parent=anchor(root,'GraveLight',CFrame.new(x,4,x==128 and 100 or 110))
        end
        sign(root,Vector3.new(122,4,113),'THE QUIET GARDEN',Color3.fromRGB(170,187,206))
    else
        for i=1,15 do
            local pos=Vector3.new(130+(i%5)*7,1.4,100+math.floor(i/5)*9)
            if Assets.configured('Gravestone') then
                Assets.place('Gravestone',root,CFrame.new(pos.X,-.5,pos.Z))
            else
                part(root,'Gravestone',Vector3.new(3,4,1),pos,Color3.fromRGB(86,86,102))
            end
        end
        sign(root,Vector3.new(146,3,93),'THE QUIET GARDEN',Color3.fromRGB(170,187,206))
    end
    for _,p in root:GetDescendants() do if p:IsA('BasePart') then p.CFrame+=Vector3.new(-20,0,30) end end
    end
    if Assets.configured('Pumpkin') then Assets.place('Pumpkin',root,CFrame.new(28.5,-0.5,46)) end
    for floor,info in C.Floors do
        local center=Vector3.new(5000+(floor-1)*150,0,-450)
        local area=Instance.new('Model'); area.Name='Floor'..floor; area.Parent=root
        part(area,'Floor',Vector3.new(132,2,112),center-Vector3.new(0,1,0),wood,Enum.Material.WoodPlanks)
        part(area,'Ceiling',Vector3.new(134,1,114),center+Vector3.new(0,19,0),Color3.fromRGB(27,23,38))
        for _,s in {-1,1} do
            part(area,'Wall',Vector3.new(2,20,114),center+Vector3.new(s*66,9,0),stone,Enum.Material.Brick)
            part(area,'Wall',Vector3.new(132,20,2),center+Vector3.new(0,9,s*56),stone,Enum.Material.Brick)
            for _,z in {-36,36} do part(area,'RoomDivider',Vector3.new(2,17,34),center+Vector3.new(s*22,8,z),wood) end
        end
        local entry=center+Vector3.new(0,3,35)
        local exit=part(area,'ReturnDoor',Vector3.new(8,9,0.5),center+Vector3.new(0,4.5,44),purple,Enum.Material.Neon)
        V.label(exit,'RETURN TO HAUNT',purple)
        sign(area,center+Vector3.new(0,12,40),floor..' • '..info.Name)
        local roomNames={'Foyer','Bedrooms','Library','Basement Workshop','Crypt Chapel','Catacomb Reliquary'}
        for room=1,3 do
            local roomSign=part(area,'RoomSign',Vector3.new(7,2,0.4),center+Vector3.new((room-2)*38,8,-50),Color3.fromRGB(34,27,48),Enum.Material.Wood)
            V.label(roomSign,roomNames[math.min(#roomNames,room+(floor-1))],warm,150,35)
        end
        local lights={}
        for _,x in {-36,0,36} do
            for _,z in {-25,25} do
                local pos=center+Vector3.new(x,0,z)
                local tablePart=part(area,'OldTable',Vector3.new(8,0.8,4),pos+Vector3.new(0,3,0),wood,Enum.Material.Wood)
                for _,dx in {-3,3} do part(area,'TableLeg',Vector3.new(0.5,3,0.5),pos+Vector3.new(dx,1.5,0),wood) end
                local candle=part(area,'Candle',Vector3.new(0.3,1.4,0.3),pos+Vector3.new(0,4,0),warm,Enum.Material.Neon)
                local l=Instance.new('PointLight'); l.Color=warm; l.Range=if floor&gt;=4 then 12 else 22; l.Brightness=0.9; l.Parent=candle; table.insert(lights,l)
                if floor==3 then
                    for k=1,5 do part(area,'Book',Vector3.new(0.7,1.2,1),tablePart.Position+Vector3.new(k-3,1,0),Color3.fromRGB(60+k*20,40,76)) end
                elseif floor==2 then
                    part(area,'Bed',Vector3.new(6,2,10),pos+Vector3.new(4,1,-10),Color3.fromRGB(63,39,72))
                elseif floor&gt;=5 then
                    part(area,'Sarcophagus',Vector3.new(5,3,9),pos+Vector3.new(3,1.5,-10),stone)
                end
            end
        end
        -- Lights remain atmospheric and non-toggleable during exploration.
        W.Areas[floor]={Model=area,Center=center,Entry=entry,Exit=exit,Lights=lights}
    end
    local portalGlow,portalLight,portalHome
    local portalCyan=Color3.fromRGB(103,245,224)
    if Assets.configured('ChamberPortal') then
        -- Ground top is y -0.5 outside the plaza disc; the portal base is one stud tall so it meets the plaza top.
        local portalModel=Assets.place('ChamberPortal',root,CFrame.new(0,-0.5,40),{Accent=purple})
        W.ChamberPortal=portalModel:FindFirstChild('ChamberPortal_Collision',true) or portalModel:FindFirstChildWhichIsA('BasePart',true)
        portalGlow=portalModel:FindFirstChild('ChamberPortal_Glow',true)
        if portalGlow then
            portalGlow.Color=portalCyan; portalHome=portalGlow.CFrame
            portalLight=Instance.new('PointLight'); portalLight.Color=portalCyan; portalLight.Range=22; portalLight.Brightness=3; portalLight.Shadows=true; portalLight.Parent=portalGlow
        end
        V.label(W.ChamberPortal,'Haunt Chamber',Color3.fromRGB(131,255,225),210,60).Parent.StudsOffset=Vector3.new(0,9,0)
    else
        local portalBase=part(root,'ChamberPortalBase',Vector3.new(16,1,16),Vector3.new(0,0.7,40),Color3.fromRGB(54,38,83),Enum.Material.Cobblestone)
        portalBase.Shape=Enum.PartType.Cylinder; portalBase.CFrame=CFrame.new(0,0.7,40)*CFrame.Angles(0,0,math.pi/2)
        portalGlow=part(root,'ChamberPortal',Vector3.new(8,12,1),Vector3.new(0,7,40),portalCyan,Enum.Material.Neon)
        portalGlow.Transparency=0.25; portalHome=portalGlow.CFrame
        portalLight=Instance.new('PointLight'); portalLight.Color=portalCyan; portalLight.Range=22; portalLight.Brightness=3; portalLight.Parent=portalGlow
        V.label(portalGlow,'Haunt Chamber',Color3.fromRGB(131,255,225),210,60)
        W.ChamberPortal=portalGlow
    end
    local orbAmber=Color3.fromRGB(255,197,111)
    if Assets.configured('RebirthAltar') then
        -- The shrine sits in the wedge between the Haunt 1 and Haunt 2 walkways, 12.5 studs clear of both centrelines.
        local altar=Assets.place('RebirthAltar',root,CFrame.new(33.5,-0.5,40),{Accent=Color3.fromRGB(169,93,246)})
        W.RebirthAltar=altar:FindFirstChild('RebirthAltar_Collision',true) or altar:FindFirstChildWhichIsA('BasePart',true)
        local orb=altar:FindFirstChild('RebirthAltar_Glow',true)
        if orb then
            orb.Color=orbAmber
            local altarLight=Instance.new('PointLight'); altarLight.Color=orbAmber; altarLight.Range=18; altarLight.Brightness=2; altarLight.Parent=orb
        end
        V.label(W.RebirthAltar,'Rebirth Altar',orbAmber,190,55).Parent.StudsOffset=Vector3.new(0,6,0)
        W.RebirthAltarPrompt=prompt(W.RebirthAltar,'View rebirth','Altar')
    else
        local altarBase=part(root,'RebirthAltarBase',Vector3.new(12,2,12),Vector3.new(33.5,1,40),Color3.fromRGB(62,45,81),Enum.Material.Marble)
        altarBase.Shape=Enum.PartType.Cylinder; altarBase.CFrame=CFrame.new(33.5,1,40)*CFrame.Angles(0,0,math.pi/2)
        W.RebirthAltar=part(root,'RebirthAltar',Vector3.new(4,5,4),Vector3.new(33.5,4,40),Color3.fromRGB(169,93,246),Enum.Material.Neon)
        W.RebirthAltar.Shape=Enum.PartType.Cylinder; W.RebirthAltar.CFrame=CFrame.new(33.5,4,40)*CFrame.Angles(0,0,math.pi/2)
        local altarOrb=part(root,'RebirthOrb',Vector3.new(2.2,2.2,2.2),Vector3.new(33.5,8,40),orbAmber,Enum.Material.Neon); altarOrb.Shape=Enum.PartType.Ball
        local altarLight=Instance.new('PointLight'); altarLight.Color=orbAmber; altarLight.Range=18; altarLight.Brightness=2; altarLight.Parent=altarOrb
        V.label(W.RebirthAltar,'Rebirth Altar',orbAmber,190,55)
        W.RebirthAltarPrompt=prompt(altarOrb,'View rebirth','Altar')
    end
    W.ChamberPortalPrompt=prompt(W.ChamberPortal,'Enter chamber','AFK hunting')
    task.spawn(function()
        while root.Parent do
            local t=os.clock()
            if portalGlow and portalHome then
                portalGlow.CFrame=portalHome*CFrame.new(0,math.sin(t*2)*0.25,0)*CFrame.Angles(0,math.sin(t)*0.05,0)
            end
            if portalLight then portalLight.Brightness=2.4+math.sin(t*3)*0.6 end
            task.wait(0.05)
        end
    end)
    task.spawn(function()
        while root.Parent do
            task.wait(4)
            local area=W.Areas[rng:NextInteger(1,6)]
            local l=area.Lights[1]
            if l.Enabled then l.Brightness=0.15; task.wait(0.12); l.Brightness=0.9 end
        end
    end)
    ReferenceLayout.build(root,W,Assets,V,Landscape)
    if portalGlow then portalHome=portalGlow.CFrame end
    require(script.Parent.ReferenceDetails).build(root,W,Assets,V,Landscape)
    local parts,meshes,lights=0,0,0
    for _,item in root:GetDescendants() do
        if item:IsA('MeshPart') then meshes+=1 elseif item:IsA('BasePart') then parts+=1 end
        if item:IsA('Light') then lights+=1 end
    end
    print(string.format('World.build %.3fs excluding preload: %d primitive parts, %d MeshParts, %d lights including interiors; landscape %d columns in %d chunks (%.2fs), %d hillside pines, %d silhouettes',
        os.clock()-buildStarted,parts,meshes,lights,landscape.columns,landscape.chunks,landscape.seconds,meshPines,silhouettes))
    -- Where smooth Terrain actually renders the nominal y -0.5 ground; read this from the Studio log after a Play.
    -- Terrain collision is built asynchronously after WriteVoxels, so the probe waits a few seconds.
    task.delay(4,function()
        local probe=RaycastParams.new(); probe.FilterType=Enum.RaycastFilterType.Include; probe.FilterDescendantsInstances={workspace.Terrain}
        local function surface(x,z)
            local hit=workspace:Raycast(Vector3.new(x,120,z),Vector3.new(0,-150,0),probe)
            return if hit then hit.Position.Y else -99
        end
        print(string.format('Landscape surface probe (nominal ground -0.50, walkway top 0.50): plaza edge %.2f, Haunt approach %.2f, mansion avenue %.2f, graveyard %.2f, hill %.2f',
            surface(0,60),surface(20,54),surface(0,-100),surface(150,105),surface(0,-232)))
        -- What a ray meets first above a walkway: the Path part means it is visible, Terrain means it is buried.
        local function first(x,z)
            local hit=workspace:Raycast(Vector3.new(x,30,z),Vector3.new(0,-60,0))
            return if hit then string.format('%s at %.2f',hit.Instance.Name,hit.Position.Y) else 'nothing'
        end
        local h1=W.Plots[1].CF.Position*0.6
        print('Walkway probe: Haunt 1 path '..first(h1.X,h1.Z)..'; mansion avenue '..first(0,-80)..'; plaza centre '..first(0,12))
    end)
    return W
end
return W
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBXc4e927fe6d283f975d2b0e9c0cc6188029554a72">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX93cd891a2bac902c510c4ff936e3850f4b3240d6">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX135273262b9e5f9824dbcbb169d1638806e76623">
        <Properties>
          <string name="Name">GhostlightClient</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX2a6ef7b3e419a21f0fe827aa201015f46535defb">
          <Properties>
            <string name="Name">Battle</string>
            <ProtectedString name="Source">-- Private 1v1 capture screen. All progress and weak-spot rewards come from the server.
local RunService=game:GetService('RunService')
local UserInputService=game:GetService('UserInputService')
local GuiService=game:GetService('GuiService')
local ContextActionService=game:GetService('ContextActionService')
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local C=require(Shared.Config)
local V=require(Shared.Visuals)
local BattleAvatar=require(script.Parent.BattleAvatar)
local Battle={}
local active=nil
local movementAction='GhostlightBattleMovement'
local ink=Color3.fromRGB(242,237,220)
local mint=Color3.fromRGB(133,255,220)
local gold=Color3.fromRGB(255,204,118)
local dark=Color3.fromRGB(19,14,31)
local function make(class,parent,props)
    local obj=Instance.new(class)
    for k,v in props do obj[k]=v end
    obj.Parent=parent
    return obj
end
local function box(parent,name,size,pos,color,z)
    return make('Frame',parent,{Name=name,Size=size,Position=pos,BackgroundColor3=color,BorderSizePixel=0,ZIndex=z or 1})
end
local function label(parent,name,value,size,pos,color,maxSize,z)
    local obj=make('TextLabel',parent,{Name=name,Text=value,Size=size,Position=pos,BackgroundTransparency=1,
        Font=Enum.Font.Arcade,TextColor3=color or ink,TextScaled=true,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=z or 2})
    make('UITextSizeConstraint',obj,{MinTextSize=9,MaxTextSize=maxSize or 26})
    return obj
end
local function outline(obj,color,thickness)
    return make('UIStroke',obj,{Color=color,Thickness=thickness or 2})
end
local function round(obj) make('UICorner',obj,{CornerRadius=UDim.new(1,0)}) end
local function contains(obj,pos)
    local p,s=obj.AbsolutePosition,obj.AbsoluteSize
    return pos.X&gt;=p.X and pos.Y&gt;=p.Y and pos.X&lt;=p.X+s.X and pos.Y&lt;=p.Y+s.Y
end
local function listen(session,signal,fn)
    table.insert(session.Connections,signal:Connect(fn))
end
local function portrait(parent,name,model,size,pos,back)
    local vp=make('ViewportFrame',parent,{Name=name,Size=size,Position=pos,BackgroundTransparency=1,Active=false,
        Ambient=Color3.fromRGB(165,161,189),LightColor=Color3.fromRGB(255,245,228),LightDirection=Vector3.new(-1,-1,2),ZIndex=4})
    local wm=make('WorldModel',vp,{Name='PortraitWorld'})
    model.Parent=wm
    for _,obj in model:GetDescendants() do
        if obj:IsA('Script') or obj:IsA('LocalScript') or obj:IsA('BillboardGui') or obj:IsA('Sound') then obj:Destroy()
        elseif obj:IsA('BasePart') then obj.Anchored=true; obj.CanCollide=false; obj.LocalTransparencyModifier=0 end
    end
    model:PivotTo(CFrame.new())
    local bounds,extent=model:GetBoundingBox()
    local camera=make('Camera',vp,{FieldOfView=38})
    vp.CurrentCamera=camera
    return {Viewport=vp,Model=model,Camera=camera,Bounds=bounds,Extent=extent,Back=back,Pivot=model:GetPivot(),Scale=model:GetScale()}
end
local function fitPortrait(p,t,shrink)
    local vp=p.Viewport
    local aspect=math.max(0.1,vp.AbsoluteSize.X/math.max(1,vp.AbsoluteSize.Y))
    local distance=math.max(p.Extent.Y,p.Extent.X/aspect)*0.58/math.tan(math.rad(19))+p.Extent.Z*0.65
    -- Back-right view projects the hunter's forward (-Z) direction toward the ghost on screen-right.
    local direction=if p.Back then Vector3.new(1.25,0.12,1).Unit else Vector3.new(0,0,-1)
    p.Camera.CFrame=CFrame.lookAt(p.Bounds.Position+direction*distance,p.Bounds.Position)
    p.Model:ScaleTo(p.Scale*shrink)
    p.Model:PivotTo(p.Pivot*CFrame.new(0,if p.Back then 0 else math.sin(t*2.4)*0.15,0))
end
function Battle.isActive() return active~=nil end
function Battle.close()
    local s=active
    if not s then return end
    active=nil
    for _,connection in s.Connections do connection:Disconnect() end
    ContextActionService:UnbindAction(movementAction)
    if s.Gui then s.Gui:Destroy() end
    if s.Hud.Parent then s.Hud.Enabled=s.HudEnabled end
    if s.Camera and s.Camera==workspace.CurrentCamera then s.Camera.CameraType=s.CameraType end
    UserInputService.MouseBehavior=s.MouseBehavior
    UserInputService.MouseIconEnabled=s.MouseIconEnabled
end
local function click(s)
    if active~=s or s.Finished then return end
    local now=os.clock()
    if now-s.LastClick&lt;C.Capture.ClickInterval then return end
    s.LastClick=now
    s.Remote:FireServer('Click',s.Id)
    s.PulseUntil=now+0.13
end
function Battle.progress(data)
    local s=active
    if not s or s.Id~=data.Id or s.Finished then return end
    s.Progress=data.Progress
end
function Battle.weakSpot(data)
    local s=active
    if not s or s.Id~=data.Id or s.Finished then return end
    s.Spot=data; s.SpotClaimed=false; s.Target.Visible=true; s.Ring.Visible=true
    s.Target.Position=UDim2.fromScale(data.X,data.Y)
    s.Ring.Position=s.Target.Position
    s.Feedback.Text='AIM INSIDE WHEN THE RING CLOSES'
    s.Feedback.TextColor3=dark
end
function Battle.weakSpotResult(data)
    local s=active
    if not s or s.Id~=data.Id or not s.Spot or s.Spot.Token~=data.Token or s.Finished then return end
    s.Progress=data.Progress
    s.Spot=nil; s.Target.Visible=false; s.Ring.Visible=false
    s.Feedback.Text=if data.Hit then string.format('WEAK SPOT! +%d%% CAPTURE',math.floor(data.Bonus*100+0.5)) else 'MISSED! KEEP CLICKING'
    s.Feedback.TextColor3=if data.Hit then Color3.fromRGB(18,112,90) else Color3.fromRGB(136,80,15)
    if data.Hit then s.Cue:Play(); s.PulseUntil=os.clock()+0.3 end
end
function Battle.finish(data)
    local s=active
    if not s or s.Id~=data.Id then return end
    s.Finished=os.clock(); s.Progress=1; s.Spot=nil
    s.Target.Visible=false; s.Ring.Visible=false; s.Exit.Visible=false
    s.Feedback.Text=string.upper(C.Ghosts[data.Species].Name)..' CAPTURED!'
    s.Feedback.TextColor3=Color3.fromRGB(18,112,90)
    s.Help.Text='Added to your vacuum. Returning to the mansion...'
    task.delay(1.35,function() if active==s then Battle.close() end end)
end
function Battle.open(player,hud,data,remote)
    Battle.close()
    local s={Id=data.Id,Hud=hud,HudEnabled=hud.Enabled,Connections={},Remote=remote,Progress=data.Progress or 0,
        ShownProgress=0,LastClick=0,PulseUntil=0,Touches={},Stick=Vector2.new(),PadCursor=Vector2.new(0.5,0.5),
        MouseBehavior=UserInputService.MouseBehavior,MouseIconEnabled=UserInputService.MouseIconEnabled}
    active=s
    local ok,err=xpcall(function()
        local species=C.Ghosts[data.Species]
        local accent=V.color(species.Rarity)
        local playerGui=player:WaitForChild('PlayerGui')
        if active~=s then return end
        local gui=make('ScreenGui',playerGui,{Name='GhostlightBattle',IgnoreGuiInset=true,
            ResetOnSpawn=false,DisplayOrder=900,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
        s.Gui=gui
        local backdrop=box(gui,'Backdrop',UDim2.fromScale(1,1),UDim2.new(),dark)
        make('UIGradient',backdrop,{Color=ColorSequence.new(Color3.fromRGB(16,13,28),Color3.fromRGB(53,36,66)),Rotation=90})
        local content=box(backdrop,'Content',UDim2.new(1,-48,1,-76),UDim2.fromOffset(24,60),dark)
        content.BackgroundTransparency=1
        label(content,'Heading','GHOST ENCOUNTER',UDim2.fromScale(0.67,0.09),UDim2.new(),gold,30)
        s.Exit=make('TextButton',content,{Name='Flee',Text='FLEE [Q]',Size=UDim2.fromScale(0.22,0.09),Position=UDim2.fromScale(0.78,0),
            BackgroundColor3=Color3.fromRGB(62,42,70),TextColor3=ink,TextScaled=true,Font=Enum.Font.Arcade,BorderSizePixel=0,ZIndex=3})
        make('UITextSizeConstraint',s.Exit,{MinTextSize=10,MaxTextSize=20})
        listen(s,s.Exit.Activated,function() if not s.Finished then remote:FireServer('Cancel') end end)
        local arena=box(content,'Arena',UDim2.fromScale(1,0.59),UDim2.fromScale(0,0.12),Color3.fromRGB(50,39,70))
        arena.ClipsDescendants=true; outline(arena,accent)
        make('UIGradient',arena,{Color=ColorSequence.new(Color3.fromRGB(34,29,52),Color3.fromRGB(90,67,97)),Rotation=90})
        -- Tall windows and floor lines suggest the mansion, with diagonal Pokemon-style platforms.
        for i=1,5 do
            local window=box(arena,'Window'..i,UDim2.fromScale(0.09,0.49),UDim2.fromScale(i*0.19-0.12,-0.09),Color3.fromRGB(139,117,165),2)
            window.BackgroundTransparency=0.85
            box(window,'Mullion',UDim2.fromScale(0.08,1),UDim2.fromScale(0.46,0),Color3.fromRGB(43,32,57),2)
        end
        for i=1,5 do
            local line=box(arena,'FloorLine'..i,UDim2.new(1,0,0,1),UDim2.fromScale(0,0.46+i*0.10),accent,2)
            line.BackgroundTransparency=0.88
        end
        local near=box(arena,'PlayerPlatform',UDim2.fromScale(0.46,0.16),UDim2.fromScale(0.015,0.80),Color3.fromRGB(90,86,111),3); round(near); outline(near,Color3.fromRGB(142,131,159))
        local far=box(arena,'GhostPlatform',UDim2.fromScale(0.39,0.12),UDim2.fromScale(0.56,0.56),Color3.fromRGB(107,91,123),3); round(far); outline(far,accent)
        local nameplate=box(arena,'GhostNameplate',UDim2.fromScale(0.43,0.20),UDim2.fromScale(0.035,0.05),dark,5)
        outline(nameplate,accent)
        label(nameplate,'GhostName',species.Name,UDim2.fromScale(0.90,0.50),UDim2.fromScale(0.05,0.07),ink,26,6)
        label(nameplate,'Rarity','WILD / '..string.upper(C.Rarities[species.Rarity]),UDim2.fromScale(0.90,0.25),UDim2.fromScale(0.05,0.65),accent,16,6)
        label(arena,'HunterName',player.DisplayName..' / HUNTER',UDim2.fromScale(0.44,0.07),UDim2.fromScale(0.03,0.91),ink,16,5)
        local wild=workspace:FindFirstChild('GhostlightWorld')
        wild=wild and wild:FindFirstChild('WildGhosts')
        local original=wild and wild:FindFirstChild('Ghost_'..data.Id)
        local ghost=if original then original:Clone() else V.ghost(data.Species,nil,CFrame.new(),1,false)
        if active~=s then ghost:Destroy(); return end
        ghost:ScaleTo(1)
        s.Ghost=portrait(arena,'Opponent',ghost,UDim2.fromScale(0.40,0.61),UDim2.fromScale(0.55,0.025),false)
        local char=player.Character
        if char then
            local avatar=BattleAvatar.create(char)
            s.Hunter=portrait(arena,'Hunter',avatar,UDim2.fromScale(0.48,0.69),UDim2.fromScale(0.01,0.23),true)
        end
        local field=box(arena,'WeakSpotField',UDim2.fromOffset(200,200),UDim2.fromScale(0.73,0.43),dark,8)
        field.AnchorPoint=Vector2.new(0.5,0.5); field.BackgroundTransparency=1; s.Field=field
        s.Target=box(field,'Target',UDim2.fromScale(C.Battle.SpotRadius*2,C.Battle.SpotRadius*2),UDim2.fromScale(0.5,0.5),dark,9)
        s.Target.AnchorPoint=Vector2.new(0.5,0.5); s.Target.BackgroundTransparency=0.20; round(s.Target)
        s.TargetStroke=outline(s.Target,ink,3)
        local cross=label(s.Target,'Crosshair','+',UDim2.fromScale(0.75,0.75),UDim2.fromScale(0.125,0.10),ink,30,10)
        cross.TextXAlignment=Enum.TextXAlignment.Center
        s.Ring=box(field,'ClosingRing',UDim2.fromScale(0.44,0.44),UDim2.fromScale(0.5,0.5),mint,10)
        s.Ring.AnchorPoint=Vector2.new(0.5,0.5); s.Ring.BackgroundTransparency=1; round(s.Ring); s.RingStroke=outline(s.Ring,gold,3)
        s.Target.Visible=false; s.Ring.Visible=false
        s.PadMarker=box(field,'GamepadCursor',UDim2.fromOffset(9,9),UDim2.fromScale(0.5,0.5),mint,12)
        s.PadMarker.AnchorPoint=Vector2.new(0.5,0.5); round(s.PadMarker); outline(s.PadMarker,dark,2); s.PadMarker.Visible=false
        local footer=box(content,'CapturePanel',UDim2.fromScale(1,0.25),UDim2.fromScale(0,0.75),Color3.fromRGB(239,232,212))
        outline(footer,accent,3)
        s.Feedback=label(footer,'Feedback','CLICK ANYWHERE TO VACUUM',UDim2.fromScale(0.90,0.23),UDim2.fromScale(0.04,0.065),dark,24)
        local track=box(footer,'CaptureTrack',UDim2.fromScale(0.92,0.21),UDim2.fromScale(0.04,0.37),Color3.fromRGB(58,48,72),2)
        s.Bar=box(track,'CaptureFill',UDim2.fromScale(0,1),UDim2.new(),mint,3)
        s.Percent=label(track,'CapturePercent','CAPTURE 0%',UDim2.fromScale(0.98,0.88),UDim2.fromScale(0.01,0.05),ink,20,4)
        s.Percent.TextXAlignment=Enum.TextXAlignment.Center; s.Percent.TextStrokeTransparency=0.25; s.Percent.TextStrokeColor3=dark
        s.Help=label(footer,'Instructions','Click to capture. Hover inside a circle as its ring closes: +12%.',UDim2.fromScale(0.92,0.28),UDim2.fromScale(0.04,0.66),Color3.fromRGB(70,56,86),18)
        s.Cue=make('Sound',gui,{SoundId='rbxasset://sounds/volume_slider.ogg',Volume=0.28,PlaybackSpeed=1.35})
        hud.Enabled=false
        s.Camera=workspace.CurrentCamera; s.CameraType=s.Camera.CameraType; s.Camera.CameraType=Enum.CameraType.Scriptable
        UserInputService.MouseBehavior=Enum.MouseBehavior.Default; UserInputService.MouseIconEnabled=true
        ContextActionService:BindActionAtPriority(movementAction,function() return Enum.ContextActionResult.Sink end,false,3000,
            Enum.PlayerActions.CharacterForward,Enum.PlayerActions.CharacterBackward,Enum.PlayerActions.CharacterLeft,
            Enum.PlayerActions.CharacterRight,Enum.PlayerActions.CharacterJump)
        listen(s,UserInputService.InputBegan,function(input,processed)
            if s.Finished or GuiService.MenuIsOpen or UserInputService:GetFocusedTextBox() then return end
            local kind=input.UserInputType
            if kind==Enum.UserInputType.MouseButton1 or kind==Enum.UserInputType.Touch then
                local pos=if kind==Enum.UserInputType.Touch then Vector2.new(input.Position.X,input.Position.Y) else UserInputService:GetMouseLocation()
                if not contains(content,pos) or contains(s.Exit,pos) then return end
                s.Mode=if kind==Enum.UserInputType.Touch then 'Touch' else 'Mouse'
                if kind==Enum.UserInputType.Touch then s.Touches[input]=pos end
                click(s)
            elseif not processed and (input.KeyCode==Enum.KeyCode.ButtonR2 or input.KeyCode==Enum.KeyCode.ButtonA) then
                s.Mode='Gamepad'; click(s)
            elseif not processed and (input.KeyCode==Enum.KeyCode.Q or input.KeyCode==Enum.KeyCode.ButtonB) then remote:FireServer('Cancel') end
        end)
        listen(s,UserInputService.InputChanged,function(input)
            if input.UserInputType==Enum.UserInputType.Touch and s.Touches[input] then s.Touches[input]=Vector2.new(input.Position.X,input.Position.Y)
            elseif input.KeyCode==Enum.KeyCode.Thumbstick2 then s.Stick=Vector2.new(input.Position.X,-input.Position.Y); s.Mode='Gamepad'
            elseif input.UserInputType==Enum.UserInputType.MouseMovement then s.Mode='Mouse' end
        end)
        listen(s,UserInputService.InputEnded,function(input) s.Touches[input]=nil end)
        listen(s,UserInputService.WindowFocusReleased,function() s.Focused=false; table.clear(s.Touches); s.Stick=Vector2.new() end)
        listen(s,UserInputService.WindowFocused,function() s.Focused=true end)
        listen(s,RunService.RenderStepped,function(dt)
            if active~=s then return end
            local now=os.clock()
            local side=math.min(arena.AbsoluteSize.X*0.52,arena.AbsoluteSize.Y*0.83)
            field.Size=UDim2.fromOffset(side,side)
            local finishTime=if s.Finished then math.clamp((now-s.Finished)/0.8,0,1) else 0
            fitPortrait(s.Ghost,now,math.max(0.03,(1-s.Progress*0.12)*(1-finishTime)))
            if s.Hunter then fitPortrait(s.Hunter,now,1) end
            s.ShownProgress+=(s.Progress-s.ShownProgress)*math.min(1,dt*16)
            s.Bar.Size=UDim2.fromScale(s.ShownProgress,1)
            s.Bar.BackgroundColor3=if now&lt;s.PulseUntil then gold else mint
            s.Percent.Text='CAPTURE '..math.floor(s.Progress*100+0.5)..'%'
            s.PadMarker.Visible=s.Mode=='Gamepad' and not s.Finished
            if s.Mode=='Gamepad' then
                s.PadCursor=Vector2.new(math.clamp(s.PadCursor.X+s.Stick.X*dt*0.7,0,1),math.clamp(s.PadCursor.Y+s.Stick.Y*dt*0.7,0,1))
                s.PadMarker.Position=UDim2.fromScale(s.PadCursor.X,s.PadCursor.Y)
            end
            if not s.Finished then
                s.Help.Text=if s.Mode=='Touch' then 'Tap to capture. Hold a circle as its ring closes: +12%.'
                    elseif s.Mode=='Gamepad' then 'A / R2: capture. Right stick: aim. B: flee. Circles: +12%.'
                    else 'Click to capture. Hover inside a circle as its ring closes: +12%.'
            end
            local spot=s.Spot
            if not spot then return end
            local remaining=spot.EndsAt-workspace:GetServerTimeNow()
            local t=math.clamp(1-remaining/C.Battle.SpotDuration,0,1)
            local radius=C.Battle.SpotRadius+(0.23-C.Battle.SpotRadius)*(1-t)
            s.Ring.Size=UDim2.fromScale(radius*2,radius*2)
            local pointer
            local function testPoint(pos)
                local uv=(pos-field.AbsolutePosition)/math.max(1,side)
                if (uv-Vector2.new(spot.X,spot.Y)).Magnitude&lt;=C.Battle.SpotRadius then pointer=uv end
            end
            if s.Mode=='Touch' then for _,pos in s.Touches do testPoint(pos) end
            elseif s.Mode=='Gamepad' then testPoint(field.AbsolutePosition+s.PadCursor*side)
            else testPoint(UserInputService:GetMouseLocation()) end
            local over=pointer~=nil and s.Focused~=false and not GuiService.MenuIsOpen and not UserInputService:GetFocusedTextBox()
            s.TargetStroke.Color=if over then mint else ink
            s.RingStroke.Color=if over then mint else gold
            if remaining&lt;=0 and remaining&gt;= -C.Battle.LateTolerance and not s.SpotClaimed then
                s.SpotClaimed=true -- Judge the pointer at closure, not after a missed circle.
                if over then remote:FireServer('WeakSpot',{Id=s.Id,Token=spot.Token,X=pointer.X,Y=pointer.Y}) end
            end
            if remaining&lt; -C.Battle.LateTolerance then s.Target.Visible=false; s.Ring.Visible=false end
        end)
    end,debug.traceback)
    if not ok then
        if active==s then Battle.close(); remote:FireServer('Cancel') end
        warn('Ghost battle screen: '..tostring(err))
    end
end
return Battle
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX54ec8bbe7c5b4d4fa4573f0bbfd8cea6edab6a29">
          <Properties>
            <string name="Name">BattleAvatar</string>
            <ProtectedString name="Source">-- A deterministic display rig using the player's appearance, not their current animation pose.
local V=require(game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight').Visuals)
local Avatar={}
local poses={
    RightShoulder={65,0,8}, ['Right Shoulder']={75,0,8},
    LeftShoulder={30,0,-10}, ['Left Shoulder']={30,0,-10},
    RightElbow={20,0,0}, LeftElbow={15,0,0}, RightWrist={-10,0,0},
}
function Avatar.create(character)
    local archivable=character.Archivable
    character.Archivable=true
    local ok,model=pcall(function() return character:Clone() end)
    character.Archivable=archivable
    assert(ok and model,'Could not clone the battle avatar')
    local built,err=xpcall(function()
        model.Name='BattleAvatar'
        for _,obj in model:GetDescendants() do
            if obj:IsA('Tool') or obj:IsA('Script') or obj:IsA('LocalScript') or obj:IsA('Animator')
                or obj:IsA('AnimationController') or obj:IsA('Sound') or obj:IsA('Beam') or obj:IsA('Trail') then
                obj:Destroy()
            elseif obj:IsA('BasePart') then
                obj.Anchored=true; obj.CanCollide=false; obj.LocalTransparencyModifier=0
            end
        end
        local root=model:FindFirstChild('HumanoidRootPart')
        assert(root,'Battle avatar has no root')
        model.PrimaryPart=root
        model:PivotTo(root.CFrame:Inverse()*model:GetPivot())
        local joints={}
        for _,joint in model:GetDescendants() do
            if (joint:IsA('JointInstance') or joint:IsA('WeldConstraint')) and joint.Part0 and joint.Part1
                and joint.Part0:IsDescendantOf(model) and joint.Part1:IsDescendantOf(model) then
                local offset
                if joint:IsA('WeldConstraint') then
                    offset=joint.Part0.CFrame:ToObjectSpace(joint.Part1.CFrame)
                else
                    if joint:IsA('Motor6D') then
                        joint.Transform=CFrame.new()
                        local pose=poses[joint.Name]
                        if pose then
                            -- Rotate in the parent's axes so both R6 and R15 shoulder bases work.
                            joint.C0=CFrame.new(joint.C0.Position)*CFrame.Angles(math.rad(pose[1]),math.rad(pose[2]),math.rad(pose[3]))*joint.C0.Rotation
                        end
                    end
                    offset=joint.C0*joint.C1:Inverse()
                end
                table.insert(joints,{Parent=joint.Part0,Child=joint.Part1,Offset=offset})
            end
        end
        -- Anchored viewport rigs do not solve joints automatically. Rebuild the body and
        -- accessory CFrames from the neutral skeleton, removing any captured run/jump pose.
        local solved={[root]=true}
        for _=1,#joints do
            local changed=false
            for _,joint in joints do
                if solved[joint.Parent] and not solved[joint.Child] then
                    joint.Child.CFrame=joint.Parent.CFrame*joint.Offset
                    solved[joint.Child]=true; changed=true
                end
            end
            if not changed then break end
        end
        local hand=model:FindFirstChild('RightHand') or model:FindFirstChild('Right Arm')
        assert(hand,'Battle avatar has no right hand')
        local gripAttachment=hand:FindFirstChild('RightGripAttachment')
        local gripPosition=if gripAttachment then gripAttachment.Position else Vector3.new(0,-hand.Size.Y*0.5,0)
        -- Always create a fresh vacuum: a cloned live Tool can retain a stale RightGrip,
        -- suction effects or a position from the middle of an equipment animation.
        local vacuum=V.vacuum(); vacuum.Parent=model
        local handle=vacuum.Handle
        local gripCF=CFrame.new(hand.CFrame:PointToWorldSpace(gripPosition))*root.CFrame.Rotation
        local delta=gripCF*handle.CFrame:Inverse()
        for _,part in vacuum:GetDescendants() do
            if part:IsA('BasePart') then part.CFrame=delta*part.CFrame; part.Anchored=true end
        end
        local weld=Instance.new('Weld'); weld.Name='BattleGrip'; weld.Part0=hand; weld.Part1=handle
        weld.C0=hand.CFrame:ToObjectSpace(gripCF); weld.C1=CFrame.new(); weld.Parent=hand
        model:SetAttribute('BattlePose','VacuumReadyV1')
    end,debug.traceback)
    if not built then model:Destroy(); error(err) end
    return model
end
return Avatar
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX92293e7e902348e3e77808815d35b0680d5918a8">
          <Properties>
            <string name="Name">Encounter</string>
            <ProtectedString name="Source">-- Original handheld-RPG encounter treatment, built entirely from UI and our ghost models.
-- One render loop owns the sequence; cancellation destroys every temporary instance.
local RunService=game:GetService('RunService')
local ContextActionService=game:GetService('ContextActionService')
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local C=require(Shared.Config)
local V=require(Shared.Visuals)
local Encounter={}
local active=nil
local inputAction='GhostlightEncounterInput'
local function make(class,parent,props)
    local obj=Instance.new(class)
    for key,value in props do obj[key]=value end
    obj.Parent=parent
    return obj
end
local function box(parent,name,size,pos,color,z)
    return make('Frame',parent,{Name=name,Size=size,Position=pos,BackgroundColor3=color,BorderSizePixel=0,ZIndex=z or 1})
end
local function text(parent,name,value,size,pos,color,z)
    local label=make('TextLabel',parent,{Name=name,Text=value,Size=size,Position=pos,BackgroundTransparency=1,
        Font=Enum.Font.Arcade,TextColor3=color,TextScaled=true,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=z or 2})
    make('UITextSizeConstraint',label,{MinTextSize=10,MaxTextSize=32})
    return label
end
local function ease(t)
    t=math.clamp(t,0,1)
    return 1-(1-t)^3
end
function Encounter.isPlaying()
    return active~=nil
end
function Encounter.cancel()
    local session=active
    if not session then return end
    active=nil
    ContextActionService:UnbindAction(inputAction)
    if session.Gui then session.Gui:Destroy() end
    if session.Hud.Parent then session.Hud.Enabled=session.HudEnabled end
end
function Encounter.play(player,hud,data)
    Encounter.cancel()
    local species=C.Ghosts[data.Species]
    if not species then return end
    local session={Hud=hud,HudEnabled=hud.Enabled}
    active=session
    task.spawn(function()
        local ok,err=xpcall(function()
            local playerGui=player:WaitForChild('PlayerGui')
            if active~=session then return end
            local black=Color3.fromRGB(10,8,18)
            local paper=Color3.fromRGB(244,237,215)
            local accent=V.color(species.Rarity)
            local gui=make('ScreenGui',playerGui,{Name='GhostlightEncounter',
                IgnoreGuiInset=true,ResetOnSpawn=false,DisplayOrder=1000,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
            session.Gui=gui
            local canvas=make('CanvasGroup',gui,{Name='Transition',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,Active=true})
            local scene=box(canvas,'BattleReveal',UDim2.fromScale(1,1),UDim2.new(),black,1)
            scene.Visible=false
            local stage=box(scene,'GhostStage',UDim2.fromScale(1,0.48),UDim2.fromScale(0,0.15),Color3.fromRGB(51,38,75),2)
            stage.ClipsDescendants=true
            make('UIGradient',stage,{Color=ColorSequence.new(Color3.fromRGB(23,18,41),Color3.fromRGB(92,67,114)),Rotation=90})
            box(scene,'TopRule',UDim2.new(1,0,0,4),UDim2.fromScale(0,0.15),accent,3)
            box(scene,'BottomRule',UDim2.new(1,0,0,4),UDim2.fromScale(0,0.63),accent,3)
            text(scene,'EncounterHeading','GHOST ENCOUNTER',UDim2.fromScale(0.86,0.06),UDim2.fromScale(0.07,0.055),accent,3)
            local streaks={}
            for i=1,14 do
                local stripe=box(stage,'SpeedLine'..i,UDim2.fromScale(0.15+(i%4)*0.06,0.006),UDim2.fromScale((i*0.29)%1,i/16),accent,3)
                stripe.BackgroundTransparency=0.7
                table.insert(streaks,stripe)
            end
            local ground=box(stage,'GhostShadow',UDim2.fromScale(0.32,0.10),UDim2.fromScale(0.53,0.83),black,3)
            make('UICorner',ground,{CornerRadius=UDim.new(1,0)})
            ground.BackgroundTransparency=0.2
            local viewport=make('ViewportFrame',stage,{Name='GhostPortrait',Size=UDim2.fromScale(0.52,0.92),Position=UDim2.fromScale(0.43,0.01),
                BackgroundTransparency=1,Ambient=Color3.fromRGB(155,155,180),LightColor=Color3.new(1,1,1),LightDirection=Vector3.new(-1,-1,2),ZIndex=4})
            local wm=make('WorldModel',viewport,{Name='PortraitWorld'})
            local world=workspace:FindFirstChild('GhostlightWorld')
            local wild=world and world:FindFirstChild('WildGhosts')
            local original=wild and wild:FindFirstChild('Ghost_'..data.Id)
            local ghost
            if original then
                ghost=original:Clone(); ghost.Parent=wm; ghost:ScaleTo(1); ghost:PivotTo(CFrame.new())
            else
                ghost=V.ghost(data.Species,wm,CFrame.new(),1,false)
            end
            -- Model loading can yield. A canceled/expired intro must never hide the HUD later.
            if active~=session or workspace:GetServerTimeNow()&gt;=data.EndsAt then return end
            for _,obj in ghost:GetDescendants() do
                if obj:IsA('BillboardGui') or obj:IsA('Script') or obj:IsA('LocalScript') then obj:Destroy() end
            end
            local bounds,size=ghost:GetBoundingBox()
            local camera=make('Camera',viewport,{FieldOfView=40})
            viewport.CurrentCamera=camera
            local rarity=text(stage,'Rarity',string.upper(C.Rarities[species.Rarity]),UDim2.fromScale(0.34,0.12),UDim2.fromScale(0.07,0.24),accent,4)
            text(stage,'WildLabel','WILD GHOST',UDim2.fromScale(0.32,0.09),UDim2.fromScale(0.07,0.41),paper,4)
            local dialogue=box(scene,'DialogueBorder',UDim2.fromScale(0.90,0.23),UDim2.fromScale(0.05,0.70),accent,3)
            local inner=box(dialogue,'Paper',UDim2.new(1,-8,1,-8),UDim2.fromOffset(4,4),paper,4)
            local message='A wild '..species.Name..' appeared!'
            local caption=text(inner,'EncounterText',message,UDim2.fromScale(0.90,0.49),UDim2.fromScale(0.05,0.08),black,5)
            text(inner,'Hint','Get your vacuum ready!',UDim2.fromScale(0.90,0.22),UDim2.fromScale(0.05,0.68),Color3.fromRGB(78,65,96),5)
            local flash=box(canvas,'Flash',UDim2.fromScale(1,1),UDim2.new(),paper,8)
            flash.BackgroundTransparency=1
            local bands={}
            for i=1,12 do
                local band=box(canvas,'Sweep'..i,UDim2.new(1,2,1/12,2),UDim2.new(if i%2==0 then -1.01 else 1.01,0,(i-1)/12,0),black,10)
                table.insert(bands,band)
            end
            hud.Enabled=false
            ContextActionService:BindActionAtPriority(inputAction,function() return Enum.ContextActionResult.Sink end,false,3000,
                Enum.PlayerActions.CharacterForward,Enum.PlayerActions.CharacterBackward,Enum.PlayerActions.CharacterLeft,
                Enum.PlayerActions.CharacterRight,Enum.PlayerActions.CharacterJump)
            -- Bundled effect: no uploaded audio or Pokemon assets required.
            local cue=make('Sound',gui,{SoundId='rbxasset://sounds/volume_slider.ogg',Volume=0.22,PlaybackSpeed=0.65})
            cue:Play()
            local endsAt=data.EndsAt
            while active==session do
                local t=math.clamp(1-(endsAt-workspace:GetServerTimeNow())/C.Encounter.Duration,0,1)
                if t&gt;=1 then session.Completed=true; break end
                -- A single warm flash, followed by staggered alternating horizontal shutters.
                flash.BackgroundTransparency=if t&lt;0.16 then 1-math.sin(t/0.16*math.pi)*0.72 else 1
                scene.Visible=t&gt;=0.40
                for i,band in bands do
                    local direction=if i%2==0 then -1 else 1
                    local delay=(i-1)*0.006
                    local covered=ease((t-0.16-delay)/0.16)
                    local opened=ease((t-0.44-delay)/0.15)
                    band.Position=UDim2.new(direction*((1-covered)-opened)*1.01,0,(i-1)/12,0)
                end
                local arrival=ease((t-0.44)/0.23)
                viewport.Position=UDim2.fromScale(0.43+(1-arrival)*0.65,0.01)
                viewport.ImageColor3=Color3.new(1,1,1):Lerp(Color3.fromRGB(15,10,25),1-ease((t-0.56)/0.12))
                rarity.TextTransparency=1-arrival
                caption.MaxVisibleGraphemes=math.floor(#message*math.clamp((t-0.59)/0.17,0,1))
                for i,stripe in streaks do stripe.Position=UDim2.fromScale(((i*0.29-t*(1+i%3))%1.4)-0.25,i/16) end
                local aspect=math.max(0.1,viewport.AbsoluteSize.X/math.max(1,viewport.AbsoluteSize.Y))
                local distance=math.max(size.Y,size.X/aspect)*0.60/math.tan(math.rad(20))+size.Z*0.5
                camera.CFrame=CFrame.lookAt(bounds.Position+Vector3.new(0,0,-distance),bounds.Position)
                -- Hold the reveal until BattleStart swaps in the 1v1 screen without a world flash.
                canvas.GroupTransparency=0
                RunService.RenderStepped:Wait()
            end
        end,debug.traceback)
        if active==session and (not ok or not session.Completed) then Encounter.cancel() end
        if not ok then warn('Ghost encounter transition: '..tostring(err)) end
    end)
end
return Encounter
