    Pumpkin={Id=88455361663381, Footprint=Vector3.new(2.8628, 2.29155, 2.87657), Roles={"Accent", "Collision", "Glow", "Wood"}},
    RebirthAltar={Id=117043793736449, Footprint=Vector3.new(12.2, 7.0, 12.2), Roles={"Accent", "Collision", "Glow", "Stone"}},
    ShopHouse={Id=75167034499776, Footprint=Vector3.new(23.6, 19.8, 20.45), Roles={"Glow", "Metal", "Roof", "Stone", "Wood"}},
    StreetLamp={Id=122240540563593, Footprint=Vector3.new(1.24, 8.6, 1.07387), Roles={"Collision", "Glow", "Metal"}},
    WelcomeSign={Id=95106154151130, Footprint=Vector3.new(2.9, 5.775, 0.6), Roles={"Collision", "Glow", "Metal", "Wood"}},
}
