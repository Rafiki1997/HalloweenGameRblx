      <Item class="ModuleScript" referent="RBX23c315f645e5b2dc6172c3ab2636b222a1f69843">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">local C = {}
C.Title = 'GHOSTLIGHT HOLLOW'
C.MaxPlayers = 7
C.Version = 1
C.SaveKey = 'GhostlightHollow_v1'
C.StudioPersistence = false
C.Rarities = {'Common', 'Uncommon', 'Rare', 'Epic', 'Legendary', 'Mythic', 'Secret'}
C.Colors = {{161,224,255},{141,247,166},{75,188,255},{186,105,255},{255,199,81},{255,100,157},{240,243,255}}
C.Slots = {5,8,12,16,20}
C.HauntCosts = {0,150000,1400000,10000000,75000000}
C.Capacity = {3,5,8,12,18,25}
C.Floors = {
    {Name='Abandoned Foyer', Cost=0, Min=1, Max=3},
    {Name='Whispering Bedrooms', Cost=350000, Min=2, Max=4},
    {Name='Cursed Library', Cost=3500000, Min=3, Max=5},
    {Name='Forgotten Basement', Cost=35000000, Min=4, Max=6},
    {Name='The Moonless Crypt', Cost=350000000, Min=5, Max=7},
    {Name='The Catacombs', Cost=2500000000, Min=6, Max=7},
}
C.UpgradeNames = {'Suction','Capture','Capacity','Movement','Flashlight'}
C.UpgradeBase = {Suction=15000,Capture=20000,Capacity=12000,Movement=10000,Flashlight=8000}
C.MaxUpgrade = 6
C.Capture = {Range=24, BreakRange=38, ClickInterval=0.09, IdleTimeout=2.5, Tick=0.1, AttackInterval=4.5, AttackRange=12, AttackDamage=0.7}
C.ChamberInterval = 35
C.Ghosts = {
    mothlight={Name='Mothlight',Rarity=1,Income=3,Shape='Moth',Weight=65},
    teacup_trembler={Name='Teacup Trembler',Rarity=1,Income=4,Shape='Cup',Weight=45},
    lantern_lurker={Name='Lantern Lurker',Rarity=2,Income=10,Shape='Lantern',Weight=28},
    button_boo={Name='Button Boo',Rarity=2,Income=13,Shape='Doll',Weight=22},
    clockwork_wail={Name='Clockwork Wail',Rarity=3,Income=32,Shape='Clock',Weight=12},
    ivy_specter={Name='Ivy Specter',Rarity=3,Income=42,Shape='Vine',Weight=10},
    velvet_veil={Name='Velvet Veil',Rarity=4,Income=135,Shape='Veil',Weight=5},
    quillgeist={Name='Quillgeist',Rarity=4,Income=175,Shape='Book',Weight=4},
    hollow_regent={Name='Hollow Regent',Rarity=5,Income=700,Shape='Crown',Weight=1.8},
    bellwarden={Name='Bellwarden',Rarity=5,Income=950,Shape='Knight',Weight=1.4},
    eclipse_mourner={Name='Eclipse Mourner',Rarity=6,Income=3750,Shape='Eclipse',Weight=0.5},
    starless_stag={Name='Starless Stag',Rarity=6,Income=5000,Shape='Stag',Weight=0.35},
    the_last_candle={Name='The Last Candle',Rarity=7,Income=21000,Shape='Candle',Weight=0.035},
    door_to_nowhere={Name='Door to Nowhere',Rarity=7,Income=32500,Shape='Door',Weight=0.02},
}
for id, g in C.Ghosts do
    g.Id = id
    g.Difficulty = 1 + (g.Rarity - 1) * 0.85
    g.Areas = {}
    for i, floor in C.Floors do
        if g.Rarity &gt;= floor.Min and g.Rarity &lt;= floor.Max then table.insert(g.Areas, i) end
    end
end
return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8026ef5478f73d16106a6be4cf591768b23eccf9">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">local Config = if script then require(script.Parent.Config) else require('./Config')
local R = {}
local function integer(v, lo, hi, fallback)
    if type(v) ~= 'number' or v ~= v or math.abs(v) == math.huge then return fallback end
    return math.clamp(math.floor(v), lo, hi)
end
function R.newProfile()
    return {Version=1,Money=0,Owned={},Discovered={},Bag={},Placed={},HauntLevel=1,Floor=1,Rebirths=0,
        Upgrades={Suction=1,Capture=1,Capacity=1,Movement=1,Flashlight=1},Captures=0,ChamberDiscoveries=0}
end
function R.reconcile(raw)
    local p = R.newProfile()
    if type(raw) ~= 'table' then return p end
    p.Money = integer(raw.Money,0,1e15,0)
    p.HauntLevel = integer(raw.HauntLevel,1,5,1)
    p.Floor = integer(raw.Floor,1,6,1)
    p.Rebirths = integer(raw.Rebirths,0,10000,0)
    p.Captures = integer(raw.Captures,0,1e12,0)
    p.ChamberDiscoveries = integer(raw.ChamberDiscoveries,0,1e12,0)
    for name in p.Upgrades do
        p.Upgrades[name] = integer(type(raw.Upgrades)=='table' and raw.Upgrades[name],1,6,1)
    end
    for id in Config.Ghosts do
        local qty = integer(type(raw.Owned)=='table' and raw.Owned[id],0,1e9,0)
        if qty &gt; 0 then p.Owned[id] = qty end
        if qty &gt; 0 or (type(raw.Discovered)=='table' and raw.Discovered[id] == true) then p.Discovered[id] = true end
    end
    local used = {}
    for _, field in {'Bag','Placed'} do
        if type(raw[field]) == 'table' then
            local limit = if field=='Bag' then R.capacity(p) else Config.Slots[p.HauntLevel]
            for _, id in raw[field] do
                if type(id)=='string' and Config.Ghosts[id] and #p[field]&lt;limit and (used[id] or 0)&lt;(p.Owned[id] or 0) then
                    table.insert(p[field],id)
                    used[id]=(used[id] or 0)+1
                end
            end
        end
    end
    return p
end
function R.capacity(p) return Config.Capacity[p.Upgrades.Capacity] end
function R.multiplier(p) return 1+p.Rebirths*0.5 end
function R.income(p)
    local sum=0
    for _, id in p.Placed do sum += Config.Ghosts[id].Income end
    return sum * R.multiplier(p)
end
function R.capture(progress, clicks, power, difficulty, dt)
    return math.clamp(progress + clicks*(0.085+0.025*(power-1))/difficulty - dt*0.028*difficulty,0,1)
end
function R.captureReward(p,id)
    if not Config.Ghosts[id] or #p.Bag&gt;=R.capacity(p) then return false end
    p.Owned[id]=(p.Owned[id] or 0)+1
    p.Discovered[id]=true
    p.Captures+=1
    table.insert(p.Bag,id)
    return true
end
function R.chamberReward(p,id)
    if #p.Placed==0 or not Config.Ghosts[id] or not table.find(Config.Ghosts[id].Areas,p.Floor) then return false end
    p.Owned[id]=(p.Owned[id] or 0)+1
    p.Discovered[id]=true
    p.ChamberDiscoveries+=1
    return true
end
function R.deposit(p) table.clear(p.Bag) end
function R.available(p,id)
    local n=p.Owned[id] or 0
    for _, v in p.Placed do if v==id then n-=1 end end
    for _, v in p.Bag do if v==id then n-=1 end end
    return n
end
function R.place(p,id)
    if not Config.Ghosts[id] or #p.Placed&gt;=Config.Slots[p.HauntLevel] or R.available(p,id)&lt;=0 then return false end
    table.insert(p.Placed,id)
    return true
end
function R.remove(p,index)
    if type(index)~='number' or index~=math.floor(index) or index&lt;1 or index&gt;#p.Placed then return false end
    table.remove(p.Placed,index)
    return true
end
function R.upgradeCost(p,name)
    if name=='Haunt' then return Config.HauntCosts[p.HauntLevel+1] end
    if not Config.UpgradeBase[name] or p.Upgrades[name]&gt;=Config.MaxUpgrade then return nil end
    return math.floor(Config.UpgradeBase[name]*4^(p.Upgrades[name]-1))
end
function R.upgrade(p,name)
    local cost=R.upgradeCost(p,name)
    if not cost or p.Money&lt;cost then return false end
    p.Money-=cost
    if name=='Haunt' then p.HauntLevel+=1 else p.Upgrades[name]+=1 end
    return true
end
function R.unlock(p,floor)
    if type(floor)~='number' or floor~=p.Floor+1 or not Config.Floors[floor] then return false end
    local cost=Config.Floors[floor].Cost
    if p.Money&lt;cost then return false end
    p.Money-=cost
    p.Floor=floor
    return true
end
function R.rebirthCost(p) return 5000000000*(1+p.Rebirths) end
function R.rebirth(p)
    if p.Floor&lt;6 or p.Money&lt;R.rebirthCost(p) then return false end
    p.Money=0
    p.Floor=1
    p.HauntLevel=1
    p.Rebirths+=1
    table.clear(p.Bag)
    table.clear(p.Placed)
    for name in p.Upgrades do p.Upgrades[name]=1 end
    return true
end
function R.pool(floor)
    local result={}
    for id,g in Config.Ghosts do if table.find(g.Areas,floor) then table.insert(result,id) end end
    table.sort(result)
    return result
end
function R.roll(floor,unit)
    local pool=R.pool(floor)
    local total=0
    for _,id in pool do total+=Config.Ghosts[id].Weight end
    local pick=unit*total
    for _,id in pool do pick-=Config.Ghosts[id].Weight; if pick&lt;=0 then return id end end
    return pool[#pool]
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX934570645631dd5f62d0bd1fb54803ce96e2c02d">
        <Properties>
          <string name="Name">Visuals</string>
          <ProtectedString name="Source">local Config=require(script.Parent.Config)
local V={}
function V.color(rarity) return Color3.fromRGB(table.unpack(Config.Colors[rarity])) end
function V.part(parent,name,size,cf,color,material)
    local p=Instance.new('Part')
    p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic
    p.Anchored=true; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
function V.label(part,text,color,width,height)
    local gui=Instance.new('BillboardGui')
    gui.Name='Label'; gui.Size=UDim2.fromOffset(width or 230,height or 60)
    gui.StudsOffset=Vector3.new(0,3,0); gui.MaxDistance=90; gui.AlwaysOnTop=false; gui.Parent=part
    local label=Instance.new('TextLabel')
    label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.Text=text
    label.TextColor3=color or Color3.new(1,1,1); label.TextStrokeTransparency=0.4
    label.Font=Enum.Font.GothamBold; label.TextSize=16; label.TextWrapped=true; label.Parent=gui
    return label
end
function V.ghost(id,parent,cf,scale,withLabel)
    local g=Config.Ghosts[id]
    local m=Instance.new('Model'); m.Name=g.Name; m:SetAttribute('Species',id)
    local c=V.color(g.Rarity)
    local root=V.part(m,'Core',Vector3.new(2.5,2.8,2),CFrame.new(),c,Enum.Material.Neon)
    root.Shape=Enum.PartType.Ball; root.Transparency=0.32; root.CanCollide=false
    m.PrimaryPart=root
    local function piece(name,size,pos,color,ball,rotation)
        local p=V.part(m,name,size,CFrame.new(pos)*(rotation or CFrame.new()),color or c,Enum.Material.Neon)
        p.CanCollide=false
        if ball then p.Shape=Enum.PartType.Ball end
        return p
    end
    for _,x in {-0.48,0.48} do piece('Eye',Vector3.new(0.34,0.48,0.2),Vector3.new(x,0.3,-0.91),Color3.fromRGB(18,13,37),true) end
    piece('Tail',Vector3.new(1.25,1.8,1),Vector3.new(0,-1.4,0),c,true)
    local shape=g.Shape
    if shape=='Moth' then
        for _,s in {-1,1} do piece('Wing',Vector3.new(2.6,1.7,0.25),Vector3.new(s*1.6,0.3,0.2),c,true,CFrame.Angles(0,0,s*0.4)) end
    elseif shape=='Cup' then
        root.Shape=Enum.PartType.Cylinder; root.CFrame=CFrame.Angles(0,0,math.pi/2)
        piece('Handle',Vector3.new(1,1.3,0.4),Vector3.new(1.5,0,0),Color3.fromRGB(240,222,201),true)
        piece('Saucer',Vector3.new(3.5,0.2,2.8),Vector3.new(0,-1.35,0),Color3.fromRGB(240,222,201),true)
    elseif shape=='Lantern' then
        for _,x in {-1,1} do piece('Iron',Vector3.new(0.2,3.4,0.2),Vector3.new(x,0,-0.8),Color3.fromRGB(43,40,57)) end
        piece('Cap',Vector3.new(2.8,0.4,2.5),Vector3.new(0,1.6,0))
    elseif shape=='Doll' then
        root.Size=Vector3.new(1.8,1.8,1.8)
        piece('Dress',Vector3.new(2,2.1,1.2),Vector3.new(0,-1.8,0))
        for _,s in {-1,1} do piece('Arm',Vector3.new(0.5,1.8,0.5),Vector3.new(s*1.35,-1.4,0),c,true) end
    elseif shape=='Clock' then
        root.Size=Vector3.new(3,3,1)
        piece('ClockHand',Vector3.new(0.15,1,0.15),Vector3.new(0,0.5,-0.65),Color3.new(1,1,1))
        piece('Pendulum',Vector3.new(0.2,2,0.2),Vector3.new(0,-2,0))
        piece('Weight',Vector3.new(0.8,0.8,0.5),Vector3.new(0,-3,0),c,true)
    elseif shape=='Vine' or shape=='Stag' then
        for _,s in {-1,1} do
            piece('Antler',Vector3.new(0.25,2.4,0.25),Vector3.new(s*1.1,2,0),c,false,CFrame.Angles(0,0,-s*0.4))
            piece('Branch',Vector3.new(1,0.2,0.2),Vector3.new(s*1.6,2.1,0))
        end
        if shape=='Stag' then piece('Muzzle',Vector3.new(1.4,0.8,1.7),Vector3.new(0,-0.3,-1.1),c,true) end
    elseif shape=='Veil' then
        for i=1,5 do piece('Veil',Vector3.new(0.6,3.8,0.3),Vector3.new((i-3)*0.7,-0.6,0.7),c,true) end
    elseif shape=='Book' then
        root.Shape=Enum.PartType.Block; root.Size=Vector3.new(3,2,0.9)
        piece('Pages',Vector3.new(2.6,1.7,0.2),Vector3.new(0,0,-0.65),Color3.fromRGB(230,217,190))
        piece('Quill',Vector3.new(0.4,3,0.3),Vector3.new(2,0.7,0),c,true,CFrame.Angles(0,0,-0.4))
    elseif shape=='Crown' or shape=='Knight' then
        piece('Shoulders',Vector3.new(4,0.7,1.6),Vector3.new(0,-1,0),Color3.fromRGB(100,93,130))
        for i=-1,1 do piece('Crown',Vector3.new(0.5,1.2,0.5),Vector3.new(i*0.9,1.8,0),c) end
        if shape=='Knight' then piece('Lance',Vector3.new(0.3,5,0.3),Vector3.new(2.5,0,0)) end
    elseif shape=='Eclipse' then
        root.Color=Color3.fromRGB(30,16,43)
        for i=1,12 do local a=i*math.pi/6; piece('Halo',Vector3.new(0.6,0.6,0.3),Vector3.new(math.cos(a)*2.2,math.sin(a)*2.2,0.5),c,true) end
    elseif shape=='Candle' then
        root.Shape=Enum.PartType.Block; root.Size=Vector3.new(1.6,3.8,1.6); root.Color=Color3.fromRGB(243,226,189)
        piece('Flame',Vector3.new(0.8,1.6,0.8),Vector3.new(0,2.8,0),c,true)
    elseif shape=='Door' then
        root.Shape=Enum.PartType.Block; root.Size=Vector3.new(2.5,4.8,0.7); root.Color=Color3.fromRGB(14,10,30)
        for _,s in {-1,1} do piece('Frame',Vector3.new(0.25,5.4,0.9),Vector3.new(s*1.5,0,0)) end
        piece('Lintel',Vector3.new(3.2,0.25,0.9),Vector3.new(0,2.6,0))
    end
    local light=Instance.new('PointLight'); light.Color=c; light.Range=9; light.Brightness=0.38; light.Parent=root
    m.Parent=parent; m:PivotTo(cf); m:ScaleTo(scale or 1)
    if withLabel then V.label(root,g.Name..'\n'..Config.Rarities[g.Rarity],c,180,48) end
    return m
end
function V.vacuum()
    local t=Instance.new('Tool'); t.Name='Spectral Vacuum'; t.RequiresHandle=true; t.CanBeDropped=false
    t.Grip=CFrame.new(0,-0.3,0.5)*CFrame.Angles(0,0,0)
    local handle=V.part(t,'Handle',Vector3.new(0.65,1,0.65),CFrame.new(),Color3.fromRGB(43,39,57))
    local function attach(name,size,position,color,material)
        local p=V.part(t,name,size,CFrame.new(position),color,material)
        local w=Instance.new('WeldConstraint'); w.Part0=handle; w.Part1=p; w.Parent=p
        return p
    end
    attach('Body',Vector3.new(1.4,1.4,2.3),Vector3.new(0,0.6,-0.4),Color3.fromRGB(78,63,105),Enum.Material.Metal)
    local tank=attach('CaptureContainer',Vector3.new(1,1.6,1),Vector3.new(0,1.4,0.2),Color3.fromRGB(108,245,225),Enum.Material.Neon)
    tank.Transparency=0.35
    attach('Hose',Vector3.new(0.55,0.55,2),Vector3.new(0,0.6,-2),Color3.fromRGB(30,28,40))
    local nozzle=attach('Nozzle',Vector3.new(1,0.85,0.6),Vector3.new(0,0.6,-3),Color3.fromRGB(174,154,220),Enum.Material.Metal)
    local a=Instance.new('Attachment'); a.Name='Suction'; a.Position=Vector3.new(0,0,-0.35); a.Parent=nozzle
    local lens=attach('Flashlight',Vector3.new(0.45,0.45,0.3),Vector3.new(0.7,0.8,-1.5),Color3.fromRGB(255,236,178),Enum.Material.Neon)
    local light=Instance.new('SpotLight'); light.Name='Lamp'; light.Face=Enum.NormalId.Front; light.Angle=65; light.Range=40; light.Brightness=3; light.Shadows=true; light.Parent=lens
    for _,p in t:GetDescendants() do if p:IsA('BasePart') then p.Anchored=false; p.CanCollide=false; p.Massless=true end end
    return t
end
return V
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX15343b82a4c762836f7b982e03f4abaa9d4afa85">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX9a8fa37bb0b85f588cf6f9888edec67b45975d98">
      <Properties>
        <string name="Name">GhostlightServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXaa7da4f6cc206ce3b8a5684ff2bfd2ffa2185da4">
        <Properties>
          <string name="Name">Chamber</string>
          <ProtectedString name="Source">local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local V=require(Shared.Visuals)
local Rules=require(Shared.Rules)
local C=require(Shared.Config)
local Chamber={Sessions={}}
local rng=Random.new()
local world,profiles,remote,changed
function Chamber.leave(player)
    local s=Chamber.Sessions[player]
    if s then s.Model:Destroy(); Chamber.Sessions[player]=nil end
    player:SetAttribute('Chamber',false)
    local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
    if hum then hum.AutoRotate=true end
    remote:FireClient(player,'ChamberExit')
end
function Chamber.enter(player,plotIndex)
    local p=profiles.get(player)
    if not p or #p.Placed==0 then remote:FireClient(player,'Notice','Place at least one ghost in your Haunt first.'); return false end
    if Chamber.Sessions[player] then return false end
    local center=Vector3.new((plotIndex-1)*130,0,-720)
    local m=Instance.new('Model'); m.Name='Chamber_'..player.UserId; m.Parent=world.Root
    local function part(name,size,pos,color)
        return V.part(m,name,size,CFrame.new(center+pos),color or Color3.fromRGB(62,44,72),Enum.Material.Slate)
    end
    part('MiniatureFloor',Vector3.new(68,1,54),Vector3.new(0,0,0))
    for _,s in {-1,1} do
        part('Wall',Vector3.new(68,4,1),Vector3.new(0,2,s*27))
        part('Wall',Vector3.new(1,4,54),Vector3.new(s*34,2,0))
        for _,z in {-19,19} do part('RoomWall',Vector3.new(1,4,16),Vector3.new(s*12,2,z)) end
        for _,x in {-26,26} do part('RoomWall',Vector3.new(16,4,1),Vector3.new(x,2,0)) end
    end
    for _,x in {-25,0,25} do for _,z in {-18,18} do
        part('Rug',Vector3.new(10,0.15,9),Vector3.new(x,0.65,z),Color3.fromRGB(87,42,95))
        local candle=part('Lantern',Vector3.new(0.5,2,0.5),Vector3.new(x+5,1.7,z),Color3.fromRGB(255,184,87))
        candle.Material=Enum.Material.Neon
        local light=Instance.new('PointLight'); light.Color=candle.Color; light.Range=16; light.Parent=candle
    end end
    local hunters={}
    for i,id in p.Placed do
        local pos=center+Vector3.new((i%5-2)*5,3,((math.floor(i/5))%4-2)*5)
        local ghost=V.ghost(id,m,CFrame.new(pos),0.65,false)
        table.insert(hunters,{Model=ghost,Pos=pos,Phase=i*1.7})
    end
    local preyId=Rules.roll(p.Floor,rng:NextNumber())
    local prey=V.ghost(preyId,m,CFrame.new(center+Vector3.new(22,3,-17)),0.55,true)
    Chamber.Sessions[player]={Model=m,Center=center,Hunters=hunters,Prey=prey,PreyId=preyId,Start=os.clock(),NextReward=os.clock()+C.ChamberInterval,LastStep=os.clock()}
    player:SetAttribute('Chamber',true)
    local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
    if root then player.Character:PivotTo(CFrame.new(center+Vector3.new(0,4,23))) end
    local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
    if hum then hum.WalkSpeed=0; hum.AutoRotate=false end
    remote:FireClient(player,'ChamberEnter',{Center=center,Hunters=#hunters})
    return true
end
function Chamber.start(w,p,r,callback)
    world=w; profiles=p; remote=r; changed=callback
    task.spawn(function()
        while task.wait(0.2) do
            local now=os.clock()
            for player,s in Chamber.Sessions do
                local data=profiles.get(player)
                if not data then continue end
                local phase=(now-s.Start)%C.ChamberInterval
                local hunting=phase&gt;C.ChamberInterval-8
                local target=s.Prey:GetPivot().Position
                for _,h in s.Hunters do
                    local goal=if hunting then target else s.Center+Vector3.new(math.sin(now*0.22+h.Phase)*26,3,math.cos(now*0.18+h.Phase)*19)
                    local delta=goal-h.Pos
                    if delta.Magnitude&gt;0.25 then h.Pos+=delta.Unit*math.min(delta.Magnitude,1.3) end
                    h.Model:PivotTo(CFrame.new(h.Pos))
                end
                if now&gt;=s.NextReward then
                    s.NextReward=now+C.ChamberInterval
                    if Rules.chamberReward(data,s.PreyId) then
                        data.Money=math.min(1e15,data.Money+Rules.income(data)*5)
                        remote:FireClient(player,'ChamberFound',{Species=s.PreyId})
                        changed(player)
                    end
                    s.Prey:Destroy()
                    s.PreyId=Rules.roll(data.Floor,rng:NextNumber())
                    s.Prey=V.ghost(s.PreyId,s.Model,CFrame.new(s.Center+Vector3.new(rng:NextNumber(-27,27),3,rng:NextNumber(-19,19))),0.55,true)
                end
            end
        end
    end)
end
return Chamber
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXaa592f87e20e97c9c9047d447c22bbbc2dd3703c">
        <Properties>
          <string name="Name">Hunting</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local Http=game:GetService('HttpService')
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local C=require(Shared.Config)
local Rules=require(Shared.Rules)
local V=require(Shared.Visuals)
local H={Ghosts={},Active={},LastClick={}}
local rng=Random.new()
local world,profiles,remote,onChanged
local function character(player)
    local char=player.Character
    local root=char and char:FindFirstChild('HumanoidRootPart')
    local humanoid=char and char:FindFirstChildOfClass('Humanoid')
    return if root and humanoid and humanoid.Health&gt;0 then root else nil
end
local function equipped(player)
    return player.Character and player.Character:FindFirstChild('Spectral Vacuum')
end
function H.cancel(player,message)
    local g=H.Active[player]
    if g then
        g.Owner=nil; g.Progress=0; g.Model:SetAttribute('Hunter',nil)
        H.Active[player]=nil
        remote:FireAllClients('BeamOff',{UserId=player.UserId})
        remote:FireClient(player,'CaptureEnd',message or 'Ghost escaped! Stay close and keep clicking.')
    end
end
local function spawnGhost(floor)
    local area=world.Areas[floor]
    local species=Rules.roll(floor,rng:NextNumber())
    local pos=area.Center+Vector3.new(rng:NextNumber(-46,46),4,rng:NextNumber(-32,24))
    local id=Http:GenerateGUID(false)
    local model=V.ghost(species,world.GhostFolder,CFrame.new(pos),1,true)
    model.Name='Ghost_'..id; model:SetAttribute('GhostId',id); model:SetAttribute('Floor',floor)
    local g={Id=id,Species=species,Floor=floor,Model=model,Pos=pos,Target=pos,Progress=0,NextMove=0,Seed=rng:NextNumber(0,20)}
    H.Ghosts[id]=g
    return g
end
function H.click(player,id)
    if type(id)~='string' or #id&gt;60 then return end
    local now=os.clock()
    if now-(H.LastClick[player] or 0)&lt;C.Capture.ClickInterval then return end
    H.LastClick[player]=now
    local p=profiles.get(player)
    local root=character(player)
    if not p or not root or not equipped(player) or player:GetAttribute('Chamber') then return end
    local g=H.Ghosts[id]
    if not g or g.Finishing or (g.Owner and g.Owner~=player) or g.Floor&gt;p.Floor or player:GetAttribute('Floor')~=g.Floor then return end
    if #p.Bag&gt;=Rules.capacity(p) then remote:FireClient(player,'Notice','VACUUM FULL • Return to your Haunt to deposit.'); return end
    if H.Active[player] and H.Active[player]~=g then return end
    local range=if g.Owner then C.Capture.BreakRange else C.Capture.Range+p.Upgrades.Suction
    if (root.Position-g.Pos).Magnitude&gt;range then return end
    if not g.Owner then
        local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={player.Character,world.GhostFolder}
        local hit=workspace:Raycast(root.Position,g.Pos-root.Position,params)
        if hit then return end
        g.Owner=player; g.Progress=0; g.Start=now; H.Active[player]=g
        g.Model:SetAttribute('Hunter',player.UserId)
        remote:FireAllClients('BeamOn',{UserId=player.UserId,Id=g.Id})
    end
                        g.LastClick=now
    g.Progress=Rules.capture(g.Progress,1,p.Upgrades.Capture,C.Ghosts[g.Species].Difficulty,0)
end
local function finish(player,g,p)
    g.Finishing=true
    if not Rules.captureReward(p,g.Species) then g.Finishing=false; H.cancel(player,'Vacuum full.'); return end
    -- Award once on the server. The visual finale cannot grant or repeat a reward.
    H.Active[player]=nil; H.Ghosts[g.Id]=nil
    remote:FireAllClients('Captured',{UserId=player.UserId,Id=g.Id,Species=g.Species})
    onChanged(player)
    task.delay(0.8,function() g.Model:Destroy() end)
    task.delay(4,function() spawnGhost(g.Floor) end)
end
function H.start(w,p,r,changed)
    world=w; profiles=p; remote=r; onChanged=changed
    world.GhostFolder=Instance.new('Folder'); world.GhostFolder.Name='WildGhosts'; world.GhostFolder.Parent=world.Root
    for floor=1,6 do for _=1,7 do spawnGhost(floor) end end
    task.spawn(function()
        while task.wait(C.Capture.Tick) do
            local now=os.clock()
            for _,g in H.Ghosts do
                local area=world.Areas[g.Floor]
                local old=g.Pos
                if g.Owner then
                    local player=g.Owner
                    local data=profiles.get(player)
                    local root=character(player)
                    if not root or not data or not equipped(player) or player:GetAttribute('Floor')~=g.Floor or (root.Position-g.Pos).Magnitude&gt;C.Capture.BreakRange or now-g.LastClick&gt;C.Capture.IdleTimeout then
                        H.cancel(player)
                    else
                        if g.Progress&gt;=1 then finish(player,g,data); continue end
                        g.Progress=Rules.capture(g.Progress,0,data.Upgrades.Capture,C.Ghosts[g.Species].Difficulty,C.Capture.Tick)
                        if now-(g.LastAttack or 0)&gt;=C.Capture.AttackInterval and (root.Position-g.Pos).Magnitude&lt;=C.Capture.AttackRange then
                            g.LastAttack=now
                            local humanoid=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
                            if humanoid and not player:GetAttribute('TestInvulnerable') then humanoid:TakeDamage(C.Capture.AttackDamage*10) end
                            g.Progress=math.max(0,g.Progress-C.Capture.AttackDamage*0.08)
                            remote:FireClient(player,'GhostAttack',{Species=g.Species})
                        end
                        local away=g.Pos-root.Position
                        away=Vector3.new(away.X,0,away.Z)
                        if away.Magnitude&lt;0.1 then away=Vector3.new(0,0,-1) end
                        away=away.Unit
                        local surge=math.sin((now-g.Start)*2.7+g.Seed)&gt;0.55
                        local speed=if surge then 9+C.Ghosts[g.Species].Rarity else -2-data.Upgrades.Suction*0.65-g.Progress*5
                        local side=Vector3.new(-away.Z,0,away.X)*math.sin(now*5+g.Seed)*4
                        g.Pos+= (away*speed+side)*C.Capture.Tick
                        local relative=g.Pos-area.Center
                        g.Pos=area.Center+Vector3.new(math.clamp(relative.X,-51,51),4+math.sin(now*7)*0.35,math.clamp(relative.Z,-40,36))
                        remote:FireClient(player,'CaptureProgress',{Progress=g.Progress,Species=g.Species,Surge=surge})
                    end
                else
                    if now&gt;g.NextMove then
                        g.NextMove=now+rng:NextNumber(2,5)
                        g.Target=area.Center+Vector3.new(rng:NextNumber(-48,48),4,rng:NextNumber(-37,28))
                        for _,player in Players:GetPlayers() do
                            local root=character(player)
                            if root and player:GetAttribute('Floor')==g.Floor and (root.Position-g.Pos).Magnitude&lt;12 then
                                local delta=g.Pos-root.Position
                                if delta.Magnitude&gt;0.1 then g.Target=g.Pos+delta.Unit*15 end
                                break
                            end
                        end
                    end
                    local delta=g.Target-g.Pos
                    if delta.Magnitude&gt;0.4 then g.Pos+=delta.Unit*math.min(delta.Magnitude,0.38) end
                    local rel=g.Pos-area.Center
                    g.Pos=area.Center+Vector3.new(math.clamp(rel.X,-51,51),4+math.sin(now*2+g.Seed)*0.5,math.clamp(rel.Z,-40,37))
                end
                if g.Model.Parent then
                    local direction=if g.Owner and character(g.Owner) then character(g.Owner).Position else g.Pos+(g.Pos-old)
                    direction=Vector3.new(direction.X,g.Pos.Y,direction.Z)
                    g.Model:PivotTo(if (direction-g.Pos).Magnitude&gt;0.05 then CFrame.lookAt(g.Pos,direction) else CFrame.new(g.Pos))
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(player) H.cancel(player); H.LastClick[player]=nil end)
end
return H
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBXa929422d9e9636f57e5b0793fa5e2136648632e7">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local Shared=ReplicatedStorage:WaitForChild('Ghostlight')
local C=require(Shared.Config)
local Rules=require(Shared.Rules)
local V=require(Shared.Visuals)
local Profiles=require(script.Parent.Profiles)
local World=require(script.Parent.World)
local Hunt=require(script.Parent.Hunting)
local Chamber=require(script.Parent.Chamber)
local remote=Instance.new('RemoteEvent'); remote.Name='Action'; remote.Parent=Shared
local plots={}
local lastRequest={}
local closing=false
World.build()
local function notice(player,text) remote:FireClient(player,'Notice',text) end
local function push(player)
    local p=Profiles.get(player)
    if not p then return end
    remote:FireClient(player,'State',{Profile=p,Income=Rules.income(p),Plot=plots[player],Practice=Profiles.Memory})
end
local function refreshPlot(player)
    local p=Profiles.get(player)
    local plot=plots[player] and World.Plots[plots[player]]
    if not p or not plot then return end
    for _,m in plot.Displays do m:Destroy() end
    table.clear(plot.Displays)
    local rarest='None yet'; local rarity=0; local discovered=0
    for id in p.Discovered do discovered+=1; if C.Ghosts[id].Rarity&gt;rarity then rarest=C.Ghosts[id].Name; rarity=C.Ghosts[id].Rarity end end
    plot.Label.Text=player.DisplayName.."'s HAUNT • LV "..p.HauntLevel..'\nGhosts '..#p.Placed..'/'..C.Slots[p.HauntLevel]..' • $'..Rules.income(p)..'/SEC\nRebirths '..p.Rebirths..' • Collection '..discovered..'/14\nRarest: '..rarest
    plot.IncomeLabel.Text='$/SEC • $'..Rules.income(p)..'\n'..#p.Placed..' active haunt ghosts'
    for i,pad in plot.Slots do
        pad.Transparency=if i&lt;=C.Slots[p.HauntLevel] then 0 else 0.8
        pad.Color=if i&lt;=C.Slots[p.HauntLevel] then Color3.fromRGB(105,66,146) else Color3.fromRGB(35,30,46)
        if p.Placed[i] then
            local m=V.ghost(p.Placed[i],plot.Model,pad.CFrame*CFrame.new(0,2.3,0),0.65,true)
            table.insert(plot.Displays,m)
        end
    end
    local existing=plot.Model:FindFirstChild('UpgradeDecor')
    if existing then existing:Destroy() end
    local decor=Instance.new('Folder'); decor.Name='UpgradeDecor'; decor.Parent=plot.Model
    for i=2,p.HauntLevel do
        for _,s in {-1,1} do
            local offset=if plot.SpireOffset then plot.SpireOffset(s,i) else CFrame.new(s*(20+i),4+i,-10+i*5)
            local pillar=V.part(decor,'EstateSpire',Vector3.new(1.2,3+i,1.2),plot.CF*offset,V.color(i),Enum.Material.Neon)
            local l=Instance.new('PointLight'); l.Color=pillar.Color; l.Range=8; l.Brightness=0.3; l.Parent=pillar
        end
    end
end
local function stats(player)
    local p=Profiles.get(player)
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    if not p or not hum then return end
    hum.WalkSpeed=if player:GetAttribute('Chamber') then 0 else 22+(p.Upgrades.Movement-1)*2
    for _,container in {char,player:FindFirstChildOfClass('Backpack')} do
        if container then
            local tool=container:FindFirstChild('Spectral Vacuum')
            if tool then
                local light=tool:FindFirstChild('Lamp',true)
                if light then light.Range=35+p.Upgrades.Flashlight*10; light.Brightness=2+p.Upgrades.Flashlight*0.5 end
            end
        end
    end
end
local function rootOf(player)
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    return if hum and hum.Health&gt;0 then char:FindFirstChild('HumanoidRootPart') else nil
end
local function near(player,part)
    local root=rootOf(player)
    return root and (root.Position-part.Position).Magnitude&lt;=15
end
local function home(player)
    local plot=plots[player] and World.Plots[plots[player]]
    if not plot or not rootOf(player) then return end
    Hunt.cancel(player,'')
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',0)
    player.Character:PivotTo(plot.CF*CFrame.new(0,4,-22))
    stats(player); push(player)
end
local function atHome(player)
    local plot=plots[player] and World.Plots[plots[player]]
    local root=rootOf(player)
    return plot and root and not player:GetAttribute('Chamber') and (root.Position-plot.CF.Position).Magnitude&lt;45
end
local function deposit(player)
    local p=Profiles.get(player)
    if not p or not atHome(player) then return end
    local n=#p.Bag; Rules.deposit(p)
    -- Fill free slots for a smooth first loop; players can replace any slot in the Haunt panel.
    local ids={}
    for id in p.Owned do table.insert(ids,id) end
    table.sort(ids,function(a,b) return C.Ghosts[a].Income&gt;C.Ghosts[b].Income end)
    for _,id in ids do while Rules.place(p,id) do end end
    refreshPlot(player); push(player)
    notice(player,if n&gt;0 then n..' ghosts deposited! Free slots filled. Your Haunt is earning dollars.' else 'Inventory ready. Manage your ghost slots in HAUNT.')
end
local function enterFloor(player,floor)
    local p=Profiles.get(player)
    if not p or type(floor)~='number' or floor~=math.floor(floor) or not World.Areas[floor] or floor&gt;p.Floor or not rootOf(player) then return end
    Hunt.cancel(player,'')
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',floor)
    player.Character:PivotTo(CFrame.new(World.Areas[floor].Entry))
    stats(player); push(player)
    notice(player,'Aim at a ghost and click repeatedly. Chase it when it pulls away!')
end
Hunt.start(World,Profiles,remote,push)
Chamber.start(World,Profiles,remote,push)
Profiles.start()
for i,plot in World.Plots do
    World.prompt(plot.Deposit,'Deposit ghosts','Your Haunt',function(player)
        if plot.Owner==player and near(player,plot.Deposit) then deposit(player) end
    end)
end
World.ChamberPortalPrompt.Triggered:Connect(function(player)
    if near(player,World.ChamberPortal) and (player:GetAttribute('Floor') or 0)==0 and not player:GetAttribute('Chamber') then Hunt.cancel(player,''); Chamber.enter(player,plots[player]); push(player) end
end)
for _,area in World.Areas do World.prompt(area.Exit,'Return home','Deposit captured ghosts',function(player) if near(player,area.Exit) then home(player) end end) end
World.prompt(World.MansionDoor,'Choose mansion area','Haunted Mansion',function(player) if near(player,World.MansionDoor) then remote:FireClient(player,'Open','Mansion') end end)
World.prompt(World.Upgrades,'Browse upgrades','Workshop',function(player) if near(player,World.Upgrades) then remote:FireClient(player,'Open','Upgrades') end end)
World.RebirthAltarPrompt.Triggered:Connect(function(player) if near(player,World.RebirthAltar) then remote:FireClient(player,'Open','Rebirth') end end)
remote.OnServerEvent:Connect(function(player,action,arg)
    if type(action)~='string' or #action&gt;24 then return end
    if action=='Click' then Hunt.click(player,arg); return end
    local now=os.clock()
    if now-(lastRequest[player] or 0)&lt;0.15 then return end
    lastRequest[player]=now
    local p=Profiles.get(player)
    if not p then return end
    if action=='Sync' then push(player)
    elseif action=='Home' then home(player)
    elseif action=='EnterFloor' then enterFloor(player,arg)
    elseif action=='Deposit' then deposit(player)
    elseif action=='Place' then
        if type(arg)=='string' and #arg&lt;50 and atHome(player) and Rules.place(p,arg) then refreshPlot(player); push(player) else notice(player,'Return home, deposit your ghosts, and check for a free slot.') end
    elseif action=='Remove' then
        if atHome(player) and Rules.remove(p,arg) then refreshPlot(player); push(player) end
    elseif action=='Upgrade' then
        if type(arg)=='string' and #arg&lt;30 and Rules.upgrade(p,arg) then stats(player); refreshPlot(player); push(player); notice(player,arg..' upgraded!') else notice(player,'Upgrade unavailable or not enough dollars.') end
    elseif action=='Unlock' then
        if Rules.unlock(p,arg) then push(player); notice(player,'New mansion area unlocked!') else notice(player,'Unlock areas in order and earn enough dollars.') end
    elseif action=='Rebirth' then
        if Rules.rebirth(p) then home(player); refreshPlot(player); stats(player); push(player); notice(player,'REBORN! Permanent income multiplier: '..Rules.multiplier(p)..'x') else notice(player,'Unlock all six areas and meet the dollar requirement first.') end
    elseif action=='Chamber' then
        if atHome(player) then Hunt.cancel(player,''); Chamber.enter(player,plots[player]); push(player) else notice(player,'Return to your Haunt to enter the chamber.') end
    elseif action=='ExitChamber' then home(player)
    elseif action=='Cancel' then Hunt.cancel(player,'Capture released.')
    elseif action=='Flashlight' then
        local tool=player.Character and player.Character:FindFirstChild('Spectral Vacuum')
        local light=tool and tool:FindFirstChild('Lamp',true)
        if light then light.Enabled=not light.Enabled end
    end
end)
local function characterAdded(player,char)
    char:WaitForChild('HumanoidRootPart',10)
    local humanoid=char:WaitForChild('Humanoid',10)
    if not humanoid or not Profiles.get(player) then return end
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',0)
    local backpack=player:WaitForChild('Backpack')
    if not backpack:FindFirstChild('Spectral Vacuum') and not char:FindFirstChild('Spectral Vacuum') then
        local tool=V.vacuum(); tool.Parent=backpack; humanoid:EquipTool(tool)
        tool.Unequipped:Connect(function()
            task.defer(function()
                if tool.Parent==backpack and humanoid.Health&gt;0 and player.Character==char then humanoid:EquipTool(tool) end
            end)
        end)
    end
    stats(player); push(player)
    humanoid.Died:Connect(function()
        Hunt.cancel(player,'')
        if player:GetAttribute('Chamber') then Chamber.leave(player) end
        player:SetAttribute('Floor',0)
    end)
end
local function joined(player)
    if closing then player:Kick('Server restarting. Please rejoin.'); return end
    local index
    for i,plot in World.Plots do if not plot.Owner then index=i; plot.Owner=player; plots[player]=i; break end end
    if not index then player:Kick('All seven Haunts are occupied. Please join another server.'); return end
    local data=Profiles.load(player)
    if not data or not player.Parent then
        if World.Plots[index].Owner==player then World.Plots[index].Owner=nil end
        local session=Profiles.Sessions[player]
        if session then session.Closing=true; Profiles.save(player,true); Profiles.Sessions[player]=nil end
        plots[player]=nil
        return
    end
    local leaderstats=Instance.new('Folder'); leaderstats.Name='leaderstats'; leaderstats.Parent=player
    for _,name in {'Dollars','Rebirths','Income'} do local v=Instance.new('NumberValue'); v.Name=name; v.Parent=leaderstats end
    refreshPlot(player)
    player.CharacterAdded:Connect(function(char) characterAdded(player,char) end)
    if player.Character then task.spawn(characterAdded,player,player.Character) end
    push(player)
end
Players.PlayerAdded:Connect(joined)
for _,player in Players:GetPlayers() do task.spawn(joined,player) end
Players.PlayerRemoving:Connect(function(player)
    Hunt.cancel(player,'')
    if Chamber.Sessions[player] then Chamber.leave(player) end
    local s=Profiles.Sessions[player]
    if s then s.Closing=true; Profiles.save(player,true); Profiles.Sessions[player]=nil end
    local plot=plots[player] and World.Plots[plots[player]]
    if plot then
        plot.Owner=nil; plot.Label.Text='UNCLAIMED HAUNT'
        for _,m in plot.Displays do m:Destroy() end
        table.clear(plot.Displays)
    end
    plots[player]=nil; lastRequest[player]=nil
end)
task.spawn(function()
    while task.wait(1) do
        local ranking={}
        for _,player in Players:GetPlayers() do
            local p=Profiles.get(player)
            if not p then continue end
            p.Money=math.min(1e15,p.Money+Rules.income(p))
            local ls=player:FindFirstChild('leaderstats')
            if ls then ls.Dollars.Value=math.floor(p.Money); ls.Income.Value=Rules.income(p); ls.Rebirths.Value=p.Rebirths end
            local ownedPlot=plots[player] and World.Plots[plots[player]]
            if ownedPlot then ownedPlot.IncomeLabel.Text='$/SEC • $'..Rules.income(p)..'\n'..#p.Placed..' active haunt ghosts' end
            local root=rootOf(player)
            local floor=player:GetAttribute('Floor') or 0
            if root and not player:GetAttribute('Chamber') then
                if floor&gt;0 and World.Areas[floor] then
                    local rel=root.Position-World.Areas[floor].Center
                    if math.abs(rel.X)&gt;58 or math.abs(rel.Z)&gt;48 or rel.Y&lt; -10 then enterFloor(player,floor) end
                elseif root.Position.Y&lt; -15 or root.Position.Z&lt; -245 or math.abs(root.Position.X)&gt;215 then home(player) end
            end
            push(player)
            table.insert(ranking,{Name=player.DisplayName,Income=Rules.income(p)})
        end
        table.sort(ranking,function(a,b) return a.Income&gt;b.Income end)
        local lines={'HOLLOW HUNTERS • THIS SERVER'}
        for i=1,math.min(8,#ranking) do table.insert(lines,i..'. '..ranking[i].Name..' • $'..ranking[i].Income..'/sec') end
        World.Leaderboard.Label.TextLabel.Text=table.concat(lines,'\n')
    end
end)
game:BindToClose(function()
    closing=true
    local remaining=0
    for player,s in Profiles.Sessions do
        s.Closing=true; remaining+=1
        task.spawn(function() Profiles.save(player,true); remaining-=1 end)
    end
    local deadline=os.clock()+25
    while remaining&gt;0 and os.clock()&lt;deadline do task.wait(0.1) end
end)
print('Ghostlight Hollow server ready: seven Haunts, six mansion areas, fourteen ghosts.')
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
