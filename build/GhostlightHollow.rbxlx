      <Item class="ModuleScript" referent="RBXb81897324ac738e5a8cc7b8c2c412b47c6b2fa74">
        <Properties>
          <string name="Name">LabelVisibility</string>
          <ProtectedString name="Source">-- Client-only proximity and screen-overlap filtering. Text remains server-owned.
local Labels={}
function Labels.start(player,focus)
    local labels={}
    local function register(item)
        if item:IsA('BillboardGui') and item:GetAttribute('ContextLabel') then labels[item]=true end
    end
    for _,item in workspace:GetDescendants() do register(item) end
    workspace.DescendantAdded:Connect(register)
    workspace.DescendantRemoving:Connect(function(item) labels[item]=nil end)
    local elapsed=0
    game:GetService('RunService').Heartbeat:Connect(function(dt)
        elapsed+=dt
        if elapsed&lt;.12 then return end
        elapsed=0
        local camera=workspace.CurrentCamera
        local character=player.Character
        local root=character and character:FindFirstChild('HumanoidRootPart')
        if not camera or not root then return end
        local target=focus()
        local candidates={}
        for gui in labels do
            gui.Enabled=false
            local anchor=gui.Adornee or gui.Parent
            if not anchor:IsA('BasePart') then continue end
            local distance=(root.Position-anchor.Position).Magnitude
            if distance&gt;(gui:GetAttribute('ReadDistance') or 42) then continue end
            local isGhost=gui:GetAttribute('GhostLabel')
            if isGhost and (not target or not gui:IsDescendantOf(target)) then continue end
            local point,visible=camera:WorldToViewportPoint(anchor.Position+gui.StudsOffset+gui.StudsOffsetWorldSpace)
            if not visible then continue end
            local w,h=gui.Size.X.Offset,gui.Size.Y.Offset
            local rect={x=point.X-w/2-8,y=point.Y-h/2-6,w=w+16,h=h+12}
            table.insert(candidates,{gui=gui,rect=rect,score=distance-(isGhost and 1000 or 0)})
        end
        table.sort(candidates,function(a,b) return a.score&lt;b.score end)
        local shown={}
        for _,candidate in candidates do
            local r=candidate.rect
            local clear=true
            for _,other in shown do
                if r.x&lt;other.x+other.w and r.x+r.w&gt;other.x and r.y&lt;other.y+other.h and r.y+r.h&gt;other.y then clear=false; break end
            end
            if clear then
                candidate.gui.Enabled=true; table.insert(shown,r)
                if #shown&gt;=4 then break end
            end
        end
    end)
end
return Labels
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXb8e3572f0a16dbe555b4b4cb8e847a59f9ea87e5">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">local Config = if script then require(script.Parent.Config) else require('./Config')
local R = {}
local function integer(v, lo, hi, fallback)
    if type(v) ~= 'number' or v ~= v or math.abs(v) == math.huge then return fallback end
    return math.clamp(math.floor(v), lo, hi)
end
function R.newProfile()
    return {Version=1,Money=0,Owned={},Discovered={},Bag={},Placed={},HauntLevel=1,Floor=1,Rebirths=0,
        Upgrades={Suction=1,Capture=1,Capacity=1,Movement=1,Flashlight=1},Captures=0,ChamberDiscoveries=0}
end
function R.reconcile(raw)
    local p = R.newProfile()
    if type(raw) ~= 'table' then return p end
    p.Money = integer(raw.Money,0,1e15,0)
    p.HauntLevel = integer(raw.HauntLevel,1,5,1)
    p.Floor = integer(raw.Floor,1,6,1)
    p.Rebirths = integer(raw.Rebirths,0,10000,0)
    p.Captures = integer(raw.Captures,0,1e12,0)
    p.ChamberDiscoveries = integer(raw.ChamberDiscoveries,0,1e12,0)
    for name in p.Upgrades do
        p.Upgrades[name] = integer(type(raw.Upgrades)=='table' and raw.Upgrades[name],1,6,1)
    end
    for id in Config.Ghosts do
        local qty = integer(type(raw.Owned)=='table' and raw.Owned[id],0,1e9,0)
        if qty &gt; 0 then p.Owned[id] = qty end
        if qty &gt; 0 or (type(raw.Discovered)=='table' and raw.Discovered[id] == true) then p.Discovered[id] = true end
    end
    local used = {}
    for _, field in {'Bag','Placed'} do
        if type(raw[field]) == 'table' then
            local limit = if field=='Bag' then R.capacity(p) else Config.Slots[p.HauntLevel]
            for _, id in raw[field] do
                if type(id)=='string' and Config.Ghosts[id] and #p[field]&lt;limit and (used[id] or 0)&lt;(p.Owned[id] or 0) then
                    table.insert(p[field],id)
                    used[id]=(used[id] or 0)+1
                end
            end
        end
    end
    return p
end
function R.capacity(p) return Config.Capacity[p.Upgrades.Capacity] end
function R.multiplier(p) return 1+p.Rebirths*0.5 end
function R.income(p)
    local sum=0
    for _, id in p.Placed do sum += Config.Ghosts[id].Income end
    return sum * R.multiplier(p)
end
function R.capture(progress, clicks, power, difficulty, dt)
    return math.clamp(progress + clicks*(0.085+0.025*(power-1))/difficulty - dt*0.028*difficulty,0,1)
end
function R.captureReward(p,id)
    if not Config.Ghosts[id] or #p.Bag&gt;=R.capacity(p) then return false end
    p.Owned[id]=(p.Owned[id] or 0)+1
    p.Discovered[id]=true
    p.Captures+=1
    table.insert(p.Bag,id)
    return true
end
function R.chamberReward(p,id)
    if #p.Placed==0 or not Config.Ghosts[id] or not table.find(Config.Ghosts[id].Areas,p.Floor) then return false end
    p.Owned[id]=(p.Owned[id] or 0)+1
    p.Discovered[id]=true
    p.ChamberDiscoveries+=1
    return true
end
function R.deposit(p) table.clear(p.Bag) end
function R.available(p,id)
    local n=p.Owned[id] or 0
    for _, v in p.Placed do if v==id then n-=1 end end
    for _, v in p.Bag do if v==id then n-=1 end end
    return n
end
function R.place(p,id)
    if not Config.Ghosts[id] or #p.Placed&gt;=Config.Slots[p.HauntLevel] or R.available(p,id)&lt;=0 then return false end
    table.insert(p.Placed,id)
    return true
end
function R.remove(p,index)
    if type(index)~='number' or index~=math.floor(index) or index&lt;1 or index&gt;#p.Placed then return false end
    table.remove(p.Placed,index)
    return true
end
function R.upgradeCost(p,name)
    if name=='Haunt' then return Config.HauntCosts[p.HauntLevel+1] end
    if not Config.UpgradeBase[name] or p.Upgrades[name]&gt;=Config.MaxUpgrade then return nil end
    return math.floor(Config.UpgradeBase[name]*4^(p.Upgrades[name]-1))
end
function R.upgrade(p,name)
    local cost=R.upgradeCost(p,name)
    if not cost or p.Money&lt;cost then return false end
    p.Money-=cost
    if name=='Haunt' then p.HauntLevel+=1 else p.Upgrades[name]+=1 end
    return true
end
function R.unlock(p,floor)
    if type(floor)~='number' or floor~=p.Floor+1 or not Config.Floors[floor] then return false end
    local cost=Config.Floors[floor].Cost
    if p.Money&lt;cost then return false end
    p.Money-=cost
    p.Floor=floor
    return true
end
function R.rebirthCost(p) return 5000000000*(1+p.Rebirths) end
function R.rebirth(p)
    if p.Floor&lt;6 or p.Money&lt;R.rebirthCost(p) then return false end
    p.Money=0
    p.Floor=1
    p.HauntLevel=1
    p.Rebirths+=1
    table.clear(p.Bag)
    table.clear(p.Placed)
    for name in p.Upgrades do p.Upgrades[name]=1 end
    return true
end
function R.pool(floor)
    local result={}
    for id,g in Config.Ghosts do if table.find(g.Areas,floor) then table.insert(result,id) end end
    table.sort(result)
    return result
end
function R.roll(floor,unit)
    local pool=R.pool(floor)
    local total=0
    for _,id in pool do total+=Config.Ghosts[id].Weight end
    local pick=unit*total
    for _,id in pool do pick-=Config.Ghosts[id].Weight; if pick&lt;=0 then return id end end
    return pool[#pool]
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX53e5437058e737ddc308908f6c65439a52902cac">
        <Properties>
          <string name="Name">Visuals</string>
          <ProtectedString name="Source">local Config=require(script.Parent.Config)
local V={}
function V.color(rarity) return Color3.fromRGB(table.unpack(Config.Colors[rarity])) end
function V.part(parent,name,size,cf,color,material)
    local p=Instance.new('Part')
    p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic
    p.Anchored=true; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
function V.label(part,text,color,width,height)
    local gui=Instance.new('BillboardGui')
    gui.Name='Label'; gui.Size=UDim2.fromOffset(math.min(width or 210,230),math.min(height or 48,64))
    gui.StudsOffset=Vector3.new(0,3,0); gui.MaxDistance=180; gui.AlwaysOnTop=false
    gui:SetAttribute('ContextLabel',true); gui:SetAttribute('ReadDistance',42)
    gui.Enabled=false; gui.Parent=part
    local label=Instance.new('TextLabel')
    label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.Text=text
    label.TextColor3=color or Color3.new(1,1,1); label.TextStrokeTransparency=0.75
    label.Font=Enum.Font.GothamMedium; label.TextSize=14; label.TextWrapped=true; label.Parent=gui
    return label
end
function V.ghost(id,parent,cf,scale,withLabel)
    local g=Config.Ghosts[id]
    local m=Instance.new('Model'); m.Name=g.Name; m:SetAttribute('Species',id)
    local c=V.color(g.Rarity)
    local root=if g.Shape=='ReferenceGhost' then require(script.Parent.GhostModels).build(m)
        else require(script.Parent.GhostStyle).build(m,g,c)
    m.Parent=parent; m:ScaleTo(scale or 1); m:PivotTo(cf)
    if withLabel then
        local label=V.label(root,g.Name..'\n'..Config.Rarities[g.Rarity],c,180,42)
        label.Parent:SetAttribute('GhostLabel',true)
        label.Parent.StudsOffset=Vector3.new(0,m:GetExtentsSize().Y*.5+.8,0)
    end
    return m
end
function V.vacuum()
    local t=Instance.new('Tool'); t.Name='Spectral Vacuum'; t.RequiresHandle=true; t.CanBeDropped=false
    t.Grip=CFrame.new(0,-0.3,0.5)*CFrame.Angles(0,0,0)
    local handle=V.part(t,'Handle',Vector3.new(0.65,1,0.65),CFrame.new(),Color3.fromRGB(43,39,57))
    local function attach(name,size,position,color,material)
        local p=V.part(t,name,size,CFrame.new(position),color,material)
        local w=Instance.new('WeldConstraint'); w.Part0=handle; w.Part1=p; w.Parent=p
        return p
    end
    attach('Body',Vector3.new(1.4,1.4,2.3),Vector3.new(0,0.6,-0.4),Color3.fromRGB(78,63,105),Enum.Material.Metal)
    local tank=attach('CaptureContainer',Vector3.new(1,1.6,1),Vector3.new(0,1.4,0.2),Color3.fromRGB(108,245,225),Enum.Material.Neon)
    tank.Transparency=0.35
    attach('Hose',Vector3.new(0.55,0.55,2),Vector3.new(0,0.6,-2),Color3.fromRGB(30,28,40))
    local nozzle=attach('Nozzle',Vector3.new(1,0.85,0.6),Vector3.new(0,0.6,-3),Color3.fromRGB(174,154,220),Enum.Material.Metal)
    local a=Instance.new('Attachment'); a.Name='Suction'; a.Position=Vector3.new(0,0,-0.35); a.Parent=nozzle
    local lens=attach('Flashlight',Vector3.new(0.45,0.45,0.3),Vector3.new(0.7,0.8,-1.5),Color3.fromRGB(255,236,178),Enum.Material.Neon)
    local light=Instance.new('SpotLight'); light.Name='Lamp'; light.Face=Enum.NormalId.Front; light.Angle=65; light.Range=40; light.Brightness=3; light.Shadows=true; light.Parent=lens
    for _,p in t:GetDescendants() do if p:IsA('BasePart') then p.Anchored=false; p.CanCollide=false; p.Massless=true end end
    return t
end
return V
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX15343b82a4c762836f7b982e03f4abaa9d4afa85">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX9a8fa37bb0b85f588cf6f9888edec67b45975d98">
      <Properties>
        <string name="Name">GhostlightServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXaa7da4f6cc206ce3b8a5684ff2bfd2ffa2185da4">
        <Properties>
          <string name="Name">Chamber</string>
          <ProtectedString name="Source">local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local V=require(Shared.Visuals)
local Rules=require(Shared.Rules)
local C=require(Shared.Config)
local Chamber={Sessions={}}
local rng=Random.new()
local world,profiles,remote,changed
function Chamber.leave(player)
    local s=Chamber.Sessions[player]
    if s then s.Model:Destroy(); Chamber.Sessions[player]=nil end
    player:SetAttribute('Chamber',false)
    local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
    if hum then hum.AutoRotate=true end
    remote:FireClient(player,'ChamberExit')
end
function Chamber.enter(player,plotIndex)
    local p=profiles.get(player)
    if not p or #p.Placed==0 then remote:FireClient(player,'Notice','Place at least one ghost in your Haunt first.'); return false end
    if Chamber.Sessions[player] then return false end
    local center=Vector3.new((plotIndex-1)*130,0,-720)
    local m=Instance.new('Model'); m.Name='Chamber_'..player.UserId; m.Parent=world.Root
    local function part(name,size,pos,color)
        return V.part(m,name,size,CFrame.new(center+pos),color or Color3.fromRGB(62,44,72),Enum.Material.Slate)
    end
    part('MiniatureFloor',Vector3.new(68,1,54),Vector3.new(0,0,0))
    for _,s in {-1,1} do
        part('Wall',Vector3.new(68,4,1),Vector3.new(0,2,s*27))
        part('Wall',Vector3.new(1,4,54),Vector3.new(s*34,2,0))
        for _,z in {-19,19} do part('RoomWall',Vector3.new(1,4,16),Vector3.new(s*12,2,z)) end
        for _,x in {-26,26} do part('RoomWall',Vector3.new(16,4,1),Vector3.new(x,2,0)) end
    end
    for _,x in {-25,0,25} do for _,z in {-18,18} do
        part('Rug',Vector3.new(10,0.15,9),Vector3.new(x,0.65,z),Color3.fromRGB(87,42,95))
        local candle=part('Lantern',Vector3.new(0.5,2,0.5),Vector3.new(x+5,1.7,z),Color3.fromRGB(255,184,87))
        candle.Material=Enum.Material.Neon
        local light=Instance.new('PointLight'); light.Color=candle.Color; light.Range=16; light.Parent=candle
    end end
    local hunters={}
    for i,id in p.Placed do
        local pos=center+Vector3.new((i%5-2)*5,3,((math.floor(i/5))%4-2)*5)
        local ghost=V.ghost(id,m,CFrame.new(pos),0.65,false)
        table.insert(hunters,{Model=ghost,Pos=pos,Phase=i*1.7})
    end
    local preyId=Rules.roll(p.Floor,rng:NextNumber())
    local prey=V.ghost(preyId,m,CFrame.new(center+Vector3.new(22,3,-17)),0.55,true)
    Chamber.Sessions[player]={Model=m,Center=center,Hunters=hunters,Prey=prey,PreyId=preyId,Start=os.clock(),NextReward=os.clock()+C.ChamberInterval,LastStep=os.clock()}
    player:SetAttribute('Chamber',true)
    local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
    if root then player.Character:PivotTo(CFrame.new(center+Vector3.new(0,4,23))) end
    local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
    if hum then hum.WalkSpeed=0; hum.AutoRotate=false end
    remote:FireClient(player,'ChamberEnter',{Center=center,Hunters=#hunters})
    return true
end
function Chamber.start(w,p,r,callback)
    world=w; profiles=p; remote=r; changed=callback
    task.spawn(function()
        while task.wait(0.2) do
            local now=os.clock()
            for player,s in Chamber.Sessions do
                local data=profiles.get(player)
                if not data then continue end
                local phase=(now-s.Start)%C.ChamberInterval
                local hunting=phase&gt;C.ChamberInterval-8
                local target=s.Prey:GetPivot().Position
                for _,h in s.Hunters do
                    local goal=if hunting then target else s.Center+Vector3.new(math.sin(now*0.22+h.Phase)*26,3,math.cos(now*0.18+h.Phase)*19)
                    local delta=goal-h.Pos
                    if delta.Magnitude&gt;0.25 then h.Pos+=delta.Unit*math.min(delta.Magnitude,1.3) end
                    h.Model:PivotTo(CFrame.new(h.Pos))
                end
                if now&gt;=s.NextReward then
                    s.NextReward=now+C.ChamberInterval
                    if Rules.chamberReward(data,s.PreyId) then
                        data.Money=math.min(1e15,data.Money+Rules.income(data)*5)
                        remote:FireClient(player,'ChamberFound',{Species=s.PreyId})
                        changed(player)
                    end
                    s.Prey:Destroy()
                    s.PreyId=Rules.roll(data.Floor,rng:NextNumber())
                    s.Prey=V.ghost(s.PreyId,s.Model,CFrame.new(s.Center+Vector3.new(rng:NextNumber(-27,27),3,rng:NextNumber(-19,19))),0.55,true)
                end
            end
        end
    end)
end
return Chamber
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXaa592f87e20e97c9c9047d447c22bbbc2dd3703c">
        <Properties>
          <string name="Name">Hunting</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local Http=game:GetService('HttpService')
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local C=require(Shared.Config)
local Rules=require(Shared.Rules)
local V=require(Shared.Visuals)
local H={Ghosts={},Active={},LastClick={},NextEncounter={}}
local rng=Random.new()
local world,profiles,remote,onChanged
local function character(player)
    local char=player.Character
    local root=char and char:FindFirstChild('HumanoidRootPart')
    local humanoid=char and char:FindFirstChildOfClass('Humanoid')
    return if root and humanoid and humanoid.Health&gt;0 then root else nil
end
local function equipped(player)
    return player.Character and player.Character:FindFirstChild('Spectral Vacuum')
end
local function releaseEncounter(g)
    if g.FrozenRoot and g.FrozenRoot.Parent then g.FrozenRoot.Anchored=g.WasAnchored end
    g.FrozenRoot=nil; g.IntroUntil=nil; g.Battle=nil; g.Spot=nil; g.NextSpot=nil
end
function H.cancel(player,message)
    local g=H.Active[player]
    if g then
        releaseEncounter(g)
        H.NextEncounter[player]=os.clock()+C.Encounter.Cooldown
        g.Owner=nil; g.Progress=0; g.Model:SetAttribute('Hunter',nil)
        H.Active[player]=nil
        remote:FireAllClients('BeamOff',{UserId=player.UserId})
        remote:FireClient(player,'CaptureEnd',message or 'Ghost escaped! Keep clicking during the encounter.')
    end
end
local function spawnGhost(floor)
    local area=world.Areas[floor]
    local species=Rules.roll(floor,rng:NextNumber())
    local pos=area.Center+Vector3.new(rng:NextNumber(-46,46),4,rng:NextNumber(-32,24))
    local id=Http:GenerateGUID(false)
    local model=V.ghost(species,world.GhostFolder,CFrame.new(pos),1,true)
    model.Name='Ghost_'..id; model:SetAttribute('GhostId',id); model:SetAttribute('Floor',floor)
    local g={Id=id,Species=species,Floor=floor,Model=model,Pos=pos,Target=pos,Progress=0,NextMove=0,Seed=rng:NextNumber(0,20)}
    H.Ghosts[id]=g
    return g
end
function H.click(player,id)
    if type(id)~='string' or #id&gt;60 then return end
    local now=os.clock()
    if now-(H.LastClick[player] or 0)&lt;C.Capture.ClickInterval then return end
    H.LastClick[player]=now
    local p=profiles.get(player)
    local root=character(player)
    if not p or not root or not equipped(player) or player:GetAttribute('Chamber') then return end
    local g=H.Ghosts[id]
    if not g or g.Finishing or (g.Owner and g.Owner~=player) or g.Floor&gt;p.Floor or player:GetAttribute('Floor')~=g.Floor then return end
    if #p.Bag&gt;=Rules.capacity(p) then remote:FireClient(player,'Notice','VACUUM FULL • Return to your Haunt to deposit.'); return end
    if H.Active[player] and H.Active[player]~=g then return end
    if g.IntroUntil then return end
    local range=if g.Owner then C.Capture.BreakRange else C.Capture.Range+p.Upgrades.Suction
    if (root.Position-g.Pos).Magnitude&gt;range then return end
    if not g.Owner then
        if now&lt;(H.NextEncounter[player] or 0) then return end
        local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={player.Character,world.GhostFolder}
        local hit=workspace:Raycast(root.Position,g.Pos-root.Position,params)
        if hit then return end
        g.Owner=player; g.Progress=0; g.Start=now; H.Active[player]=g
        g.Model:SetAttribute('Hunter',player.UserId)
        -- Reserve immediately, but do not attack, decay progress, or start suction under the wipe.
        g.IntroUntil=now+C.Encounter.Duration
        g.FrozenRoot=root; g.WasAnchored=root.Anchored; root.Anchored=true
        remote:FireClient(player,'EncounterStart',{Id=g.Id,Species=g.Species,EndsAt=workspace:GetServerTimeNow()+C.Encounter.Duration})
        return
    end
    g.LastClick=now
    g.LastActivity=now
    g.Progress=Rules.capture(g.Progress,1,p.Upgrades.Capture,C.Ghosts[g.Species].Difficulty,0)
end
local function sendProgress(player,g)
    remote:FireClient(player,'CaptureProgress',{Id=g.Id,Progress=g.Progress,Species=g.Species,Battle=true})
end
local function spawnSpot(player,g,now)
    local spot={Token=Http:GenerateGUID(false),X=rng:NextNumber(0.24,0.76),Y=rng:NextNumber(0.24,0.76),
        EndsAt=workspace:GetServerTimeNow()+C.Battle.SpotDuration}
    g.Spot=spot
    g.NextSpot=now+C.Battle.SpotDuration+C.Battle.LateTolerance+C.Battle.SpotGap
    remote:FireClient(player,'WeakSpot',{Id=g.Id,Token=spot.Token,X=spot.X,Y=spot.Y,EndsAt=spot.EndsAt})
end
function H.weakSpot(player,claim)
    if type(claim)~='table' or type(claim.Token)~='string' or #claim.Token&gt;60 then return end
    -- The client reports a pointer position, never a reward amount or trusted timestamp.
    for _,key in {'X','Y'} do
        local n=claim[key]
        if type(n)~='number' or n~=n or n&lt;0 or n&gt;1 then return end
    end
    local g=H.Active[player]
    local p=profiles.get(player)
    local root=character(player)
    if not g or not g.Battle or g.Finishing or not g.Spot or not p or not root or root~=g.FrozenRoot then return end
    if not equipped(player) or player:GetAttribute('Chamber') or player:GetAttribute('Floor')~=g.Floor or #p.Bag&gt;=Rules.capacity(p) then return end
    local spot=g.Spot
    if claim.Id~=g.Id or claim.Token~=spot.Token then return end
    local offset=workspace:GetServerTimeNow()-spot.EndsAt
    if offset&lt; -C.Battle.EarlyTolerance or offset&gt;C.Battle.LateTolerance then return end
    if (claim.X-spot.X)^2+(claim.Y-spot.Y)^2&gt;C.Battle.SpotRadius^2 then return end
    -- Aim bonuses supplement active clicking. Parking the cursor alone cannot farm captures.
    if os.clock()-g.LastClick&gt;C.Capture.IdleTimeout then return end
    g.Spot=nil -- Consume before changing progress: replayed claims cannot award twice.
    local before=g.Progress
    g.Progress=math.min(1,g.Progress+C.Battle.SpotBonus)
    g.LastActivity=os.clock()
    remote:FireClient(player,'WeakSpotResult',{Id=g.Id,Token=spot.Token,Hit=true,Bonus=g.Progress-before,Progress=g.Progress})
    sendProgress(player,g)
end
local function finish(player,g,p)
    g.Finishing=true
    if not Rules.captureReward(p,g.Species) then g.Finishing=false; H.cancel(player,'Vacuum full.'); return end
    -- Award once on the server. The visual finale cannot grant or repeat a reward.
    releaseEncounter(g)
    H.Active[player]=nil; H.Ghosts[g.Id]=nil
    H.NextEncounter[player]=os.clock()+C.Encounter.Cooldown
    remote:FireAllClients('Captured',{UserId=player.UserId,Id=g.Id,Species=g.Species})
    onChanged(player)
    task.delay(0.8,function() g.Model:Destroy() end)
    task.delay(4,function() spawnGhost(g.Floor) end)
end
function H.start(w,p,r,changed)
    world=w; profiles=p; remote=r; onChanged=changed
    world.GhostFolder=Instance.new('Folder'); world.GhostFolder.Name='WildGhosts'; world.GhostFolder.Parent=world.Root
    for floor=1,6 do for _=1,7 do spawnGhost(floor) end end
    task.spawn(function()
        while task.wait(C.Capture.Tick) do
            local now=os.clock()
            for _,g in H.Ghosts do
                local area=world.Areas[g.Floor]
                local old=g.Pos
                if g.Owner then
                    local player=g.Owner
                    local data=profiles.get(player)
                    local root=character(player)
                    if g.IntroUntil then
                        if not root or root~=g.FrozenRoot or not data or not equipped(player) or player:GetAttribute('Chamber') or player:GetAttribute('Floor')~=g.Floor then
                            H.cancel(player,'')
                        elseif now&gt;=g.IntroUntil then
                            g.IntroUntil=nil; g.Battle=true
                            g.Start=now; g.LastClick=now; g.LastActivity=now; g.NextSpot=now+C.Battle.SpotDelay
                            remote:FireClient(player,'BattleStart',{Id=g.Id,Species=g.Species,Progress=0})
                            remote:FireAllClients('BeamOn',{UserId=player.UserId,Id=g.Id})
                        end
                        continue
                    end
                    if not root or root~=g.FrozenRoot or not data or not equipped(player) or player:GetAttribute('Chamber') or player:GetAttribute('Floor')~=g.Floor or (root.Position-g.Pos).Magnitude&gt;C.Capture.BreakRange or now-g.LastActivity&gt;C.Battle.IdleTimeout or now-g.Start&gt;C.Battle.MaxDuration then
                        H.cancel(player)
                    else
                        if g.Progress&gt;=1 then finish(player,g,data); continue end
                        g.Progress=Rules.capture(g.Progress,0,data.Upgrades.Capture,C.Ghosts[g.Species].Difficulty,C.Capture.Tick)
                        -- The mansion actors stay reserved and stationary for the whole 1v1.
                        -- Resistance still drains progress, but no off-screen chase or damage occurs.
                        if g.Spot and workspace:GetServerTimeNow()&gt;g.Spot.EndsAt+C.Battle.LateTolerance then
                            remote:FireClient(player,'WeakSpotResult',{Id=g.Id,Token=g.Spot.Token,Hit=false,Progress=g.Progress})
                            g.Spot=nil
                        end
                        if now&gt;=g.NextSpot then spawnSpot(player,g,now) end
                        sendProgress(player,g)
                    end
                else
                    -- Anchored, non-colliding ghosts do not reliably fire Touched. Check contact
                    -- on the server, then use the same capacity/floor/line-of-sight validation as clicks.
                    for _,player in Players:GetPlayers() do
                        local root=character(player)
                        if root and not H.Active[player] and now&gt;=(H.NextEncounter[player] or 0) and player:GetAttribute('Floor')==g.Floor and (root.Position-g.Pos).Magnitude&lt;=C.Encounter.TouchRange then
                            local data=profiles.get(player)
                            if data and #data.Bag&lt;Rules.capacity(data) then H.click(player,g.Id) end
                            if g.Owner then break end
                        end
                    end
                    if g.Owner then continue end
                    if now&gt;g.NextMove then
                        g.NextMove=now+rng:NextNumber(2,5)
                        g.Target=area.Center+Vector3.new(rng:NextNumber(-48,48),4,rng:NextNumber(-37,28))
                        for _,player in Players:GetPlayers() do
                            local root=character(player)
                            if root and player:GetAttribute('Floor')==g.Floor and (root.Position-g.Pos).Magnitude&lt;12 then
                                local delta=g.Pos-root.Position
                                if delta.Magnitude&gt;0.1 then g.Target=g.Pos+delta.Unit*15 end
                                break
                            end
                        end
                    end
                    local delta=g.Target-g.Pos
                    if delta.Magnitude&gt;0.4 then g.Pos+=delta.Unit*math.min(delta.Magnitude,0.38) end
                    local rel=g.Pos-area.Center
                    g.Pos=area.Center+Vector3.new(math.clamp(rel.X,-51,51),4+math.sin(now*2+g.Seed)*0.5,math.clamp(rel.Z,-40,37))
                end
                if g.Model.Parent then
                    local direction=if g.Owner and character(g.Owner) then character(g.Owner).Position else g.Pos+(g.Pos-old)
                    direction=Vector3.new(direction.X,g.Pos.Y,direction.Z)
                    g.Model:PivotTo(if (direction-g.Pos).Magnitude&gt;0.05 then CFrame.lookAt(g.Pos,direction) else CFrame.new(g.Pos))
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(player) H.cancel(player); H.LastClick[player]=nil; H.NextEncounter[player]=nil end)
end
return H
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXb40a80c62a69b482d09171eda134bc3c5202e30b">
        <Properties>
          <string name="Name">Landscape</string>
          <ProtectedString name="Source">-- Deterministic landscape around the level town: pure shape functions first, Roblox Terrain writing in build().
-- Everything World.luau places assumes the ground top is y -0.5; that footprint stays exactly level and the
-- hills, ridge, rim and pond are sculpted around it.
local Landscape = {}
local GROUND = -0.5
Landscape.Ground = GROUND
Landscape.Bounds = 336 -- terrain covers x and z in [-336, 336): 168 voxels of 4 studs per axis
Landscape.WaterLevel = -2 -- a voxel boundary; the only ground below it is the pond bed, so water appears nowhere else
Landscape.Pond = {x = 60, z = 215, radius = 30}
-- Measured in Studio 2026-09-10: the WriteVoxels layer addressed at y0 renders as the cell spanning [y0 + 2, y0 + 6),
-- and likewise for x and z. Without this shift the whole landscape sat two studs high and buried the walkways.
Landscape.CellShift = 2

local function smoothstep(a, b, v)
    local t = math.clamp((v - a) / (b - a), 0, 1)
    return t * t * (3 - 2 * t)
end
-- Integer hash and value noise: deterministic on every server without math.noise.
local function hash(ix, iz)
    local h = (ix * 73856093 + iz * 19349663 + 1013904223) % 4294967296
    h = bit32.bxor(h, bit32.rshift(h, 13))
    h = (h * 1664525) % 4294967296
    h = bit32.bxor(h, bit32.rshift(h, 16))
    return h / 4294967296
end
local function noise(x, z)
    local x0, z0 = math.floor(x), math.floor(z)
    local fx, fz = x - x0, z - z0
    local ux, uz = fx * fx * (3 - 2 * fx), fz * fz * (3 - 2 * fz)
    local a, b, c, d = hash(x0, z0), hash(x0 + 1, z0), hash(x0, z0 + 1), hash(x0 + 1, z0 + 1)
    return (a + (b - a) * ux) * (1 - uz) + (c + (d - c) * ux) * uz
end
local function fbm(x, z, scale) -- 0..1, three octaves; the fine octave stays light so hills roll rather than crumple
    return 0.70 * noise(x / scale, z / scale)
        + 0.24 * noise(x / (scale * 0.47) + 31.7, z / (scale * 0.47) + 11.3)
        + 0.06 * noise(x / (scale * 0.21) + 7.1, z / (scale * 0.21) + 53.9)
end

-- Protected footprint: the plaza and Haunt ring, the mansion avenue and hill, the graveyard lot.
local function discOutside(x, z, cx, cz, r)
    return math.max(0, math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) - r)
end
local function rectOutside(x, z, x0, z0, x1, z1)
    local dx = math.max(x0 - x, 0, x - x1)
    local dz = math.max(z0 - z, 0, z - z1)
    return math.sqrt(dx * dx + dz * dz)
end
local function outside(x, z) -- distance beyond the footprint; 0 inside it
    return math.min(discOutside(x, z, 0, 0, 150), rectOutside(x, z, -68, -206, 68, -20), rectOutside(x, z, 116, 64, 182, 148))
end
Landscape.outside = outside

local function knoll(x, z, cx, cz, radius, tall)
    return tall * (1 - smoothstep(0, radius, math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2)))
end
-- Rolling ground that grows with distance from town, two lookout knolls (behind the shops and beyond the graveyard),
-- all fading under the rim so crests stay within the height ceiling.
local function hills(x, z, d)
    local reach = smoothstep(0, 120, d)
    local rolling = (7 + 14 * fbm(x, z, 90)) * (0.5 + 0.5 * reach)
    local lookouts = knoll(x, z, -238, 60, 95, 18) + knoll(x, z, 250, -30, 95, 17) -- broad, and clear of the footprint blends
    local r = math.sqrt(x * x + z * z)
    return (rolling + lookouts) * (1 - 0.6 * smoothstep(240, 300, r))
end
-- A steep ridge stands directly behind the mansion hill so the house reads as carved into a hillside;
-- its face exceeds 60 degrees, which the character slope limit treats as a wall.
local function ridge(x, z)
    local front = smoothstep(214, 236, -z)
    local span = 1 - smoothstep(150, 230, math.abs(x))
    return 44 * front * span * (0.85 + 0.3 * fbm(x + 400, z, 70))
end
-- The rim closes the hollow: it hides the mansion floor boxes to the north and stops anyone reaching the edge.
local function rim(x, z)
    local r = math.sqrt(x * x + z * z)
    local wander = 24 * fbm(x - 300, z + 300, 180) -- the foot of the rim drifts up to 24 studs so the hollow is not a circle
    return 66 * smoothstep(258 + wander, 292 + wander, r) * (0.85 + 0.3 * fbm(x + 300, z - 300, 120))
end
-- One dell in the tree ring south-east of the plaza fills with water: the ground eases down to a flat bed at y -6
-- (a voxel boundary, so the bed and the water fill whole cells), and the water's edge falls close to the nominal
-- radius whatever the surrounding hills do.
local function pondBlend(x, z)
    local p = Landscape.Pond
    local dist = math.sqrt((x - p.x) ^ 2 + (z - p.z) ^ 2)
    return 1 - smoothstep(p.radius - 4, p.radius + 18, dist)
end
function Landscape.height(x, z)
    local d = outside(x, z)
    if d &lt;= 0 then return GROUND end
    local blend = smoothstep(0, 45, d)
    local h = hills(x, z, d) + math.max(ridge(x, z), rim(x, z))
    h += (-6 - h) * pondBlend(x, z)
    return GROUND + (h - GROUND) * blend
end
local function slopeAt(x, z)
    local e = 1.5
    local dx = (Landscape.height(x + e, z) - Landscape.height(x - e, z)) / (2 * e)
    local dz = (Landscape.height(x, z + e) - Landscape.height(x, z - e)) / (2 * e)
    return math.sqrt(dx * dx + dz * dz)
end
-- Terrain material names (Enum.Material keys). LeafyGrass carries no animated blades, so the town floor uses it
-- and paths, plinths and props stay clean; Grass with decoration only appears well beyond the footprint.
function Landscape.material(x, z)
    local h = Landscape.height(x, z)
    if h &lt; Landscape.WaterLevel + 0.6 then return 'Mud' end
    local s = slopeAt(x, z)
    if s &gt; 1.2 then return 'Rock' end
    if outside(x, z) &lt;= 30 then return 'LeafyGrass' end
    if h &gt; 50 then return 'Basalt' end
    if s &gt; 0.7 then return 'Ground' end
    if fbm(x + 900, z - 900, 55) &gt; 0.62 then return 'LeafyGrass' end
    return 'Grass'
end
-- One 4-stud voxel, spanning [bottom, bottom + 4), of the column whose ground top is h. Ground fills from below;
-- water takes any cell the ground leaves more than half empty beneath the water level; everything else is air.
function Landscape.voxel(h, material, bottom)
    local ground = math.clamp((h - bottom) / 4, 0, 1)
    if ground &gt;= 0.5 then return material, ground end
    local water = math.clamp((Landscape.WaterLevel - bottom) / 4, 0, 1)
    if water &gt; ground then return 'Water', water end
    if ground &gt; 0 then return material, ground end
    return 'Air', 0
end
-- Bottom of the cell that WriteVoxels layer j (1-based) of a region starting at minY actually occupies.
function Landscape.layerBottom(minY, j)
    return minY + (j - 1) * 4 + Landscape.CellShift
end

-- Roblox-only from here down. Moonlit material palette, then the whole square written in 84-stud chunks.
local COLORS = {
    Grass = {29, 43, 42}, LeafyGrass = {33, 49, 46}, Ground = {46, 39, 52}, Mud = {40, 33, 46},
    Rock = {58, 56, 74}, Basalt = {40, 38, 56},
}
local CHUNK = 84
local STEP = 4
local FLOOR = -12
function Landscape.build(root)
    local started = os.clock()
    local terrain = workspace.Terrain
    terrain:Clear()
    for name, rgb in COLORS do terrain:SetMaterialColor(Enum.Material[name], Color3.fromRGB(rgb[1], rgb[2], rgb[3])) end
    terrain.WaterColor = Color3.fromRGB(38, 58, 112); terrain.WaterTransparency = 0.55; terrain.WaterReflectance = 0.35
    terrain.WaterWaveSize = 0.08; terrain.WaterWaveSpeed = 6
    -- Terrain.Decoration (grass blades) is not scriptable; tools/build_place.py sets it in the place file.
    local enums = {}
    local function enum(name)
        local e = enums[name]
        if not e then e = Enum.Material[name]; enums[name] = e end
        return e
    end
    local B, n = Landscape.Bounds, CHUNK / STEP
    local columns, chunks = 0, 0
    for cx = -B, B - CHUNK, CHUNK do
        for cz = -B, B - CHUNK, CHUNK do
            local heights, mats, top = {}, {}, Landscape.WaterLevel
            for i = 1, n do
                heights[i], mats[i] = {}, {}
                for k = 1, n do
                    -- Column i covers [cx + (i-1)*4 + shift, cx + i*4 + shift); sample its centre.
                    local x, z = cx + (i - 0.5) * STEP + Landscape.CellShift, cz + (k - 0.5) * STEP + Landscape.CellShift
                    local h = Landscape.height(x, z)
                    heights[i][k], mats[i][k] = h, Landscape.material(x, z)
                    if h &gt; top then top = h end
                end
            end
            -- Layers run from FLOOR up to the first one lying entirely above the highest surface in the chunk.
            local lastY0 = math.ceil((top - Landscape.CellShift) / STEP) * STEP
            local ny = (lastY0 - FLOOR) / STEP + 1
            local materials, occupancy = {}, {}
            for i = 1, n do
                materials[i], occupancy[i] = {}, {}
                for j = 1, ny do
                    local bottom = Landscape.layerBottom(FLOOR, j)
                    local mRow, oRow = {}, {}
                    for k = 1, n do
                        local name, o = Landscape.voxel(heights[i][k], mats[i][k], bottom)
                        mRow[k], oRow[k] = enum(name), o
                    end
                    materials[i][j], occupancy[i][j] = mRow, oRow
                end
            end
            terrain:WriteVoxels(Region3.new(Vector3.new(cx, FLOOR, cz), Vector3.new(cx + CHUNK, FLOOR + ny * STEP, cz + CHUNK)), STEP, materials, occupancy)
            columns += n * n; chunks += 1
        end
    end
    -- Invisible walls along the edge of the square; the rim already makes the edge hard to reach.
    for _, side in {-1, 1} do
        for _, axis in {'x', 'z'} do
            local wall = Instance.new('Part'); wall.Name = 'WorldEdge'; wall.Anchored = true; wall.Transparency = 1
            wall.CanQuery = false; wall.CastShadow = false
            if axis == 'x' then
                wall.Size = Vector3.new(2, 200, 2 * B + 4); wall.CFrame = CFrame.new(side * (B + 1), 80, 0)
            else
                wall.Size = Vector3.new(2 * B + 4, 200, 2); wall.CFrame = CFrame.new(0, 80, side * (B + 1))
            end
            wall.Parent = root
        end
    end
    return {columns = columns, chunks = chunks, seconds = os.clock() - started}
end
return Landscape
</ProtectedString>
