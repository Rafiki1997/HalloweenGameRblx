      <Item class="ModuleScript" referent="RBXb81897324ac738e5a8cc7b8c2c412b47c6b2fa74">
        <Properties>
          <string name="Name">LabelVisibility</string>
          <ProtectedString name="Source">-- Client-only proximity and screen-overlap filtering. Text remains server-owned.
local Labels={}
function Labels.start(player,focus)
    local labels={}
    local function register(item)
        if item:IsA('BillboardGui') and item:GetAttribute('ContextLabel') then labels[item]=true end
    end
    for _,item in workspace:GetDescendants() do register(item) end
    workspace.DescendantAdded:Connect(register)
    workspace.DescendantRemoving:Connect(function(item) labels[item]=nil end)
    local elapsed=0
    game:GetService('RunService').Heartbeat:Connect(function(dt)
        elapsed+=dt
        if elapsed&lt;.12 then return end
        elapsed=0
        local camera=workspace.CurrentCamera
        local character=player.Character
        local root=character and character:FindFirstChild('HumanoidRootPart')
        if not camera or not root then return end
        local target=focus()
        local candidates={}
        for gui in labels do
            gui.Enabled=false
            local anchor=gui.Adornee or gui.Parent
            if not anchor:IsA('BasePart') then continue end
            local distance=(root.Position-anchor.Position).Magnitude
            if distance&gt;(gui:GetAttribute('ReadDistance') or 42) then continue end
            local isGhost=gui:GetAttribute('GhostLabel')
            if isGhost and (not target or not gui:IsDescendantOf(target)) then continue end
            local point,visible=camera:WorldToViewportPoint(anchor.Position+gui.StudsOffset+gui.StudsOffsetWorldSpace)
            if not visible then continue end
            local w,h=gui.Size.X.Offset,gui.Size.Y.Offset
            local rect={x=point.X-w/2-8,y=point.Y-h/2-6,w=w+16,h=h+12}
            table.insert(candidates,{gui=gui,rect=rect,score=distance-(isGhost and 1000 or 0)})
        end
        table.sort(candidates,function(a,b) return a.score&lt;b.score end)
        local shown={}
        for _,candidate in candidates do
            local r=candidate.rect
            local clear=true
            for _,other in shown do
                if r.x&lt;other.x+other.w and r.x+r.w&gt;other.x and r.y&lt;other.y+other.h and r.y+r.h&gt;other.y then clear=false; break end
            end
            if clear then
                candidate.gui.Enabled=true; table.insert(shown,r)
                if #shown&gt;=4 then break end
            end
        end
    end)
end
return Labels
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXb8e3572f0a16dbe555b4b4cb8e847a59f9ea87e5">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">local Config = if script then require(script.Parent.Config) else require('./Config')
local R = {}
local function integer(v, lo, hi, fallback)
    if type(v) ~= 'number' or v ~= v or math.abs(v) == math.huge then return fallback end
    return math.clamp(math.floor(v), lo, hi)
end
function R.newProfile()
    return {Version=1,Money=0,Owned={},Discovered={},Bag={},Placed={},HauntLevel=1,Floor=1,Rebirths=0,
        Upgrades={Suction=1,Capture=1,Capacity=1,Movement=1,Flashlight=1},Captures=0,ChamberDiscoveries=0}
end
function R.reconcile(raw)
    local p = R.newProfile()
    if type(raw) ~= 'table' then return p end
    p.Money = integer(raw.Money,0,1e15,0)
    p.HauntLevel = integer(raw.HauntLevel,1,5,1)
    p.Floor = integer(raw.Floor,1,6,1)
    p.Rebirths = integer(raw.Rebirths,0,10000,0)
    p.Captures = integer(raw.Captures,0,1e12,0)
    p.ChamberDiscoveries = integer(raw.ChamberDiscoveries,0,1e12,0)
    for name in p.Upgrades do
        p.Upgrades[name] = integer(type(raw.Upgrades)=='table' and raw.Upgrades[name],1,6,1)
    end
    for id in Config.Ghosts do
        local qty = integer(type(raw.Owned)=='table' and raw.Owned[id],0,1e9,0)
        if qty &gt; 0 then p.Owned[id] = qty end
        if qty &gt; 0 or (type(raw.Discovered)=='table' and raw.Discovered[id] == true) then p.Discovered[id] = true end
    end
    local used = {}
    for _, field in {'Bag','Placed'} do
        if type(raw[field]) == 'table' then
            local limit = if field=='Bag' then R.capacity(p) else Config.Slots[p.HauntLevel]
            for _, id in raw[field] do
                if type(id)=='string' and Config.Ghosts[id] and #p[field]&lt;limit and (used[id] or 0)&lt;(p.Owned[id] or 0) then
                    table.insert(p[field],id)
                    used[id]=(used[id] or 0)+1
                end
            end
        end
    end
    return p
end
function R.capacity(p) return Config.Capacity[p.Upgrades.Capacity] end
function R.multiplier(p) return 1+p.Rebirths*0.5 end
function R.income(p)
    local sum=0
    for _, id in p.Placed do sum += Config.Ghosts[id].Income end
    return sum * R.multiplier(p)
end
function R.capture(progress, clicks, power, difficulty, dt)
    return math.clamp(progress + clicks*(0.085+0.025*(power-1))/difficulty - dt*0.028*difficulty,0,1)
end
function R.captureReward(p,id)
    if not Config.Ghosts[id] or #p.Bag&gt;=R.capacity(p) then return false end
    p.Owned[id]=(p.Owned[id] or 0)+1
    p.Discovered[id]=true
    p.Captures+=1
    table.insert(p.Bag,id)
    return true
end
function R.chamberReward(p,id)
    if #p.Placed==0 or not Config.Ghosts[id] or not table.find(Config.Ghosts[id].Areas,p.Floor) then return false end
    p.Owned[id]=(p.Owned[id] or 0)+1
    p.Discovered[id]=true
    p.ChamberDiscoveries+=1
    return true
end
function R.deposit(p) table.clear(p.Bag) end
function R.available(p,id)
    local n=p.Owned[id] or 0
    for _, v in p.Placed do if v==id then n-=1 end end
    for _, v in p.Bag do if v==id then n-=1 end end
    return n
end
function R.place(p,id)
    if not Config.Ghosts[id] or #p.Placed&gt;=Config.Slots[p.HauntLevel] or R.available(p,id)&lt;=0 then return false end
    table.insert(p.Placed,id)
    return true
end
function R.remove(p,index)
    if type(index)~='number' or index~=math.floor(index) or index&lt;1 or index&gt;#p.Placed then return false end
    table.remove(p.Placed,index)
    return true
end
function R.upgradeCost(p,name)
    if name=='Haunt' then return Config.HauntCosts[p.HauntLevel+1] end
    if not Config.UpgradeBase[name] or p.Upgrades[name]&gt;=Config.MaxUpgrade then return nil end
    return math.floor(Config.UpgradeBase[name]*4^(p.Upgrades[name]-1))
end
function R.upgrade(p,name)
    local cost=R.upgradeCost(p,name)
    if not cost or p.Money&lt;cost then return false end
    p.Money-=cost
    if name=='Haunt' then p.HauntLevel+=1 else p.Upgrades[name]+=1 end
    return true
end
function R.unlock(p,floor)
    if type(floor)~='number' or floor~=p.Floor+1 or not Config.Floors[floor] then return false end
    local cost=Config.Floors[floor].Cost
    if p.Money&lt;cost then return false end
    p.Money-=cost
    p.Floor=floor
    return true
end
function R.rebirthCost(p) return 5000000000*(1+p.Rebirths) end
function R.rebirth(p)
    if p.Floor&lt;6 or p.Money&lt;R.rebirthCost(p) then return false end
    p.Money=0
    p.Floor=1
    p.HauntLevel=1
    p.Rebirths+=1
    table.clear(p.Bag)
    table.clear(p.Placed)
    for name in p.Upgrades do p.Upgrades[name]=1 end
    return true
end
function R.pool(floor)
    local result={}
    for id,g in Config.Ghosts do if table.find(g.Areas,floor) then table.insert(result,id) end end
    table.sort(result)
    return result
end
function R.roll(floor,unit)
    local pool=R.pool(floor)
    local total=0
    for _,id in pool do total+=Config.Ghosts[id].Weight end
    local pick=unit*total
    for _,id in pool do pick-=Config.Ghosts[id].Weight; if pick&lt;=0 then return id end end
    return pool[#pool]
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX53e5437058e737ddc308908f6c65439a52902cac">
        <Properties>
          <string name="Name">Visuals</string>
          <ProtectedString name="Source">local Config=require(script.Parent.Config)
local V={}
function V.color(rarity) return Color3.fromRGB(table.unpack(Config.Colors[rarity])) end
function V.part(parent,name,size,cf,color,material)
    local p=Instance.new('Part')
    p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic
    p.Anchored=true; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
function V.label(part,text,color,width,height)
    local gui=Instance.new('BillboardGui')
    gui.Name='Label'; gui.Size=UDim2.fromOffset(math.min(width or 210,230),math.min(height or 48,64))
    gui.StudsOffset=Vector3.new(0,3,0); gui.MaxDistance=180; gui.AlwaysOnTop=false
    gui:SetAttribute('ContextLabel',true); gui:SetAttribute('ReadDistance',42)
    gui.Enabled=false; gui.Parent=part
    local label=Instance.new('TextLabel')
    label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.Text=text
    label.TextColor3=color or Color3.new(1,1,1); label.TextStrokeTransparency=0.75
    label.Font=Enum.Font.GothamMedium; label.TextSize=14; label.TextWrapped=true; label.Parent=gui
    return label
end
function V.ghost(id,parent,cf,scale,withLabel)
    local g=Config.Ghosts[id]
    local m=Instance.new('Model'); m.Name=g.Name; m:SetAttribute('Species',id)
    local c=V.color(g.Rarity)
    local root=if g.Shape=='ReferenceGhost' then require(script.Parent.GhostModels).build(m)
        else require(script.Parent.GhostStyle).build(m,g,c)
    m.Parent=parent; m:ScaleTo(scale or 1); m:PivotTo(cf)
    if withLabel then
        local label=V.label(root,g.Name..'\n'..Config.Rarities[g.Rarity],c,180,42)
        label.Parent:SetAttribute('GhostLabel',true)
        label.Parent.StudsOffset=Vector3.new(0,m:GetExtentsSize().Y*.5+.8,0)
    end
    return m
end
function V.vacuum()
    local t=Instance.new('Tool'); t.Name='Spectral Vacuum'; t.RequiresHandle=true; t.CanBeDropped=false
    t.Grip=CFrame.new(0,-0.3,0.5)*CFrame.Angles(0,0,0)
    local handle=V.part(t,'Handle',Vector3.new(0.65,1,0.65),CFrame.new(),Color3.fromRGB(43,39,57))
    local function attach(name,size,position,color,material)
        local p=V.part(t,name,size,CFrame.new(position),color,material)
        local w=Instance.new('WeldConstraint'); w.Part0=handle; w.Part1=p; w.Parent=p
        return p
    end
    attach('Body',Vector3.new(1.4,1.4,2.3),Vector3.new(0,0.6,-0.4),Color3.fromRGB(78,63,105),Enum.Material.Metal)
    local tank=attach('CaptureContainer',Vector3.new(1,1.6,1),Vector3.new(0,1.4,0.2),Color3.fromRGB(108,245,225),Enum.Material.Neon)
    tank.Transparency=0.35
    attach('Hose',Vector3.new(0.55,0.55,2),Vector3.new(0,0.6,-2),Color3.fromRGB(30,28,40))
    local nozzle=attach('Nozzle',Vector3.new(1,0.85,0.6),Vector3.new(0,0.6,-3),Color3.fromRGB(174,154,220),Enum.Material.Metal)
    local a=Instance.new('Attachment'); a.Name='Suction'; a.Position=Vector3.new(0,0,-0.35); a.Parent=nozzle
    local lens=attach('Flashlight',Vector3.new(0.45,0.45,0.3),Vector3.new(0.7,0.8,-1.5),Color3.fromRGB(255,236,178),Enum.Material.Neon)
    local light=Instance.new('SpotLight'); light.Name='Lamp'; light.Face=Enum.NormalId.Front; light.Angle=65; light.Range=40; light.Brightness=3; light.Shadows=true; light.Parent=lens
    for _,p in t:GetDescendants() do if p:IsA('BasePart') then p.Anchored=false; p.CanCollide=false; p.Massless=true end end
    return t
end
return V
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX15343b82a4c762836f7b982e03f4abaa9d4afa85">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX9a8fa37bb0b85f588cf6f9888edec67b45975d98">
      <Properties>
        <string name="Name">GhostlightServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXaa7da4f6cc206ce3b8a5684ff2bfd2ffa2185da4">
        <Properties>
          <string name="Name">Chamber</string>
          <ProtectedString name="Source">local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local V=require(Shared.Visuals)
local Rules=require(Shared.Rules)
local C=require(Shared.Config)
local Chamber={Sessions={}}
local rng=Random.new()
local world,profiles,remote,changed
function Chamber.leave(player)
    local s=Chamber.Sessions[player]
    if s then s.Model:Destroy(); Chamber.Sessions[player]=nil end
    player:SetAttribute('Chamber',false)
    local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
    if hum then hum.AutoRotate=true end
    remote:FireClient(player,'ChamberExit')
end
function Chamber.enter(player,plotIndex)
    local p=profiles.get(player)
    if not p or #p.Placed==0 then remote:FireClient(player,'Notice','Place at least one ghost in your Haunt first.'); return false end
    if Chamber.Sessions[player] then return false end
    local center=Vector3.new((plotIndex-1)*130,0,-720)
    local m=Instance.new('Model'); m.Name='Chamber_'..player.UserId; m.Parent=world.Root
    local function part(name,size,pos,color)
        return V.part(m,name,size,CFrame.new(center+pos),color or Color3.fromRGB(62,44,72),Enum.Material.Slate)
    end
    part('MiniatureFloor',Vector3.new(68,1,54),Vector3.new(0,0,0))
    for _,s in {-1,1} do
        part('Wall',Vector3.new(68,4,1),Vector3.new(0,2,s*27))
        part('Wall',Vector3.new(1,4,54),Vector3.new(s*34,2,0))
        for _,z in {-19,19} do part('RoomWall',Vector3.new(1,4,16),Vector3.new(s*12,2,z)) end
        for _,x in {-26,26} do part('RoomWall',Vector3.new(16,4,1),Vector3.new(x,2,0)) end
    end
    for _,x in {-25,0,25} do for _,z in {-18,18} do
        part('Rug',Vector3.new(10,0.15,9),Vector3.new(x,0.65,z),Color3.fromRGB(87,42,95))
        local candle=part('Lantern',Vector3.new(0.5,2,0.5),Vector3.new(x+5,1.7,z),Color3.fromRGB(255,184,87))
        candle.Material=Enum.Material.Neon
        local light=Instance.new('PointLight'); light.Color=candle.Color; light.Range=16; light.Parent=candle
    end end
    local hunters={}
    for i,id in p.Placed do
        local pos=center+Vector3.new((i%5-2)*5,3,((math.floor(i/5))%4-2)*5)
        local ghost=V.ghost(id,m,CFrame.new(pos),0.65,false)
        table.insert(hunters,{Model=ghost,Pos=pos,Phase=i*1.7})
    end
    local preyId=Rules.roll(p.Floor,rng:NextNumber())
    local prey=V.ghost(preyId,m,CFrame.new(center+Vector3.new(22,3,-17)),0.55,true)
    Chamber.Sessions[player]={Model=m,Center=center,Hunters=hunters,Prey=prey,PreyId=preyId,Start=os.clock(),NextReward=os.clock()+C.ChamberInterval,LastStep=os.clock()}
    player:SetAttribute('Chamber',true)
    local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
    if root then player.Character:PivotTo(CFrame.new(center+Vector3.new(0,4,23))) end
    local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
    if hum then hum.WalkSpeed=0; hum.AutoRotate=false end
    remote:FireClient(player,'ChamberEnter',{Center=center,Hunters=#hunters})
    return true
end
function Chamber.start(w,p,r,callback)
    world=w; profiles=p; remote=r; changed=callback
    task.spawn(function()
        while task.wait(0.2) do
            local now=os.clock()
            for player,s in Chamber.Sessions do
                local data=profiles.get(player)
                if not data then continue end
                local phase=(now-s.Start)%C.ChamberInterval
                local hunting=phase&gt;C.ChamberInterval-8
                local target=s.Prey:GetPivot().Position
                for _,h in s.Hunters do
                    local goal=if hunting then target else s.Center+Vector3.new(math.sin(now*0.22+h.Phase)*26,3,math.cos(now*0.18+h.Phase)*19)
                    local delta=goal-h.Pos
                    if delta.Magnitude&gt;0.25 then h.Pos+=delta.Unit*math.min(delta.Magnitude,1.3) end
                    h.Model:PivotTo(CFrame.new(h.Pos))
                end
                if now&gt;=s.NextReward then
                    s.NextReward=now+C.ChamberInterval
                    if Rules.chamberReward(data,s.PreyId) then
                        data.Money=math.min(1e15,data.Money+Rules.income(data)*5)
                        remote:FireClient(player,'ChamberFound',{Species=s.PreyId})
                        changed(player)
                    end
                    s.Prey:Destroy()
                    s.PreyId=Rules.roll(data.Floor,rng:NextNumber())
                    s.Prey=V.ghost(s.PreyId,s.Model,CFrame.new(s.Center+Vector3.new(rng:NextNumber(-27,27),3,rng:NextNumber(-19,19))),0.55,true)
                end
            end
        end
    end)
end
return Chamber
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXaa592f87e20e97c9c9047d447c22bbbc2dd3703c">
        <Properties>
          <string name="Name">Hunting</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local Http=game:GetService('HttpService')
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local C=require(Shared.Config)
local Rules=require(Shared.Rules)
local V=require(Shared.Visuals)
local H={Ghosts={},Active={},LastClick={}}
local rng=Random.new()
local world,profiles,remote,onChanged
local function character(player)
    local char=player.Character
    local root=char and char:FindFirstChild('HumanoidRootPart')
    local humanoid=char and char:FindFirstChildOfClass('Humanoid')
    return if root and humanoid and humanoid.Health&gt;0 then root else nil
end
local function equipped(player)
    return player.Character and player.Character:FindFirstChild('Spectral Vacuum')
end
function H.cancel(player,message)
    local g=H.Active[player]
    if g then
        g.Owner=nil; g.Progress=0; g.Model:SetAttribute('Hunter',nil)
        H.Active[player]=nil
        remote:FireAllClients('BeamOff',{UserId=player.UserId})
        remote:FireClient(player,'CaptureEnd',message or 'Ghost escaped! Stay close and keep clicking.')
    end
end
local function spawnGhost(floor)
    local area=world.Areas[floor]
    local species=Rules.roll(floor,rng:NextNumber())
    local pos=area.Center+Vector3.new(rng:NextNumber(-46,46),4,rng:NextNumber(-32,24))
    local id=Http:GenerateGUID(false)
    local model=V.ghost(species,world.GhostFolder,CFrame.new(pos),1,true)
    model.Name='Ghost_'..id; model:SetAttribute('GhostId',id); model:SetAttribute('Floor',floor)
    local g={Id=id,Species=species,Floor=floor,Model=model,Pos=pos,Target=pos,Progress=0,NextMove=0,Seed=rng:NextNumber(0,20)}
    H.Ghosts[id]=g
    return g
end
function H.click(player,id)
    if type(id)~='string' or #id&gt;60 then return end
    local now=os.clock()
    if now-(H.LastClick[player] or 0)&lt;C.Capture.ClickInterval then return end
    H.LastClick[player]=now
    local p=profiles.get(player)
    local root=character(player)
    if not p or not root or not equipped(player) or player:GetAttribute('Chamber') then return end
    local g=H.Ghosts[id]
    if not g or g.Finishing or (g.Owner and g.Owner~=player) or g.Floor&gt;p.Floor or player:GetAttribute('Floor')~=g.Floor then return end
    if #p.Bag&gt;=Rules.capacity(p) then remote:FireClient(player,'Notice','VACUUM FULL • Return to your Haunt to deposit.'); return end
    if H.Active[player] and H.Active[player]~=g then return end
    local range=if g.Owner then C.Capture.BreakRange else C.Capture.Range+p.Upgrades.Suction
    if (root.Position-g.Pos).Magnitude&gt;range then return end
    if not g.Owner then
        local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={player.Character,world.GhostFolder}
        local hit=workspace:Raycast(root.Position,g.Pos-root.Position,params)
        if hit then return end
        g.Owner=player; g.Progress=0; g.Start=now; H.Active[player]=g
        g.Model:SetAttribute('Hunter',player.UserId)
        remote:FireAllClients('BeamOn',{UserId=player.UserId,Id=g.Id})
    end
                        g.LastClick=now
    g.Progress=Rules.capture(g.Progress,1,p.Upgrades.Capture,C.Ghosts[g.Species].Difficulty,0)
end
local function finish(player,g,p)
    g.Finishing=true
    if not Rules.captureReward(p,g.Species) then g.Finishing=false; H.cancel(player,'Vacuum full.'); return end
    -- Award once on the server. The visual finale cannot grant or repeat a reward.
    H.Active[player]=nil; H.Ghosts[g.Id]=nil
    remote:FireAllClients('Captured',{UserId=player.UserId,Id=g.Id,Species=g.Species})
    onChanged(player)
    task.delay(0.8,function() g.Model:Destroy() end)
    task.delay(4,function() spawnGhost(g.Floor) end)
end
function H.start(w,p,r,changed)
    world=w; profiles=p; remote=r; onChanged=changed
    world.GhostFolder=Instance.new('Folder'); world.GhostFolder.Name='WildGhosts'; world.GhostFolder.Parent=world.Root
    for floor=1,6 do for _=1,7 do spawnGhost(floor) end end
    task.spawn(function()
        while task.wait(C.Capture.Tick) do
            local now=os.clock()
            for _,g in H.Ghosts do
                local area=world.Areas[g.Floor]
                local old=g.Pos
                if g.Owner then
                    local player=g.Owner
                    local data=profiles.get(player)
                    local root=character(player)
                    if not root or not data or not equipped(player) or player:GetAttribute('Floor')~=g.Floor or (root.Position-g.Pos).Magnitude&gt;C.Capture.BreakRange or now-g.LastClick&gt;C.Capture.IdleTimeout then
                        H.cancel(player)
                    else
                        if g.Progress&gt;=1 then finish(player,g,data); continue end
                        g.Progress=Rules.capture(g.Progress,0,data.Upgrades.Capture,C.Ghosts[g.Species].Difficulty,C.Capture.Tick)
                        if now-(g.LastAttack or 0)&gt;=C.Capture.AttackInterval and (root.Position-g.Pos).Magnitude&lt;=C.Capture.AttackRange then
                            g.LastAttack=now
                            local humanoid=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
                            if humanoid and not player:GetAttribute('TestInvulnerable') then humanoid:TakeDamage(C.Capture.AttackDamage*10) end
                            g.Progress=math.max(0,g.Progress-C.Capture.AttackDamage*0.08)
                            remote:FireClient(player,'GhostAttack',{Species=g.Species})
                        end
                        local away=g.Pos-root.Position
                        away=Vector3.new(away.X,0,away.Z)
                        if away.Magnitude&lt;0.1 then away=Vector3.new(0,0,-1) end
                        away=away.Unit
                        local surge=math.sin((now-g.Start)*2.7+g.Seed)&gt;0.55
                        local speed=if surge then 9+C.Ghosts[g.Species].Rarity else -2-data.Upgrades.Suction*0.65-g.Progress*5
                        local side=Vector3.new(-away.Z,0,away.X)*math.sin(now*5+g.Seed)*4
                        g.Pos+= (away*speed+side)*C.Capture.Tick
                        local relative=g.Pos-area.Center
                        g.Pos=area.Center+Vector3.new(math.clamp(relative.X,-51,51),4+math.sin(now*7)*0.35,math.clamp(relative.Z,-40,36))
                        remote:FireClient(player,'CaptureProgress',{Progress=g.Progress,Species=g.Species,Surge=surge})
                    end
                else
                    if now&gt;g.NextMove then
                        g.NextMove=now+rng:NextNumber(2,5)
                        g.Target=area.Center+Vector3.new(rng:NextNumber(-48,48),4,rng:NextNumber(-37,28))
                        for _,player in Players:GetPlayers() do
                            local root=character(player)
                            if root and player:GetAttribute('Floor')==g.Floor and (root.Position-g.Pos).Magnitude&lt;12 then
                                local delta=g.Pos-root.Position
                                if delta.Magnitude&gt;0.1 then g.Target=g.Pos+delta.Unit*15 end
                                break
                            end
                        end
                    end
                    local delta=g.Target-g.Pos
                    if delta.Magnitude&gt;0.4 then g.Pos+=delta.Unit*math.min(delta.Magnitude,0.38) end
                    local rel=g.Pos-area.Center
                    g.Pos=area.Center+Vector3.new(math.clamp(rel.X,-51,51),4+math.sin(now*2+g.Seed)*0.5,math.clamp(rel.Z,-40,37))
                end
                if g.Model.Parent then
                    local direction=if g.Owner and character(g.Owner) then character(g.Owner).Position else g.Pos+(g.Pos-old)
                    direction=Vector3.new(direction.X,g.Pos.Y,direction.Z)
                    g.Model:PivotTo(if (direction-g.Pos).Magnitude&gt;0.05 then CFrame.lookAt(g.Pos,direction) else CFrame.new(g.Pos))
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(player) H.cancel(player); H.LastClick[player]=nil end)
end
return H
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXb40a80c62a69b482d09171eda134bc3c5202e30b">
        <Properties>
          <string name="Name">Landscape</string>
          <ProtectedString name="Source">-- Deterministic landscape around the level town: pure shape functions first, Roblox Terrain writing in build().
-- Everything World.luau places assumes the ground top is y -0.5; that footprint stays exactly level and the
-- hills, ridge, rim and pond are sculpted around it.
local Landscape = {}
local GROUND = -0.5
Landscape.Ground = GROUND
Landscape.Bounds = 336 -- terrain covers x and z in [-336, 336): 168 voxels of 4 studs per axis
Landscape.WaterLevel = -1.5 -- the only ground below this is the pond floor, so water appears nowhere else
Landscape.Pond = {x = 60, z = 215, radius = 30}

local function smoothstep(a, b, v)
    local t = math.clamp((v - a) / (b - a), 0, 1)
    return t * t * (3 - 2 * t)
end
-- Integer hash and value noise: deterministic on every server without math.noise.
local function hash(ix, iz)
    local h = (ix * 73856093 + iz * 19349663 + 1013904223) % 4294967296
    h = bit32.bxor(h, bit32.rshift(h, 13))
    h = (h * 1664525) % 4294967296
    h = bit32.bxor(h, bit32.rshift(h, 16))
    return h / 4294967296
end
local function noise(x, z)
    local x0, z0 = math.floor(x), math.floor(z)
    local fx, fz = x - x0, z - z0
    local ux, uz = fx * fx * (3 - 2 * fx), fz * fz * (3 - 2 * fz)
    local a, b, c, d = hash(x0, z0), hash(x0 + 1, z0), hash(x0, z0 + 1), hash(x0 + 1, z0 + 1)
    return (a + (b - a) * ux) * (1 - uz) + (c + (d - c) * ux) * uz
end
local function fbm(x, z, scale) -- 0..1, three octaves; the fine octave stays light so hills roll rather than crumple
    return 0.70 * noise(x / scale, z / scale)
        + 0.24 * noise(x / (scale * 0.47) + 31.7, z / (scale * 0.47) + 11.3)
        + 0.06 * noise(x / (scale * 0.21) + 7.1, z / (scale * 0.21) + 53.9)
end

-- Protected footprint: the plaza and Haunt ring, the mansion avenue and hill, the graveyard lot.
local function discOutside(x, z, cx, cz, r)
    return math.max(0, math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) - r)
end
local function rectOutside(x, z, x0, z0, x1, z1)
    local dx = math.max(x0 - x, 0, x - x1)
    local dz = math.max(z0 - z, 0, z - z1)
    return math.sqrt(dx * dx + dz * dz)
end
local function outside(x, z) -- distance beyond the footprint; 0 inside it
    return math.min(discOutside(x, z, 0, 0, 150), rectOutside(x, z, -68, -206, 68, -20), rectOutside(x, z, 116, 64, 182, 148))
end
Landscape.outside = outside

local function knoll(x, z, cx, cz, radius, tall)
    return tall * (1 - smoothstep(0, radius, math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2)))
end
-- Rolling ground that grows with distance from town, two lookout knolls (behind the shops and beyond the graveyard),
-- all fading under the rim so crests stay within the height ceiling.
local function hills(x, z, d)
    local reach = smoothstep(0, 120, d)
    local rolling = (7 + 14 * fbm(x, z, 90)) * (0.5 + 0.5 * reach)
    local lookouts = knoll(x, z, -238, 60, 95, 18) + knoll(x, z, 250, -30, 95, 17) -- broad, and clear of the footprint blends
    local r = math.sqrt(x * x + z * z)
    return (rolling + lookouts) * (1 - 0.6 * smoothstep(240, 300, r))
end
-- A steep ridge stands directly behind the mansion hill so the house reads as carved into a hillside;
-- its face exceeds 60 degrees, which the character slope limit treats as a wall.
local function ridge(x, z)
    local front = smoothstep(214, 236, -z)
    local span = 1 - smoothstep(150, 230, math.abs(x))
    return 44 * front * span * (0.85 + 0.3 * fbm(x + 400, z, 70))
end
-- The rim closes the hollow: it hides the mansion floor boxes to the north and stops anyone reaching the edge.
local function rim(x, z)
    local r = math.sqrt(x * x + z * z)
    local wander = 24 * fbm(x - 300, z + 300, 180) -- the foot of the rim drifts up to 24 studs so the hollow is not a circle
    return 66 * smoothstep(258 + wander, 292 + wander, r) * (0.85 + 0.3 * fbm(x + 300, z - 300, 120))
end
-- One dell in the tree ring south-east of the plaza fills with water: the ground eases down to a flat bed at y -8,
-- and the water's edge falls close to the nominal radius whatever the surrounding hills do.
local function pondBlend(x, z)
    local p = Landscape.Pond
    local dist = math.sqrt((x - p.x) ^ 2 + (z - p.z) ^ 2)
    return 1 - smoothstep(p.radius - 6, p.radius + 16, dist)
end
function Landscape.height(x, z)
    local d = outside(x, z)
    if d &lt;= 0 then return GROUND end
    local blend = smoothstep(0, 45, d)
    local h = hills(x, z, d) + math.max(ridge(x, z), rim(x, z))
    h += (-8 - h) * pondBlend(x, z)
    return GROUND + (h - GROUND) * blend
end
local function slopeAt(x, z)
    local e = 1.5
    local dx = (Landscape.height(x + e, z) - Landscape.height(x - e, z)) / (2 * e)
    local dz = (Landscape.height(x, z + e) - Landscape.height(x, z - e)) / (2 * e)
    return math.sqrt(dx * dx + dz * dz)
end
-- Terrain material names (Enum.Material keys). LeafyGrass carries no animated blades, so the town floor uses it
-- and paths, plinths and props stay clean; Grass with decoration only appears well beyond the footprint.
function Landscape.material(x, z)
    local h = Landscape.height(x, z)
    if h &lt; Landscape.WaterLevel + 0.6 then return 'Mud' end
    local s = slopeAt(x, z)
    if s &gt; 1.2 then return 'Rock' end
    if outside(x, z) &lt;= 30 then return 'LeafyGrass' end
    if h &gt; 50 then return 'Basalt' end
    if s &gt; 0.7 then return 'Ground' end
    if fbm(x + 900, z - 900, 55) &gt; 0.62 then return 'LeafyGrass' end
    return 'Grass'
end
-- One 4-stud voxel of the column whose ground top is h. Ground fills from below; water takes any cell the ground
-- leaves more than half empty beneath the water level; everything else is air.
function Landscape.voxel(h, material, y0)
    local ground = math.clamp((h - y0) / 4, 0, 1)
    if ground &gt;= 0.5 then return material, ground end
    local water = math.clamp((Landscape.WaterLevel - y0) / 4, 0, 1)
    if water &gt; ground then return 'Water', water end
    if ground &gt; 0 then return material, ground end
    return 'Air', 0
end

-- Roblox-only from here down. Moonlit material palette, then the whole square written in 84-stud chunks.
local COLORS = {
    Grass = {29, 43, 42}, LeafyGrass = {33, 49, 46}, Ground = {46, 39, 52}, Mud = {40, 33, 46},
    Rock = {58, 56, 74}, Basalt = {40, 38, 56},
}
local CHUNK = 84
local STEP = 4
local FLOOR = -12
function Landscape.build(root)
    local started = os.clock()
    local terrain = workspace.Terrain
    terrain:Clear()
    for name, rgb in COLORS do terrain:SetMaterialColor(Enum.Material[name], Color3.fromRGB(rgb[1], rgb[2], rgb[3])) end
    terrain.WaterColor = Color3.fromRGB(38, 58, 112); terrain.WaterTransparency = 0.55; terrain.WaterReflectance = 0.35
    terrain.WaterWaveSize = 0.08; terrain.WaterWaveSpeed = 6
    -- Terrain.Decoration (grass blades) is not scriptable; tools/build_place.py sets it in the place file.
    local enums = {}
    local function enum(name)
        local e = enums[name]
        if not e then e = Enum.Material[name]; enums[name] = e end
        return e
    end
    local B, n = Landscape.Bounds, CHUNK / STEP
    local columns, chunks = 0, 0
    for cx = -B, B - CHUNK, CHUNK do
        for cz = -B, B - CHUNK, CHUNK do
            local heights, mats, top = {}, {}, Landscape.WaterLevel
            for i = 1, n do
                heights[i], mats[i] = {}, {}
                for k = 1, n do
                    local x, z = cx + (i - 0.5) * STEP, cz + (k - 0.5) * STEP
                    local h = Landscape.height(x, z)
                    heights[i][k], mats[i][k] = h, Landscape.material(x, z)
                    if h &gt; top then top = h end
                end
            end
            local yTop = math.ceil((top + STEP) / STEP) * STEP
            local ny = (yTop - FLOOR) / STEP
            local materials, occupancy = {}, {}
            for i = 1, n do
                materials[i], occupancy[i] = {}, {}
                for j = 1, ny do
                    local y0 = FLOOR + (j - 1) * STEP
                    local mRow, oRow = {}, {}
                    for k = 1, n do
                        local name, o = Landscape.voxel(heights[i][k], mats[i][k], y0)
                        mRow[k], oRow[k] = enum(name), o
                    end
                    materials[i][j], occupancy[i][j] = mRow, oRow
                end
            end
            terrain:WriteVoxels(Region3.new(Vector3.new(cx, FLOOR, cz), Vector3.new(cx + CHUNK, yTop, cz + CHUNK)), STEP, materials, occupancy)
            columns += n * n; chunks += 1
        end
    end
    -- Invisible walls along the edge of the square; the rim already makes the edge hard to reach.
    for _, side in {-1, 1} do
        for _, axis in {'x', 'z'} do
            local wall = Instance.new('Part'); wall.Name = 'WorldEdge'; wall.Anchored = true; wall.Transparency = 1
            wall.CanQuery = false; wall.CastShadow = false
            if axis == 'x' then
                wall.Size = Vector3.new(2, 200, 2 * B + 4); wall.CFrame = CFrame.new(side * (B + 1), 80, 0)
            else
                wall.Size = Vector3.new(2 * B + 4, 200, 2); wall.CFrame = CFrame.new(0, 80, side * (B + 1))
            end
            wall.Parent = root
        end
    end
    return {columns = columns, chunks = chunks, seconds = os.clock() - started}
end
return Landscape
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX1c66227eacb19e685bb43fe6217694f621c9dbe1">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local Shared=ReplicatedStorage:WaitForChild('Ghostlight')
local C=require(Shared.Config)
local Rules=require(Shared.Rules)
local V=require(Shared.Visuals)
local Profiles=require(script.Parent.Profiles)
local World=require(script.Parent.World)
local Hunt=require(script.Parent.Hunting)
local Chamber=require(script.Parent.Chamber)
local remote=Instance.new('RemoteEvent'); remote.Name='Action'; remote.Parent=Shared
local plots={}
local lastRequest={}
local closing=false
require(Shared.GhostModels).prepare()
World.build()
local function notice(player,text) remote:FireClient(player,'Notice',text) end
local function push(player)
    local p=Profiles.get(player)
    if not p then return end
    remote:FireClient(player,'State',{Profile=p,Income=Rules.income(p),Plot=plots[player],Practice=Profiles.Memory})
end
local function refreshPlot(player)
    local p=Profiles.get(player)
    local plot=plots[player] and World.Plots[plots[player]]
    if not p or not plot then return end
    for _,m in plot.Displays do m:Destroy() end
    table.clear(plot.Displays)
    plot.Label.Text=player.DisplayName.."'s Haunt\nLevel "..p.HauntLevel
    plot.IncomeLabel.Text='$'..Rules.income(p)..' / sec'
    for i,pad in plot.Slots do
        pad.Transparency=if i&lt;=C.Slots[p.HauntLevel] then 0 else 0.8
        pad.Color=if i&lt;=C.Slots[p.HauntLevel] then Color3.fromRGB(105,66,146) else Color3.fromRGB(35,30,46)
        if p.Placed[i] then
            local m=V.ghost(p.Placed[i],plot.Model,pad.CFrame*CFrame.new(0,2.3,0),0.65,true)
            table.insert(plot.Displays,m)
        end
    end
    local existing=plot.Model:FindFirstChild('UpgradeDecor')
    if existing then existing:Destroy() end
    local decor=Instance.new('Folder'); decor.Name='UpgradeDecor'; decor.Parent=plot.Model
    for i=2,p.HauntLevel do
        for _,s in {-1,1} do
            local offset=if plot.SpireOffset then plot.SpireOffset(s,i) else CFrame.new(s*(20+i),4+i,-10+i*5)
            local pillar=V.part(decor,'EstateSpire',Vector3.new(1.2,3+i,1.2),plot.CF*offset,V.color(i),Enum.Material.Neon)
            local l=Instance.new('PointLight'); l.Color=pillar.Color; l.Range=8; l.Brightness=0.3; l.Parent=pillar
        end
    end
end
local function stats(player)
    local p=Profiles.get(player)
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    if not p or not hum then return end
    hum.WalkSpeed=if player:GetAttribute('Chamber') then 0 else 22+(p.Upgrades.Movement-1)*2
    for _,container in {char,player:FindFirstChildOfClass('Backpack')} do
        if container then
            local tool=container:FindFirstChild('Spectral Vacuum')
            if tool then
                local light=tool:FindFirstChild('Lamp',true)
                if light then light.Range=35+p.Upgrades.Flashlight*10; light.Brightness=2+p.Upgrades.Flashlight*0.5 end
            end
        end
    end
end
local function rootOf(player)
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    return if hum and hum.Health&gt;0 then char:FindFirstChild('HumanoidRootPart') else nil
end
local function near(player,part)
    local root=rootOf(player)
    return root and (root.Position-part.Position).Magnitude&lt;=15
end
local function home(player)
    local plot=plots[player] and World.Plots[plots[player]]
    if not plot or not rootOf(player) then return end
    Hunt.cancel(player,'')
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',0)
    player.Character:PivotTo(plot.CF*CFrame.new(0,4,-22))
    stats(player); push(player)
end
local function atHome(player)
    local plot=plots[player] and World.Plots[plots[player]]
    local root=rootOf(player)
    return plot and root and not player:GetAttribute('Chamber') and (root.Position-plot.CF.Position).Magnitude&lt;45
end
local function deposit(player)
    local p=Profiles.get(player)
    if not p or not atHome(player) then return end
    local n=#p.Bag; Rules.deposit(p)
    -- Fill free slots for a smooth first loop; players can replace any slot in the Haunt panel.
    local ids={}
    for id in p.Owned do table.insert(ids,id) end
    table.sort(ids,function(a,b) return C.Ghosts[a].Income&gt;C.Ghosts[b].Income end)
    for _,id in ids do while Rules.place(p,id) do end end
    refreshPlot(player); push(player)
    notice(player,if n&gt;0 then n..' ghosts deposited! Free slots filled. Your Haunt is earning dollars.' else 'Inventory ready. Manage your ghost slots in HAUNT.')
end
local function enterFloor(player,floor)
    local p=Profiles.get(player)
    if not p or type(floor)~='number' or floor~=math.floor(floor) or not World.Areas[floor] or floor&gt;p.Floor or not rootOf(player) then return end
    Hunt.cancel(player,'')
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',floor)
    player.Character:PivotTo(CFrame.new(World.Areas[floor].Entry))
    stats(player); push(player)
    notice(player,'Aim at a ghost and click repeatedly. Chase it when it pulls away!')
end
Hunt.start(World,Profiles,remote,push)
Chamber.start(World,Profiles,remote,push)
Profiles.start()
for i,plot in World.Plots do
    World.prompt(plot.Deposit,'Deposit ghosts','Your Haunt',function(player)
        if plot.Owner==player and near(player,plot.Deposit) then deposit(player) end
    end)
end
World.ChamberPortalPrompt.Triggered:Connect(function(player)
    if near(player,World.ChamberPortal) and (player:GetAttribute('Floor') or 0)==0 and not player:GetAttribute('Chamber') then Hunt.cancel(player,''); Chamber.enter(player,plots[player]); push(player) end
end)
for _,area in World.Areas do World.prompt(area.Exit,'Return home','Deposit captured ghosts',function(player) if near(player,area.Exit) then home(player) end end) end
World.prompt(World.MansionDoor,'Choose mansion area','Haunted Mansion',function(player) if near(player,World.MansionDoor) then remote:FireClient(player,'Open','Mansion') end end)
World.prompt(World.Upgrades,'Browse upgrades','Workshop',function(player) if near(player,World.Upgrades) then remote:FireClient(player,'Open','Upgrades') end end)
World.RebirthAltarPrompt.Triggered:Connect(function(player) if near(player,World.RebirthAltar) then remote:FireClient(player,'Open','Rebirth') end end)
remote.OnServerEvent:Connect(function(player,action,arg)
    if type(action)~='string' or #action&gt;24 then return end
    if action=='Click' then Hunt.click(player,arg); return end
    local now=os.clock()
    if now-(lastRequest[player] or 0)&lt;0.15 then return end
    lastRequest[player]=now
    local p=Profiles.get(player)
    if not p then return end
    if action=='Sync' then push(player)
    elseif action=='Home' then home(player)
    elseif action=='EnterFloor' then enterFloor(player,arg)
    elseif action=='Deposit' then deposit(player)
    elseif action=='Place' then
        if type(arg)=='string' and #arg&lt;50 and atHome(player) and Rules.place(p,arg) then refreshPlot(player); push(player) else notice(player,'Return home, deposit your ghosts, and check for a free slot.') end
    elseif action=='Remove' then
        if atHome(player) and Rules.remove(p,arg) then refreshPlot(player); push(player) end
    elseif action=='Upgrade' then
        if type(arg)=='string' and #arg&lt;30 and Rules.upgrade(p,arg) then stats(player); refreshPlot(player); push(player); notice(player,arg..' upgraded!') else notice(player,'Upgrade unavailable or not enough dollars.') end
    elseif action=='Unlock' then
        if Rules.unlock(p,arg) then push(player); notice(player,'New mansion area unlocked!') else notice(player,'Unlock areas in order and earn enough dollars.') end
    elseif action=='Rebirth' then
        if Rules.rebirth(p) then home(player); refreshPlot(player); stats(player); push(player); notice(player,'REBORN! Permanent income multiplier: '..Rules.multiplier(p)..'x') else notice(player,'Unlock all six areas and meet the dollar requirement first.') end
    elseif action=='Chamber' then
        if atHome(player) then Hunt.cancel(player,''); Chamber.enter(player,plots[player]); push(player) else notice(player,'Return to your Haunt to enter the chamber.') end
    elseif action=='ExitChamber' then home(player)
    elseif action=='Cancel' then Hunt.cancel(player,'Capture released.')
    elseif action=='Flashlight' then
        local tool=player.Character and player.Character:FindFirstChild('Spectral Vacuum')
        local light=tool and tool:FindFirstChild('Lamp',true)
        if light then light.Enabled=not light.Enabled end
    end
end)
local function characterAdded(player,char)
    char:WaitForChild('HumanoidRootPart',10)
    local humanoid=char:WaitForChild('Humanoid',10)
    if not humanoid or not Profiles.get(player) then return end
    if player:GetAttribute('Chamber') then Chamber.leave(player) end
    player:SetAttribute('Floor',0)
    local backpack=player:WaitForChild('Backpack')
    if not backpack:FindFirstChild('Spectral Vacuum') and not char:FindFirstChild('Spectral Vacuum') then
        local tool=V.vacuum(); tool.Parent=backpack; humanoid:EquipTool(tool)
        tool.Unequipped:Connect(function()
            task.defer(function()
                if tool.Parent==backpack and humanoid.Health&gt;0 and player.Character==char then humanoid:EquipTool(tool) end
            end)
        end)
    end
    stats(player); push(player)
    humanoid.Died:Connect(function()
        Hunt.cancel(player,'')
        if player:GetAttribute('Chamber') then Chamber.leave(player) end
        player:SetAttribute('Floor',0)
    end)
end
local function joined(player)
    if closing then player:Kick('Server restarting. Please rejoin.'); return end
    local index
    for i,plot in World.Plots do if not plot.Owner then index=i; plot.Owner=player; plots[player]=i; break end end
    if not index then player:Kick('All seven Haunts are occupied. Please join another server.'); return end
    local data=Profiles.load(player)
    if not data or not player.Parent then
        if World.Plots[index].Owner==player then World.Plots[index].Owner=nil end
        local session=Profiles.Sessions[player]
        if session then session.Closing=true; Profiles.save(player,true); Profiles.Sessions[player]=nil end
        plots[player]=nil
        return
    end
    local leaderstats=Instance.new('Folder'); leaderstats.Name='leaderstats'; leaderstats.Parent=player
    for _,name in {'Dollars','Rebirths','Income'} do local v=Instance.new('NumberValue'); v.Name=name; v.Parent=leaderstats end
    refreshPlot(player)
    player.CharacterAdded:Connect(function(char) characterAdded(player,char) end)
    if player.Character then task.spawn(characterAdded,player,player.Character) end
    push(player)
end
Players.PlayerAdded:Connect(joined)
for _,player in Players:GetPlayers() do task.spawn(joined,player) end
Players.PlayerRemoving:Connect(function(player)
    Hunt.cancel(player,'')
    if Chamber.Sessions[player] then Chamber.leave(player) end
    local s=Profiles.Sessions[player]
    if s then s.Closing=true; Profiles.save(player,true); Profiles.Sessions[player]=nil end
    local plot=plots[player] and World.Plots[plots[player]]
    if plot then
        plot.Owner=nil; plot.Label.Text='UNCLAIMED HAUNT'
        for _,m in plot.Displays do m:Destroy() end
        table.clear(plot.Displays)
    end
    plots[player]=nil; lastRequest[player]=nil
end)
task.spawn(function()
    while task.wait(1) do
        local ranking={}
        for _,player in Players:GetPlayers() do
            local p=Profiles.get(player)
            if not p then continue end
            p.Money=math.min(1e15,p.Money+Rules.income(p))
            local ls=player:FindFirstChild('leaderstats')
            if ls then ls.Dollars.Value=math.floor(p.Money); ls.Income.Value=Rules.income(p); ls.Rebirths.Value=p.Rebirths end
            local ownedPlot=plots[player] and World.Plots[plots[player]]
            if ownedPlot then ownedPlot.IncomeLabel.Text='$'..Rules.income(p)..' / sec' end
            local root=rootOf(player)
            local floor=player:GetAttribute('Floor') or 0
            if root and not player:GetAttribute('Chamber') then
                if floor&gt;0 and World.Areas[floor] then
                    local rel=root.Position-World.Areas[floor].Center
                    if math.abs(rel.X)&gt;58 or math.abs(rel.Z)&gt;48 or rel.Y&lt; -10 then enterFloor(player,floor) end
                elseif root.Position.Y&lt; -15 or root.Position.Z&lt; -245 or math.abs(root.Position.X)&gt;215 then home(player) end
            end
            push(player)
            table.insert(ranking,{Name=player.DisplayName,Income=Rules.income(p)})
        end
        table.sort(ranking,function(a,b) return a.Income&gt;b.Income end)
        local lines={'HOLLOW HUNTERS • THIS SERVER'}
        for i=1,math.min(8,#ranking) do table.insert(lines,i..'. '..ranking[i].Name..' • $'..ranking[i].Income..'/sec') end
        World.Leaderboard.Label.TextLabel.Text=table.concat(lines,'\n')
    end
end)
game:BindToClose(function()
    closing=true
    local remaining=0
    for player,s in Profiles.Sessions do
        s.Closing=true; remaining+=1
        task.spawn(function() Profiles.save(player,true); remaining-=1 end)
    end
    local deadline=os.clock()+25
    while remaining&gt;0 and os.clock()&lt;deadline do task.wait(0.1) end
end)
print('Ghostlight Hollow server ready: seven Haunts, six mansion areas, fifteen ghosts.')
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX63b3ef7759c5edd40705b2636bc90fcceb021a7e">
        <Properties>
          <string name="Name">Profiles</string>
          <ProtectedString name="Source">local DataStoreService=game:GetService('DataStoreService')
local HttpService=game:GetService('HttpService')
local RunService=game:GetService('RunService')
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local Rules=require(Shared.Rules)
local Config=require(Shared.Config)
local P={Sessions={}}
local memory=RunService:IsStudio() and not Config.StudioPersistence
local store=if not memory then DataStoreService:GetDataStore(Config.SaveKey) else nil
local LEASE=180
local function copy(t)
    local out={}
    for k,v in t do out[k]=if type(v)=='table' then copy(v) else v end
    return out
end
function P.load(player)
    if memory then
        P.Sessions[player]={Data=Rules.newProfile(),Memory=true,LastSave=os.time()}
        return P.Sessions[player].Data
    end
    local token=game.JobId..':'..HttpService:GenerateGUID(false)
    for attempt=1,4 do
        local ok,result=pcall(function()
            return store:UpdateAsync('Player_'..player.UserId,function(old)
                if old~=nil and type(old)~='table' then error('Invalid profile envelope') end
                old=old or {Data=Rules.newProfile()}
                if old.Lock and old.Lock.Token~=token and (old.Lock.Expires or 0)&gt;os.time() then return nil end
                return {Data=Rules.reconcile(old.Data),Lock={Token=token,Expires=os.time()+LEASE}}
            end)
        end)
        if ok and result and result.Lock and result.Lock.Token==token then
            local data=Rules.reconcile(result.Data)
            P.Sessions[player]={Data=data,Token=token,LastSave=os.time()}
            if not player.Parent then P.save(player,true); P.Sessions[player]=nil; return nil end
            return data
        end
        if not ok then warn('Profile load failed',player.UserId,result) end
        if attempt&lt;4 then task.wait(attempt*2) end
    end
    if player.Parent then player:Kick('Your save is unavailable or still open on another server. Please rejoin shortly; no progress was overwritten.') end
    return nil
end
function P.save(player,release)
    local s=P.Sessions[player]
    if not s then return true end
    while s.Saving do task.wait(0.05) end
    if s.Released then return true end
    if s.Memory then if release then s.Released=true end; return true end
    if s.Lost then return false end
    s.Saving=true
    local snapshot=copy(s.Data)
    local saved=false
    for attempt=1,3 do
        local lost=false
        local ok,result=pcall(function()
            return store:UpdateAsync('Player_'..player.UserId,function(old)
                if not old or not old.Lock or old.Lock.Token~=s.Token then lost=true; return nil end
                return {Data=snapshot,Lock=if release then nil else {Token=s.Token,Expires=os.time()+LEASE}}
            end)
        end)
        if ok and result and not lost then saved=true; s.LastSave=os.time(); break end
        if lost then s.Lost=true; break end
        warn('Profile save retry',player.UserId,attempt,result)
        if attempt&lt;3 then task.wait(attempt) end
    end
    s.Saving=false
    if saved and release then s.Released=true end
    if s.Lost or (not saved and os.time()-s.LastSave&gt;LEASE-35) then
        s.Lost=true
        if player.Parent then player:Kick('Saving connection lost. Please rejoin to protect your saved progress.') end
    end
    return saved
end
function P.get(player)
    local s=P.Sessions[player]
    return if s and not s.Lost and not s.Released and not s.Closing then s.Data else nil
end
function P.start()
    if memory then warn('Ghostlight Hollow: Studio practice session. Persistence is intentionally OFF.') end
    task.spawn(function()
        while task.wait(45) do
            for player,s in P.Sessions do if not s.Closing then task.spawn(P.save,player,false) end end
        end
    end)
end
P.Memory=memory
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXe0988c1ed87f564bec7696a26104ad6e6f35d857">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Ghostlight')
local V=require(Shared.Visuals)
local C=require(Shared.Config)
local Assets=require(Shared.Assets.Loader)
local Landscape=require(script.Parent.Landscape)
local W={Plots={},Areas={},Switches={}}
local stone=Color3.fromRGB(51,49,65)
local wood=Color3.fromRGB(62,43,58)
local purple=Color3.fromRGB(166,103,246)
local warm=Color3.fromRGB(255,188,104)
local function part(parent,name,size,pos,color,mat)
    return V.part(parent,name,size,CFrame.new(pos),color or stone,mat or Enum.Material.Slate)
end
local function prompt(p,text,object,callback)
    local pr=Instance.new('ProximityPrompt'); pr.ActionText=text; pr.ObjectText=object or ''; pr.MaxActivationDistance=12; pr.RequiresLineOfSight=false; pr.Parent=p
    if callback then pr.Triggered:Connect(callback) end
    return pr
end
W.prompt=prompt
local function lamp(parent,pos)
    if Assets.configured('StreetLamp') then
        local model=Assets.place('StreetLamp',parent,CFrame.new(pos))
        local glow=model:FindFirstChild('StreetLamp_Glow',true)
        if glow then
            local light=Instance.new('PointLight'); light.Color=warm; light.Brightness=2.8; light.Range=30; light.Parent=glow
        end
        return
    end
    part(parent,'LampPost',Vector3.new(0.4,7,0.4),pos+Vector3.new(0,3.5,0))
    local glow=part(parent,'Lantern',Vector3.new(1,1.6,1),pos+Vector3.new(0,7.5,0),warm,Enum.Material.Neon)
    local light=Instance.new('PointLight'); light.Color=warm; light.Brightness=2.8; light.Range=30; light.Parent=glow
    part(parent,'LanternCap',Vector3.new(1.6,0.3,1.6),pos+Vector3.new(0,8.5,0))
end
local function sign(parent,pos,text,color)
    local p=part(parent,'Sign',Vector3.new(9,3,0.6),pos,Color3.fromRGB(27,22,43),Enum.Material.Wood)
    V.label(p,text,color or purple,240,65)
    return p
end
-- Raised cobblestone walkway. Its top sits at y 0.5, flush with the plaza disc and the Haunt plinths and a full stud
-- proud of the nominal ground, so it stays visible however smooth Terrain rounds the surface; the slab reaches down
-- to y -0.7 so no gap opens beneath it. A slate curb runs along each side.
local function path(parent,a,b,width)
    local w=width or 12
    a=Vector3.new(a.X,0,a.Z); b=Vector3.new(b.X,0,b.Z)
    local mid=(a+b)/2
    local length=(a-b).Magnitude
    local p=part(parent,'Path',Vector3.new(w,1.2,length),mid,Color3.fromRGB(86,76,94),Enum.Material.Cobblestone)
    p.CFrame=CFrame.lookAt(mid,b)*CFrame.new(0,-0.1,0)
    for _,side in {-1,1} do
        local edge=part(parent,'PathEdging',Vector3.new(.4,.35,length),mid,Color3.fromRGB(57,53,69),Enum.Material.Slate)
        edge.CFrame=p.CFrame*CFrame.new(side*(w/2+.2),.6,0)
        edge.CanCollide=false; edge.CanQuery=false
    end
end
function W.build()
    local loadNames={}
    for _,name in {'StreetLamp','Gravestone','PineTree','DeadTree','Pumpkin','GhostFountain','ChamberPortal','RebirthAltar','NoticeBoard','WelcomeSign','HauntShowcase','MansionHill','MansionFacade','Boulder',
        'ShopHouse','Caretaker','MarketStall','OakCask','Crate','GraveyardFence','Crypt','GravestoneCross','GravestoneObelisk'} do
        if Assets.configured(name) then table.insert(loadNames,name) end
    end
    Assets.preload(loadNames)
    local buildStarted=os.clock()
    local root=Instance.new('Folder'); root.Name='GhostlightWorld'; root.Parent=workspace; W.Root=root
    local lighting=game:GetService('Lighting')
    -- Future lighting is much darker than Voxel at the same numbers: moonlit ambient, exposure and environment lighting are raised.
    lighting.ClockTime=0.5; lighting.Brightness=2.8; lighting.Ambient=Color3.fromRGB(96,90,146); lighting.OutdoorAmbient=Color3.fromRGB(140,146,200)
    lighting.GlobalShadows=true; lighting.FogColor=Color3.fromRGB(52,50,90); lighting.FogStart=200; lighting.FogEnd=700
    lighting.EnvironmentDiffuseScale=0.9; lighting.EnvironmentSpecularScale=0.7; lighting.ShadowSoftness=0.25; lighting.ExposureCompensation=1.0
    local atm=Instance.new('Atmosphere'); atm.Density=0.2; atm.Offset=0.25; atm.Haze=1.0; atm.Glare=0.2
    atm.Color=Color3.fromRGB(112,116,165); atm.Decay=Color3.fromRGB(65,48,94); atm.Parent=lighting
    local bloom=Instance.new('BloomEffect'); bloom.Intensity=0.26; bloom.Size=26; bloom.Threshold=1.6; bloom.Parent=lighting
    local grade=Instance.new('ColorCorrectionEffect'); grade.Brightness=0.06; grade.Contrast=0.08; grade.Saturation=0.06; grade.TintColor=Color3.fromRGB(230,228,255); grade.Parent=lighting
    -- Smooth Terrain replaces the flat ground slab: level across everything built here, hills, ridge, rim and pond beyond.
    local landscape=Landscape.build(root)
    game:GetService('StarterPlayer').CharacterMaxSlopeAngle=60 -- near hills are walkable; the rim and ridge faces are steeper
    local plaza=part(root,'CircularPlaza',Vector3.new(1,66,66),Vector3.new(0,0,0),stone,Enum.Material.Cobblestone)
    plaza.Shape=Enum.PartType.Cylinder; plaza.CFrame=CFrame.new(0,0,0)*CFrame.Angles(0,0,math.pi/2)
    local spiritBlue=Color3.fromRGB(160,225,255)
    if Assets.configured('GhostFountain') then
        -- The plaza disc top is y 0.5; the fountain base sits on it. Its spirit is the Accent mesh, coloured blue-white.
        local fountain=Assets.place('GhostFountain',root,CFrame.new(0,0.5,0),{Accent=spiritBlue})
        local spirit=fountain:FindFirstChild('GhostFountain_Accent',true)
        if spirit then
            local l=Instance.new('PointLight'); l.Color=spiritBlue; l.Brightness=2.2; l.Range=28; l.Shadows=true; l.Parent=spirit
        end
    else
        local pedestal=part(root,'Fountain',Vector3.new(1.5,13,13),Vector3.new(0,1,0),stone)
        pedestal.Shape=Enum.PartType.Cylinder; pedestal.CFrame=CFrame.new(0,1,0)*CFrame.Angles(0,0,math.pi/2)
        V.ghost('mothlight',root,CFrame.new(0,7,0),2,false)
    end
    local spawn=Instance.new('SpawnLocation'); spawn.Name='TownSpawn'; spawn.Size=Vector3.new(8,1,8); spawn.Position=Vector3.new(0,0.6,21); spawn.Anchored=true; spawn.Neutral=true; spawn.Duration=0; spawn.Transparency=1; spawn.CanCollide=false; spawn.Parent=root
    -- Welcome signs flank the south path; nothing stands on the portal base any more.
    if Assets.configured('WelcomeSign') then
        for _,x in {-12,12} do
            local post=Assets.place('WelcomeSign',root,CFrame.new(x,-0.5,50))
            local board=post:FindFirstChild('WelcomeSign_Wood',true) or post:FindFirstChildWhichIsA('BasePart',true)
            V.label(board,'GHOSTLIGHT HOLLOW\nHunt • Haunt • Discover',purple,240,65).Parent.StudsOffset=Vector3.new(0,1.2,0)
        end
    else
        sign(root,Vector3.new(0,5,54),'GHOSTLIGHT HOLLOW\nHunt • Haunt • Discover')
    end
    local plotNumber=0
    local hauntHues={Color3.fromRGB(166,103,246),Color3.fromRGB(70,130,255),Color3.fromRGB(80,220,140),Color3.fromRGB(255,85,85),
        Color3.fromRGB(80,205,255),Color3.fromRGB(240,90,220),Color3.fromRGB(255,140,60)}
    local meshHaunts=Assets.configured('HauntShowcase')
    for i=1,8 do
        if i==5 then continue end
        plotNumber+=1
        local angle=math.rad(20+(i-1)*40)
        local center=Vector3.new(math.sin(angle)*116,0,math.cos(angle)*116)
        local model=Instance.new('Model'); model.Name='Haunt'..i; model.Parent=root
        local cf=CFrame.lookAt(center,Vector3.new(0,0,0))
        local function p(name,size,offset,color,mat) return V.part(model,name,size,cf*CFrame.new(offset),color or wood,mat) end
        local label,incomeLabel,deposit,chamber,spireOffset
        local slots={}
        if meshHaunts then
            -- Visuals come from the HauntShowcase mesh. Collision, slot pads and label anchors stay primitives so the
            -- gate opening, pedestal tops and the server's plot contract never depend on Roblox's collision approximation.
            -- The mesh base sits on the ground top (y -0.5); its yard plinth top is therefore y 0.5.
            Assets.place('HauntShowcase',model,cf*CFrame.new(0,-0.5,0),{Accent=hauntHues[plotNumber]})
            local function blocker(name,size,offset)
                local b=p(name,size,offset,stone); b.Transparency=1; b.CanQuery=false; return b
            end
            blocker('PlinthCollision',Vector3.new(46,1,40),Vector3.new(0,0,0))
            blocker('HouseCollision',Vector3.new(31.4,17.5,9.8),Vector3.new(0,9.25,15.6))
            for _,s in {-1,1} do
                blocker('SideFence',Vector3.new(0.6,3.4,40),Vector3.new(s*23,2.2,0))
                blocker('FrontFence',Vector3.new(18.6,3.4,0.6),Vector3.new(s*13.7,2.2,-20))
                blocker('GatePost',Vector3.new(1.4,4.2,1.4),Vector3.new(s*3.6,2.6,-20))
                blocker('SideHedge',Vector3.new(1.9,2.2,26),Vector3.new(s*21.5,1.6,-6))
                blocker('FrontHedge',Vector3.new(17.4,2.0,1.8),Vector3.new(s*13.2,1.5,-18.5))
            end
            local anchor=p('OwnerBoard',Vector3.new(0.5,0.5,0.5),Vector3.new(0,12.5,10.4))
            anchor.Transparency=1; anchor.CanCollide=false; anchor.CanQuery=false
            label=V.label(anchor,'UNCLAIMED HAUNT',purple,290,100)
            local hologram=p('IncomeHologram',Vector3.new(0.5,0.5,0.5),Vector3.new(0,9,2),Color3.fromRGB(131,255,225),Enum.Material.Neon)
            hologram.Transparency=1; hologram.CanCollide=false; hologram.CanQuery=false
            incomeLabel=V.label(hologram,'$/SEC • $0',Color3.fromRGB(131,255,225),210,48)
            deposit=p('Deposit',Vector3.new(5,0.4,5),Vector3.new(-11,0.7,-12),Color3.fromRGB(82,219,190),Enum.Material.Neon)
            V.label(deposit,'Deposit ghosts',Color3.fromRGB(153,255,223),140,45)
            chamber=p('ChamberDoor',Vector3.new(5,7,0.5),Vector3.new(11,4.5,14),purple,Enum.Material.Neon)
            chamber.Transparency=1; chamber.CanCollide=false; chamber.CanQuery=false
            for j=1,20 do
                local x=((j-1)%5-2)*6
                local z=math.floor((j-1)/5)*5-5
                blocker('Pedestal'..j,Vector3.new(3.2,1.2,3.2),Vector3.new(x,1.1,z))
                -- The pad is the server's slot part: it recolours and dims it, and hangs the display ghost 2.3 studs above it.
                local pad=p('Slot'..j,Vector3.new(3.6,0.3,3.6),Vector3.new(x,1.99,z),Color3.fromRGB(70,53,98))
                table.insert(slots,pad)
            end
            -- Estate spires stand on the roof ridge instead of the yard edge, which the fence now occupies.
            spireOffset=function(s,k) return CFrame.new(s*(5+2.2*k),19+0.5*k,15.5) end
        else
            p('Foundation',Vector3.new(46,1,40),Vector3.new(0,0.5,0),stone,Enum.Material.Cobblestone)
            p('BackWall',Vector3.new(46,13,1),Vector3.new(0,7,19))
            for _,s in {-1,1} do
                p('SideWall',Vector3.new(1,13,40),Vector3.new(s*23,7,0))
                p('FrontPillar',Vector3.new(2,13,2),Vector3.new(s*21,7,-19))
                p('Roof',Vector3.new(24,1.5,42),Vector3.new(s*10,15.2,0),Color3.fromRGB(39,30,57)).CFrame=cf*CFrame.new(s*10,15.2,0)*CFrame.Angles(0,0,s*math.rad(-18))
            end
            local board=p('OwnerBoard',Vector3.new(18,3,1),Vector3.new(0,12,-16),Color3.fromRGB(24,19,37))
            label=V.label(board,'UNCLAIMED HAUNT',purple,290,100)
            local hologram=p('IncomeHologram',Vector3.new(0.5,0.5,0.5),Vector3.new(0,10,2),Color3.fromRGB(131,255,225),Enum.Material.Neon)
            hologram.Transparency=1
            incomeLabel=V.label(hologram,'$/SEC • $0',Color3.fromRGB(131,255,225),210,48)
            deposit=p('Deposit',Vector3.new(5,0.4,5),Vector3.new(-11,1.2,-10),Color3.fromRGB(82,219,190),Enum.Material.Neon)
            V.label(deposit,'Deposit ghosts',Color3.fromRGB(153,255,223),140,45)
            chamber=p('ChamberDoor',Vector3.new(5,7,0.5),Vector3.new(11,4.5,14),purple,Enum.Material.Neon)
            V.label(chamber,'HAUNT CHAMBER',purple,170,45)
            chamber.Transparency=1; chamber.CanCollide=false
            local chamberGui=chamber:FindFirstChild('Label'); if chamberGui then chamberGui.Enabled=false end
            for j=1,20 do
                local x=((j-1)%5-2)*6
                local z=math.floor((j-1)/5)*5-5
                local pad=p('Slot'..j,Vector3.new(4,0.4,4),Vector3.new(x,1.2,z),Color3.fromRGB(70,53,98))
                table.insert(slots,pad)
            end
        end
        W.Plots[plotNumber]={Model=model,CF=cf,Slots=slots,Label=label,IncomeLabel=incomeLabel,Deposit=deposit,ChamberDoor=chamber,SpireOffset=spireOffset,Owner=nil,Displays={}}
        path(root,center*0.295,center,12)
        local plinthTop=if meshHaunts then 0.5 else 1
        lamp(root,(cf*CFrame.new(-19,plinthTop,-15)).Position)
        lamp(root,(cf*CFrame.new(19,plinthTop,-15)).Position)
    end
    -- Landmark exterior. Hunting wings are separated so access remains personal and server-validated.
    if Assets.configured('MansionHill') and Assets.configured('MansionFacade') then
        -- Hill mesh: front edge at z -130, lower terrace top y 1.4, stair and flank slopes from z -144 to -157, upper terrace
        -- top y 11.8 to z -200. Walkable collision is primitive so the climb never depends on mesh collision fidelity.
        path(root,Vector3.new(0,0,-34),Vector3.new(0,0,-129),18)
        for z=-45,-120,-25 do lamp(root,Vector3.new(-13,-0.5,z)); lamp(root,Vector3.new(13,-0.5,z)) end
        Assets.place('MansionHill',root,CFrame.new(0,-0.5,-165))
        local function blocker(name,size,cf)
            local b=V.part(root,name,size,cf,stone); b.Transparency=1; b.CanQuery=false; return b
        end
        local function slope(name,width,x)
            local wedge=Instance.new('WedgePart'); wedge.Name=name; wedge.Size=Vector3.new(width,10.4,13)
            -- A WedgePart is tall at its back (+Z); the hill rises toward -Z, so turn it around.
            wedge.CFrame=CFrame.new(x,6.6,-150.5)*CFrame.Angles(0,math.pi,0)
            wedge.Anchored=true; wedge.Transparency=1; wedge.CanQuery=false; wedge.Parent=root
        end
        blocker('LowerTerrace',Vector3.new(90,1.9,14),CFrame.new(0,0.45,-137))
        blocker('UpperTerrace',Vector3.new(90,12.3,43),CFrame.new(0,5.65,-178.5))
        slope('HillSlopeLeft',33,-28.5); slope('HillSlopeRight',33,28.5); slope('StairSlope',24,0)
        for _,x in {-16,16} do lamp(root,Vector3.new(x,1.4,-136)); lamp(root,Vector3.new(x,11.8,-160)) end
        -- Facade mesh: its bounding box (porch railing to tower cornice) is centred 2.8 studs in front of the block centre,
        -- so z -183 puts the block at -172.8..-198.8 on the terrace and the porch columns at -167.3.
        Assets.place('MansionFacade',root,CFrame.new(0,11.8,-183),{Accent=purple})
        blocker('FacadeCollision',Vector3.new(124,50,26),CFrame.new(0,36.8,-185.8))
        for _,x in {-11,-5,5,11} do blocker('PorchColumn',Vector3.new(2.2,12.6,2.2),CFrame.new(x,18.1,-167.3)) end
        W.MansionDoor=V.part(root,'MansionEntrance',Vector3.new(10,14,1),CFrame.new(0,18.8,-172.5),purple,Enum.Material.Neon)
        W.MansionDoor.Transparency=1; W.MansionDoor.CanQuery=false
        V.label(W.MansionDoor,'The Haunted Mansion',purple,240,65).Parent.StudsOffset=Vector3.new(0,10,0)
        if Assets.configured('Boulder') then
            for _,b in {{-50,-140},{52,-134},{-53,-176},{55,-192},{-60,-120}} do
                Assets.place('Boulder',root,CFrame.new(b[1],Landscape.height(b[1],b[2]),b[2]))
            end
        end
    else
        path(root,Vector3.new(0,0,-34),Vector3.new(0,0,-180),18)
        for z=-45,-170,-25 do lamp(root,Vector3.new(-13,-0.5,z)); lamp(root,Vector3.new(13,-0.5,z)) end
        local facade=Instance.new('Model'); facade.Name='MansionExterior'; facade.Parent=root
        part(facade,'EntranceSteps',Vector3.new(70,2,40),Vector3.new(0,0,-181))
        part(facade,'MansionFacade',Vector3.new(72,36,12),Vector3.new(0,18,-202),wood,Enum.Material.Brick)
        for _,x in {-31,31} do
            part(facade,'Tower',Vector3.new(15,52,19),Vector3.new(x,26,-204),stone,Enum.Material.Brick)
            local roof=part(facade,'TowerRoof',Vector3.new(20,12,23),Vector3.new(x,57,-204),Color3.fromRGB(37,27,53))
            roof.Shape=Enum.PartType.Ball
        end
        for x=-24,24,12 do for y=12,30,12 do part(facade,'GlowingWindow',Vector3.new(4,7,0.3),Vector3.new(x,y,-195.8),warm,Enum.Material.Neon) end end
        W.MansionDoor=part(facade,'MansionEntrance',Vector3.new(10,14,1),Vector3.new(0,8,-195),purple,Enum.Material.Neon)
        sign(root,Vector3.new(0,17,-179),'The Haunted Mansion')
    end
    -- Asset meshes face Roblox +Z (their Blender -Y front). Yaw +90 degrees turns that front toward +X.
    local faceEast=CFrame.Angles(0,math.pi/2,0)
    local faceWest=CFrame.Angles(0,-math.pi/2,0)
    local function anchor(name,cf)
        local a=V.part(root,name,Vector3.new(0.5,0.5,0.5),cf,stone); a.Transparency=1; a.CanCollide=false; a.CanQuery=false; return a
    end
    local function blocker(name,size,cf)
        local b=V.part(root,name,size,cf,stone); b.Transparency=1; b.CanQuery=false; return b
    end
    if Assets.configured('ShopHouse') then
        -- Shop row on the west side, fronts toward the plaza, north of the path to the eighth Haunt.
        -- The mesh bounding box is centred 1.1 studs in front of the building block (hanging sign and lantern).
        local shops={{z=48,name='The Workshop'},{z=71,name='The Hollow Inn'},{z=94,name='Curiosities'}}
        for k,shop in shops do
            Assets.place('ShopHouse',root,CFrame.new(-52,-0.5,shop.z)*faceEast,{Accent=warm})
            blocker('ShopCollision'..k,Vector3.new(17.6,19,22),CFrame.new(-52.7,9,shop.z))
            local board=anchor('ShopSign'..k,CFrame.new(-42.7,7.4,shop.z+4.2))
            V.label(board,shop.name,warm,220,60).Parent.StudsOffset=Vector3.new(0,1.6,0)
            if k==1 then
                W.Upgrades=V.part(root,'WorkshopDoor',Vector3.new(0.6,5,3.2),CFrame.new(-44.6,2.8,shop.z+4.2),warm,Enum.Material.Neon)
                W.Upgrades.Transparency=1; W.Upgrades.CanQuery=false
            end
        end
        for _,z in {62,84} do
            if Assets.configured('MarketStall') then Assets.place('MarketStall',root,CFrame.new(-38,-0.5,z)*faceEast,{Accent=Color3.fromRGB(255,140,60)}) end
            blocker('StallCollision',Vector3.new(4.4,2.6,8),CFrame.new(-38,0.8,z))
        end
        if Assets.configured('OakCask') then for _,z in {56,68.5,100} do Assets.place('OakCask',root,CFrame.new(-41.5,-0.5,z)) end end
        if Assets.configured('Crate') then for _,c in {{-41.5,-0.5,90},{-39.6,-0.5,91.9},{-41.5,1.3,90}} do Assets.place('Crate',root,CFrame.new(c[1],c[2],c[3])) end end
        if Assets.configured('Pumpkin') then for _,c in {{-35.5,-0.5,58},{-35.2,-0.5,66.5},{-35.6,-0.5,80}} do Assets.place('Pumpkin',root,CFrame.new(c[1],c[2],c[3])) end end
    else
        W.Upgrades=sign(root,Vector3.new(-42,4,30),'The Workshop',warm)
    end
    -- The legacy REBIRTH ALTAR sign is gone; it overlapped the altar built further down.
    if Assets.configured('NoticeBoard') then
        local board=Assets.place('NoticeBoard',root,CFrame.new(0,-0.5,62))
        W.Leaderboard=board:FindFirstChild('NoticeBoard_Collision',true) or board:FindFirstChildWhichIsA('BasePart',true)
        V.label(W.Leaderboard,'HOLLOW HUNTERS',warm,240,65).Parent.StudsOffset=Vector3.new(0,0.8,0)
    else
        W.Leaderboard=sign(root,Vector3.new(0,5,62),'HOLLOW HUNTERS',warm)
    end
    W.Leaderboard.Label.Size=UDim2.fromOffset(330,170)
    if Assets.configured('Caretaker') then
        for _,npc in {{x=-40,z=50,cf=faceEast,text='MIRA • EQUIPMENT'},{x=47,z=36,cf=faceWest,text='ORIN • REBIRTH'}} do
            Assets.place('Caretaker',root,CFrame.new(npc.x,-0.5,npc.z)*npc.cf,{Accent=warm})
            blocker('CaretakerCollision',Vector3.new(2.2,5,2.2),CFrame.new(npc.x,2,npc.z))
            V.label(anchor('CaretakerName',CFrame.new(npc.x,5.2,npc.z)),npc.text,warm,180,45)
        end
    else
        for _,x in {-47,47} do
            local npc=part(root,'Caretaker',Vector3.new(2,3,1),Vector3.new(x,2,36),Color3.fromRGB(63,45,84))
            local head=part(root,'CaretakerHead',Vector3.new(1.5,1.5,1.5),Vector3.new(x,4.3,36),warm); head.Shape=Enum.PartType.Ball
            V.label(npc,if x&lt;0 then 'MIRA • EQUIPMENT' else 'ORIN • REBIRTH',warm,180,45)
        end
    end
    local rng=Random.new(1047)
    for i=1,58 do
        local a=rng:NextNumber(0,math.pi*2); local r=rng:NextNumber(165,195)
        local pos=Vector3.new(math.cos(a)*r,0,math.sin(a)*r)
        local ground=Landscape.height(pos.X,pos.Z)
        if (math.abs(pos.X)&gt;24 or pos.Z&gt;0) and ground&gt;Landscape.WaterLevel+0.5 then
            -- Whole-town MeshPart cap is 500, so every ring tree is a mesh once uploaded: two pines per dead tree.
            local meshName=if i%3==0 then 'DeadTree' else 'PineTree'
            if Assets.configured(meshName) then
                Assets.place(meshName,root,CFrame.new(pos.X,ground,pos.Z))
                continue
            end
            pos=Vector3.new(pos.X,ground+0.5,pos.Z)
            part(root,'TreeTrunk',Vector3.new(2,11,2),pos+Vector3.new(0,5,0),wood,Enum.Material.Wood)
            for j=1,3 do local crown=part(root,'Pine',Vector3.new(14-j*2,8,14-j*2),pos+Vector3.new(0,8+j*4,0),Color3.fromRGB(25,43,43),Enum.Material.Grass); crown.Shape=Enum.PartType.Ball end
        end
    end
    -- Hillside woods. A dozen mesh pines stand on the near slopes inside the MeshPart budget; the far slopes and
    -- the rim carry cheap two-part silhouettes that fog and darkness flatten into a treeline.
    local function hillSpot(rMin,rMax)
        for _=1,20 do
            local a=rng:NextNumber(0,math.pi*2); local r=rng:NextNumber(rMin,rMax)
            local x,z=math.cos(a)*r,math.sin(a)*r
            local m=Landscape.material(x,z)
            if Landscape.outside(x,z)&gt;=30 and m~='Rock' and m~='Mud' and math.abs(x)&lt;Landscape.Bounds-12 and math.abs(z)&lt;Landscape.Bounds-12 then
                return Vector3.new(x,Landscape.height(x,z),z)
            end
        end
        return nil
    end
    local meshPines=0
    if Assets.configured('PineTree') then
        for _=1,12 do
            local spot=hillSpot(200,238)
            if spot then Assets.place('PineTree',root,CFrame.new(spot)*CFrame.Angles(0,rng:NextNumber(0,math.pi*2),0)); meshPines+=1 end
        end
    end
    local silhouettes=0
    for _=1,130 do
        local spot=hillSpot(212,326)
        if spot then
            local scale=rng:NextNumber(0.8,1.5)
            local trunk=part(root,'FarTrunk',Vector3.new(1.2,6,1.2)*scale,spot+Vector3.new(0,3*scale,0),Color3.fromRGB(28,22,34),Enum.Material.Wood)
            local crown=part(root,'FarPine',Vector3.new(7,15,7)*scale,spot+Vector3.new(0,11*scale,0),Color3.fromRGB(19,31,33),Enum.Material.Grass)
            crown.Shape=Enum.PartType.Ball
            for _,p in {trunk,crown} do p.CanCollide=false; p.CanQuery=false; p.CastShadow=false end
            silhouettes+=1
        end
    end
    if Assets.configured('GraveyardFence') then
        -- Fenced lot 50 (x) by 70 (z) centred at (150,105); the gate faces west toward the plaza.
        Assets.place('GraveyardFence',root,CFrame.new(150,-0.5,105)*faceWest,{Accent=Color3.fromRGB(80,220,140)})
        blocker('GraveFenceW1',Vector3.new(0.6,3.4,30.5),CFrame.new(125,1.2,85.25))
        blocker('GraveFenceW2',Vector3.new(0.6,3.4,30.5),CFrame.new(125,1.2,124.75))
        blocker('GraveFenceE',Vector3.new(0.6,3.4,70),CFrame.new(175,1.2,105))
        blocker('GraveFenceN',Vector3.new(50,3.4,0.6),CFrame.new(150,1.2,70))
        blocker('GraveFenceS',Vector3.new(50,3.4,0.6),CFrame.new(150,1.2,140))
        for _,z in {100.5,109.5} do blocker('GraveGatePost',Vector3.new(1.6,5.2,1.6),CFrame.new(125,2.1,z)) end
        local shapes={'Gravestone','GravestoneCross','GravestoneObelisk'}
        local k=0
        for _,z in {88,106,124} do
            for x=137,167,6 do
                k+=1
                local shape=shapes[(k%3)+1]
                if Assets.configured(shape) then Assets.place(shape,root,CFrame.new(x,-0.5,z)*faceWest) end
            end
        end
        if Assets.configured('Crypt') then
            for _,z in {80,130} do
                Assets.place('Crypt',root,CFrame.new(168,-0.5,z)*faceWest)
                blocker('CryptCollision',Vector3.new(10.5,6,8.5),CFrame.new(168,2.5,z))
            end
        end
        if Assets.configured('DeadTree') then
            for _,c in {{140,78},{161,76},{140,134},{158,136}} do Assets.place('DeadTree',root,CFrame.new(c[1],-0.5,c[2])) end
        end
        for _,m in {{146,0.2,90,44,26},{156,0.3,120,36,28},{136,0.25,108,20,18}} do
            local mist=part(root,'GraveMist',Vector3.new(m[4],0.25,m[5]),Vector3.new(m[1],m[2],m[3]),Color3.fromRGB(150,160,180),Enum.Material.SmoothPlastic)
            mist.Transparency=0.85; mist.CanCollide=false; mist.CanQuery=false; mist.CastShadow=false
        end
        for _,x in {128,133} do
            local l=Instance.new('PointLight'); l.Color=Color3.fromRGB(120,220,160); l.Range=14; l.Brightness=0.6
            l.Parent=anchor('GraveLight',CFrame.new(x,4,x==128 and 100 or 110))
        end
        sign(root,Vector3.new(122,4,113),'THE QUIET GARDEN',Color3.fromRGB(170,187,206))
    else
        for i=1,15 do
            local pos=Vector3.new(130+(i%5)*7,1.4,100+math.floor(i/5)*9)
            if Assets.configured('Gravestone') then
                Assets.place('Gravestone',root,CFrame.new(pos.X,-.5,pos.Z))
            else
                part(root,'Gravestone',Vector3.new(3,4,1),pos,Color3.fromRGB(86,86,102))
            end
        end
        sign(root,Vector3.new(146,3,93),'THE QUIET GARDEN',Color3.fromRGB(170,187,206))
    end
    if Assets.configured('Pumpkin') then Assets.place('Pumpkin',root,CFrame.new(47,-0.5,26)) end
    for floor,info in C.Floors do
        local center=Vector3.new((floor-1)*150,0,-450)
        local area=Instance.new('Model'); area.Name='Floor'..floor; area.Parent=root
        part(area,'Floor',Vector3.new(132,2,112),center-Vector3.new(0,1,0),wood,Enum.Material.WoodPlanks)
        part(area,'Ceiling',Vector3.new(134,1,114),center+Vector3.new(0,19,0),Color3.fromRGB(27,23,38))
        for _,s in {-1,1} do
            part(area,'Wall',Vector3.new(2,20,114),center+Vector3.new(s*66,9,0),stone,Enum.Material.Brick)
            part(area,'Wall',Vector3.new(132,20,2),center+Vector3.new(0,9,s*56),stone,Enum.Material.Brick)
            for _,z in {-36,36} do part(area,'RoomDivider',Vector3.new(2,17,34),center+Vector3.new(s*22,8,z),wood) end
        end
        local entry=center+Vector3.new(0,3,35)
        local exit=part(area,'ReturnDoor',Vector3.new(8,9,0.5),center+Vector3.new(0,4.5,44),purple,Enum.Material.Neon)
        V.label(exit,'RETURN TO HAUNT',purple)
        sign(area,center+Vector3.new(0,12,40),floor..' • '..info.Name)
        local roomNames={'Foyer','Bedrooms','Library','Basement Workshop','Crypt Chapel','Catacomb Reliquary'}
        for room=1,3 do
            local roomSign=part(area,'RoomSign',Vector3.new(7,2,0.4),center+Vector3.new((room-2)*38,8,-50),Color3.fromRGB(34,27,48),Enum.Material.Wood)
            V.label(roomSign,roomNames[math.min(#roomNames,room+(floor-1))],warm,150,35)
        end
        local lights={}
        for _,x in {-36,0,36} do
            for _,z in {-25,25} do
                local pos=center+Vector3.new(x,0,z)
                local tablePart=part(area,'OldTable',Vector3.new(8,0.8,4),pos+Vector3.new(0,3,0),wood,Enum.Material.Wood)
                for _,dx in {-3,3} do part(area,'TableLeg',Vector3.new(0.5,3,0.5),pos+Vector3.new(dx,1.5,0),wood) end
                local candle=part(area,'Candle',Vector3.new(0.3,1.4,0.3),pos+Vector3.new(0,4,0),warm,Enum.Material.Neon)
                local l=Instance.new('PointLight'); l.Color=warm; l.Range=if floor&gt;=4 then 12 else 22; l.Brightness=0.9; l.Parent=candle; table.insert(lights,l)
                if floor==3 then
                    for k=1,5 do part(area,'Book',Vector3.new(0.7,1.2,1),tablePart.Position+Vector3.new(k-3,1,0),Color3.fromRGB(60+k*20,40,76)) end
                elseif floor==2 then
                    part(area,'Bed',Vector3.new(6,2,10),pos+Vector3.new(4,1,-10),Color3.fromRGB(63,39,72))
                elseif floor&gt;=5 then
                    part(area,'Sarcophagus',Vector3.new(5,3,9),pos+Vector3.new(3,1.5,-10),stone)
                end
            end
        end
        -- Lights remain atmospheric and non-toggleable during exploration.
        W.Areas[floor]={Model=area,Center=center,Entry=entry,Exit=exit,Lights=lights}
    end
    local portalGlow,portalLight,portalHome
    local portalCyan=Color3.fromRGB(103,245,224)
    if Assets.configured('ChamberPortal') then
        -- Ground top is y -0.5 outside the plaza disc; the portal base is one stud tall so it meets the plaza top.
        local portalModel=Assets.place('ChamberPortal',root,CFrame.new(0,-0.5,40),{Accent=purple})
        W.ChamberPortal=portalModel:FindFirstChild('ChamberPortal_Collision',true) or portalModel:FindFirstChildWhichIsA('BasePart',true)
        portalGlow=portalModel:FindFirstChild('ChamberPortal_Glow',true)
        if portalGlow then
            portalGlow.Color=portalCyan; portalHome=portalGlow.CFrame
            portalLight=Instance.new('PointLight'); portalLight.Color=portalCyan; portalLight.Range=22; portalLight.Brightness=3; portalLight.Shadows=true; portalLight.Parent=portalGlow
        end
        V.label(W.ChamberPortal,'Haunt Chamber',Color3.fromRGB(131,255,225),210,60).Parent.StudsOffset=Vector3.new(0,9,0)
    else
        local portalBase=part(root,'ChamberPortalBase',Vector3.new(16,1,16),Vector3.new(0,0.7,40),Color3.fromRGB(54,38,83),Enum.Material.Cobblestone)
        portalBase.Shape=Enum.PartType.Cylinder; portalBase.CFrame=CFrame.new(0,0.7,40)*CFrame.Angles(0,0,math.pi/2)
        portalGlow=part(root,'ChamberPortal',Vector3.new(8,12,1),Vector3.new(0,7,40),portalCyan,Enum.Material.Neon)
        portalGlow.Transparency=0.25; portalHome=portalGlow.CFrame
        portalLight=Instance.new('PointLight'); portalLight.Color=portalCyan; portalLight.Range=22; portalLight.Brightness=3; portalLight.Parent=portalGlow
        V.label(portalGlow,'Haunt Chamber',Color3.fromRGB(131,255,225),210,60)
        W.ChamberPortal=portalGlow
    end
    local orbAmber=Color3.fromRGB(255,197,111)
    if Assets.configured('RebirthAltar') then
        local altar=Assets.place('RebirthAltar',root,CFrame.new(42,-0.5,30),{Accent=Color3.fromRGB(169,93,246)})
        W.RebirthAltar=altar:FindFirstChild('RebirthAltar_Collision',true) or altar:FindFirstChildWhichIsA('BasePart',true)
        local orb=altar:FindFirstChild('RebirthAltar_Glow',true)
        if orb then
            orb.Color=orbAmber
            local altarLight=Instance.new('PointLight'); altarLight.Color=orbAmber; altarLight.Range=18; altarLight.Brightness=2; altarLight.Parent=orb
        end
        V.label(W.RebirthAltar,'Rebirth Altar',orbAmber,190,55).Parent.StudsOffset=Vector3.new(0,6,0)
        W.RebirthAltarPrompt=prompt(W.RebirthAltar,'View rebirth','Altar')
    else
        local altarBase=part(root,'RebirthAltarBase',Vector3.new(12,2,12),Vector3.new(42,1,30),Color3.fromRGB(62,45,81),Enum.Material.Marble)
        altarBase.Shape=Enum.PartType.Cylinder; altarBase.CFrame=CFrame.new(42,1,30)*CFrame.Angles(0,0,math.pi/2)
        W.RebirthAltar=part(root,'RebirthAltar',Vector3.new(4,5,4),Vector3.new(42,4,30),Color3.fromRGB(169,93,246),Enum.Material.Neon)
        W.RebirthAltar.Shape=Enum.PartType.Cylinder; W.RebirthAltar.CFrame=CFrame.new(42,4,30)*CFrame.Angles(0,0,math.pi/2)
        local altarOrb=part(root,'RebirthOrb',Vector3.new(2.2,2.2,2.2),Vector3.new(42,8,30),orbAmber,Enum.Material.Neon); altarOrb.Shape=Enum.PartType.Ball
        local altarLight=Instance.new('PointLight'); altarLight.Color=orbAmber; altarLight.Range=18; altarLight.Brightness=2; altarLight.Parent=altarOrb
        V.label(W.RebirthAltar,'Rebirth Altar',orbAmber,190,55)
        W.RebirthAltarPrompt=prompt(altarOrb,'View rebirth','Altar')
    end
    W.ChamberPortalPrompt=prompt(W.ChamberPortal,'Enter chamber','AFK hunting')
    task.spawn(function()
        while root.Parent do
            local t=os.clock()
            if portalGlow and portalHome then
                portalGlow.CFrame=portalHome*CFrame.new(0,math.sin(t*2)*0.25,0)*CFrame.Angles(0,math.sin(t)*0.05,0)
            end
            if portalLight then portalLight.Brightness=2.4+math.sin(t*3)*0.6 end
            task.wait(0.05)
        end
    end)
    task.spawn(function()
        while root.Parent do
            task.wait(4)
            local area=W.Areas[rng:NextInteger(1,6)]
            local l=area.Lights[1]
            if l.Enabled then l.Brightness=0.15; task.wait(0.12); l.Brightness=0.9 end
        end
    end)
    local parts,meshes,lights=0,0,0
    for _,item in root:GetDescendants() do
        if item:IsA('MeshPart') then meshes+=1 elseif item:IsA('BasePart') then parts+=1 end
        if item:IsA('Light') then lights+=1 end
    end
    print(string.format('World.build %.3fs excluding preload: %d primitive parts, %d MeshParts, %d lights including interiors; landscape %d columns in %d chunks (%.2fs), %d hillside pines, %d silhouettes',
        os.clock()-buildStarted,parts,meshes,lights,landscape.columns,landscape.chunks,landscape.seconds,meshPines,silhouettes))
    -- Where smooth Terrain actually renders the nominal y -0.5 ground; read this from the Studio log after a Play.
    local probe=RaycastParams.new(); probe.FilterType=Enum.RaycastFilterType.Include; probe.FilterDescendantsInstances={workspace.Terrain}
    local function surface(x,z)
        local hit=workspace:Raycast(Vector3.new(x,30,z),Vector3.new(0,-60,0),probe)
        return if hit then hit.Position.Y else -99
    end
    print(string.format('Landscape surface probe (nominal -0.50): plaza edge %.2f, Haunt approach %.2f, mansion avenue %.2f, graveyard %.2f, hill %.2f',
        surface(0,60),surface(20,54),surface(0,-100),surface(150,105),surface(0,-232)))
    return W
end
return W
