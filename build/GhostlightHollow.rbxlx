      <Item class="ModuleScript" referent="RBXad071524208599b2c4d83803d8a3c0e9cb1a6303">
        <Properties>
          <string name="Name">GhostModels</string>
          <ProtectedString name="Source">-- Imported ghost templates are loaded once by the server and shared with inventory previews.
local Models={}
local RunService=game:GetService('RunService')
local TEMPLATE_FOLDER='GhostModelTemplates'
local ASSET_ID=130914286159636
local colors={
    Pearlescentperiwinkle=Color3.fromRGB(199,212,248),
    Glossymidnighteyes=Color3.fromRGB(15,20,35),
    Eyeglints=Color3.fromRGB(248,251,255),
    Roseblush=Color3.fromRGB(235,158,207),
    Smilevelvet=Color3.fromRGB(53,24,69),
    Berrytongue=Color3.fromRGB(193,110,180),
}
local function prepareAsset()
    assert(RunService:IsServer(),'Ghost templates must be prepared by the server')
    if script.Parent:FindFirstChild(TEMPLATE_FOLDER) then return end
    assert(ASSET_ID&gt;0,'Little Boo asset has not been configured')
    local imported=game:GetService('InsertService'):LoadAsset(ASSET_ID)
    local template=Instance.new('Model'); template.Name='ReferenceGhost'
    local meshes={}
    for _,item in imported:GetDescendants() do
        if item:IsA('MeshPart') then table.insert(meshes,item) end
    end
    assert(#meshes==6,'Little Boo must contain its six material meshes')
    for _,p in meshes do
        local role=p.Name:match('ReferenceGhost_(.+)')
        assert(colors[role],'Unknown Little Boo material: '..p.Name)
        p.Color=colors[role]; p.Material=Enum.Material.SmoothPlastic
        p.Reflectance=if role=='Glossymidnighteyes' then .16 else 0
        p.Transparency=0; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=true
        p.Parent=template
    end
    imported:Destroy()
    local extent=template:GetExtentsSize()
    template:ScaleTo(template:GetScale()*4.05/extent.Y)
    local bounds=template:GetBoundingBox()
    -- The imported Blender -Y face points toward Roblox -Z, matching the other pets.
    template:PivotTo(bounds:Inverse()*template:GetPivot())
    local core=Instance.new('Part'); core.Name='Core'; core.Size=Vector3.new(2.6,3.6,1.8)
    core.Transparency=1; core.Anchored=true; core.CanCollide=false; core.CanTouch=false
    core.CFrame=CFrame.new(); core.Parent=template; template.PrimaryPart=core
    local folder=Instance.new('Folder'); folder.Name=TEMPLATE_FOLDER
    template.Parent=folder; folder.Parent=script.Parent
end
function Models.prepare()
    local ok,reason=pcall(prepareAsset)
    if not ok then
        warn('Little Boo model unavailable: '..tostring(reason))
        -- Keep the existing roster playable if Roblox cannot deliver the new asset.
        local config=require(script.Parent.Config)
        config.Ghosts.little_boo.Weight=0
        config.Ghosts.little_boo.Areas={}
        local folder=Instance.new('Folder'); folder.Name=TEMPLATE_FOLDER
        folder:SetAttribute('LoadFailed',true); folder.Parent=script.Parent
    end
end
function Models.build(model)
    local folder=script.Parent:WaitForChild(TEMPLATE_FOLDER,20)
    local template=folder and folder:FindFirstChild('ReferenceGhost')
    if not template then
        local core=Instance.new('Part'); core.Name='Core'; core.Size=Vector3.new(2.6,3.6,1.8)
        core.Anchored=true; core.CanCollide=false; core.CanTouch=false; core.Transparency=1
        core.Parent=model; model.PrimaryPart=core
        local gui=Instance.new('BillboardGui'); gui.Name='Label'; gui.Size=UDim2.fromOffset(140,40); gui.MaxDistance=24; gui.Parent=core
        local text=Instance.new('TextLabel'); text.Size=UDim2.fromScale(1,1); text.BackgroundTransparency=1
        text.Text='Little Boo\nModel unavailable'; text.TextColor3=Color3.fromRGB(199,212,248); text.Parent=gui
        model:SetAttribute('VisualStyle','Unavailable')
        return core
    end
    for _,part in template:GetChildren() do part:Clone().Parent=model end
    local core=model:FindFirstChild('Core'); model.PrimaryPart=core
    local light=Instance.new('PointLight'); light.Color=colors.Pearlescentperiwinkle
    light.Range=7; light.Brightness=.18; light.Parent=core
    model:SetAttribute('VisualStyle','ReferenceMeshV1')
    return core
end
return Models
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX1160e63d28bb6095a922c77bd410eeccfc5daa85">
        <Properties>
          <string name="Name">GhostStyle</string>
          <ProtectedString name="Source">-- Reference direction: HalloweenSprites1/2/3. Local front is -Z.
-- Shared procedural models render in both Workspace and inventory WorldModels.
local Style={}
local cream=Color3.fromRGB(238,231,255)
local ink=Color3.fromRGB(22,16,43)
local gold=Color3.fromRGB(224,174,78)
local pink=Color3.fromRGB(245,148,192)
local white=Color3.fromRGB(255,252,255)
local dark=Color3.fromRGB(55,38,82)
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end

function Style.build(m,g,accent)
    local shape=g.Shape
    local bodyColor=cream:Lerp(accent,0.16)
    if shape=='Eclipse' or shape=='Door' then bodyColor=rgb(48,31,76)
    elseif shape=='Stag' then bodyColor=rgb(82,63,112)
    elseif shape=='Candle' then bodyColor=rgb(255,231,187) end
    local function part(name,size,pos,color,form,rotation,glow)
        local p=Instance.new('Part')
        p.Name=name; p.Size=size; p.CFrame=CFrame.new(pos)*(rotation or CFrame.new())
        p.Color=color or bodyColor; p.Material=if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
        p.Shape=form or Enum.PartType.Ball
        p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CastShadow=false
        p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
        p.Parent=m
        return p
    end
    local function ball(name,x,y,z,sx,sy,sz,color,glow)
        return part(name,Vector3.new(sx,sy,sz),Vector3.new(x,y,z),color,nil,nil,glow)
    end
    local function block(name,x,y,z,sx,sy,sz,color,rotation)
        return part(name,Vector3.new(sx,sy,sz),Vector3.new(x,y,z),color,Enum.PartType.Block,rotation)
    end
    -- Thin accessory segments have rounded tips and stay aligned between their endpoints.
    local function line(name,a,b,width,color,glow)
        local p=part(name,Vector3.new(width,width,(b-a).Magnitude),(a+b)/2,color,Enum.PartType.Block,CFrame.lookAt(a,b).Rotation,glow)
        ball(name..'Tip',b.X,b.Y,b.Z,width,width,width,color,glow)
        return p
    end
    local function ring(name,center,rx,ry,width,color,segments)
        local count=segments or 16
        for i=1,count do
            local a=(i-1)*2*math.pi/count; local b=i*2*math.pi/count
            line(name,center+Vector3.new(math.cos(a)*rx,math.sin(a)*ry,0),center+Vector3.new(math.cos(b)*rx,math.sin(b)*ry,0),width,color)
        end
    end
    local function bow(x,y,z,color)
        for _,s in {-1,1} do
            part('BowLoop',Vector3.new(.65,.43,.25),Vector3.new(x+s*.32,y,z),color,nil,CFrame.Angles(0,0,s*.3))
        end
        ball('BowKnot',x,y,z,.28,.3,.3,color)
    end
    local function flame(x,y,z,size,color)
        part('SpiritFlame',Vector3.new(.45,1,.4)*size,Vector3.new(x,y,z),color,nil,CFrame.Angles(0,0,-.22),true)
        ball('FlameHeart',x,y-.17*size,z-.08*size,.23*size,.45*size,.24*size,white,true)
    end
    local function book(x,y,z,angle)
        local turn=CFrame.Angles(0,angle or 0,-.15)
        block('BookCover',x,y,z,.85,1.05,.25,dark,turn)
        block('BookPages',x,y,z-.15,.69,.86,.12,rgb(240,215,176),turn)
        block('BookSpine',x-.36,y,z-.02,.12,1.08,.3,gold,turn)
        ball('CoverGem',x,y,z-.24,.16,.25,.08,accent,true)
    end
    local function lantern(x,y,z)
        ball('LanternLight',x,y,z,.4,.7,.4,rgb(255,192,94),true)
        for _,s in {-1,1} do for _,t in {-1,1} do
